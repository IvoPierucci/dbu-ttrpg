<div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
  {{#if racial.options}}
  {{! A Racial Trait's Option effect: which printed effect asks for it, and the one chosen - changeable, its script and
      what it gives changing with it. }}
  <section class="panel racial-options">
    <h3 class="panel-title">Options</h3>
    <label class="racial-option-row">
      <span>{{racial.optionLabel}}</span>
      <select data-racial-option>
        {{#each racial.options as |option|}}
        <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
        {{/each}}
      </select>
    </label>
  </section>
  {{/if}}
  {{! A rich-text field, so it is edited through Foundry's own editor rather than a
      plain input - the book's wording carries emphasis and line breaks. }}
  {{formInput fields.description value=system.description enriched=enrichedDescription
              toggled=false editable=editable}}
</div>

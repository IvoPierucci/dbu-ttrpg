<div class="gear-sheet">
  <header class="talent-header">
    <img class="profile-img" src="{{item.img}}" data-action="editImage" data-edit="img" height="48" width="48"/>
    <div class="talent-identity">
      <input type="text" name="name" value="{{item.name}}" placeholder="Item Name"/>
      <div class="gear-facts">
        <span>{{typeLabel}}</span>
        {{#if sizeLabel}}<span>{{sizeLabel}}</span>{{/if}}
        {{#each tagLabels as |tag|}}<span class="gear-tag">[{{tag}}]</span>{{/each}}
        {{#if craftDCNow}}<span>Craft DC: {{craftDCNow}}</span>{{/if}}
      </div>
    </div>
  </header>

  {{#if crafted}}
  <section class="panel">
    <h3 class="panel-title">{{crafted.label}}</h3>
    <div class="stat-grid">
      <div class="stat">
        <em>Category</em>
        <select name="system.crafted.category">
          {{#each crafted.categoryChoices as |choice|}}
          <option value="{{choice.value}}" {{#if choice.chosen}}selected{{/if}}>{{choice.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="stat">
        <em>Craftsmanship Grade</em>
        <select name="system.crafted.grade" data-dtype="Number">
          {{#each crafted.gradeChoices as |choice|}}
          <option value="{{choice.value}}" {{#if choice.chosen}}selected{{/if}}>{{choice.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="stat">
        <em>Size</em>
        <select name="system.crafted.size">
          {{#each crafted.sizeChoices as |choice|}}
          <option value="{{choice.value}}" {{#if choice.chosen}}selected{{/if}}>{{choice.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    <div class="gear-facts">
      <span>Apparel Grade: {{crafted.reading.gradeLabel}}</span>
      <span>Apparel Bonus: {{crafted.bonusLabel}}</span>
      <span>Quality Slots: {{crafted.reading.slots}}</span>
    </div>
  </section>

  <section class="panel">
    <h3 class="panel-title">Qualities</h3>
    {{#each crafted.qualities as |quality|}}
    <div class="gear-row">
      <span class="gear-name" data-tooltip="{{quality.tip}}">{{quality.name}}</span>
      {{#if quality.choiceLabel}}<span class="gear-type">{{quality.choiceLabel}}</span>{{/if}}
      <span class="gear-type">{{quality.slotsLabel}}</span>
      {{#if quality.misfit}}<span class="gear-warning">{{quality.misfit}}</span>{{/if}}
      <button type="button" class="gear-remove" data-action="removeQuality"
              data-index="{{quality.index}}" data-tooltip="Remove">&times;</button>
    </div>
    {{else}}
    <p class="tab-placeholder">None.</p>
    {{/each}}
    {{#if crafted.overNote}}<p class="gear-warning">{{crafted.overNote}}</p>{{/if}}
    <div class="gear-add-quality">
      {{#if crafted.qualityChoices.length}}
      <select data-quality-pick>
        {{#each crafted.qualityChoices as |choice|}}
        <option value="{{choice.value}}">{{choice.label}}</option>
        {{/each}}
      </select>
      <button type="button" class="dbu-clash-button" data-action="addQuality">Add Quality</button>
      {{else}}
      <p class="tab-placeholder">No Qualities to add for this Category yet.</p>
      {{/if}}
    </div>
  </section>
  {{/if}}

  {{#if hasControls}}
  <section class="panel">
    <div class="stat-grid">
      {{#if recordsLabel}}
      <div class="stat">
        <em>{{recordsLabel}}</em>
        <input type="number" name="system.recorded" value="{{system.recorded}}" data-dtype="Number"/>
      </div>
      {{/if}}
      {{#if upgrade}}
      <div class="stat">
        <em>{{upgrade.label}}</em>
        <input type="checkbox" name="system.upgrade.chosen" {{#if system.upgrade.chosen}}checked{{/if}}/>
      </div>
      {{/if}}
      {{#if declaresIntended}}
      <div class="stat">
        <em>Intended Character</em>
        <select name="system.intended.uuid">
          <option value="" {{#unless system.intended.uuid}}selected{{/unless}}>Nobody</option>
          {{#each intendedChoices as |choice|}}
          <option value="{{choice.value}}" {{#if choice.chosen}}selected{{/if}}>{{choice.label}}</option>
          {{/each}}
        </select>
      </div>
      {{/if}}
      {{#if assigns}}
      <div class="stat">
        <em>Assigned to</em>
        <select name="system.assigned.uuid">
          <option value="" {{#unless system.assigned.uuid}}selected{{/unless}}>Nobody</option>
          {{#each assignChoices as |choice|}}
          <option value="{{choice.value}}" {{#if choice.chosen}}selected{{/if}}>{{choice.label}}</option>
          {{/each}}
        </select>
      </div>
      {{/if}}
      {{#if connects}}
      <div class="stat">
        <em>Connected to</em>
        <select name="system.connectedTo">
          <option value="" {{#unless system.connectedTo}}selected{{/unless}}>Nothing</option>
          {{#each connectChoices as |choice|}}
          <option value="{{choice.value}}" {{#if choice.chosen}}selected{{/if}}>{{choice.label}}</option>
          {{/each}}
        </select>
      </div>
      {{/if}}
      {{#if chargesLabel}}
      <div class="stat">
        <em>{{chargesLabel}}</em>
        <input type="number" name="system.charges" value="{{system.charges}}" min="0" data-dtype="Number"/>
      </div>
      {{/if}}
      {{#if triggerChoices.length}}
      <div class="stat">
        <em>Trigger</em>
        <select name="system.trigger">
          {{#each triggerChoices as |choice|}}
          <option value="{{choice.value}}" {{#if choice.chosen}}selected{{/if}}>{{choice.label}}</option>
          {{/each}}
        </select>
      </div>
      {{/if}}
    </div>
  </section>
  {{/if}}

  {{! The rulebook's entry, as printed. Read, not edited: the name and the description
      below are the player's, and this is what the Item does whatever it is called. }}
  {{#if entry.length}}
  <section class="panel gear-entry">
    {{#each entry as |line|}}
    {{#if line.gap}}<br/>{{else}}<p>{{line.text}}</p>{{/if}}
    {{/each}}
  </section>
  {{/if}}

  <section class="panel">
    <h3 class="panel-title">Description</h3>
    {{formInput fields.description value=system.description enriched=enrichedDescription
                toggled=false editable=editable}}
  </section>
</div>

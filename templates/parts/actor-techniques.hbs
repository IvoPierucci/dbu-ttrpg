<div class="tab {{tabs.techniques.cssClass}}" data-group="primary" data-tab="techniques">
  <section class="panel">
    <h3 class="panel-title">
      Signature Techniques
      <button type="button" class="edit-toggle" data-action="newTechnique"
              data-tooltip="A blank Super Technique, opened on its Sig Creation tab">New Signature Technique</button>
    </h3>

    <div class="technique-summary">
      <span data-tooltip="What the Techniques cost in TP, against the TP Progression has given - the Unique Abilities' are on their own tab">
        TP <b>{{techniques.spent}}</b> / {{techniques.available}}</span>
      <span data-tooltip="Ultimates possessed, against one plus one per Super beyond the first (Transformation Techniques not counted)">
        Ultimates <b>{{techniques.ultimates}}</b> / {{techniques.ultimateCap}}</span>
      <span data-tooltip="Ultimates used this Combat Encounter">
        Used this Encounter <b>{{techniques.usedThisEncounter}}</b> / {{techniques.encounterCap}}</span>
    </div>
    {{#each techniques.warnings as |warning|}}<p class="gear-warning">{{warning}}</p>{{/each}}

    <ul class="maneuver-list technique-list">
      {{#each techniques.rows as |row|}}
      <li class="maneuver technique-row{{#if row.refused}} maneuver-exhausted{{/if}}{{#if row.open}} maneuver-open{{/if}}"
          data-item-id="{{row.itemId}}" draggable="true">
        <div class="maneuver-head" data-action="toggleManeuver">
          <span class="maneuver-mark" aria-hidden="true"></span>
          {{#if row.buddyOnly}}
          <span class="maneuver-name maneuver-triggered" data-tooltip="Used only through its Warrior Buddy">{{row.name}}</span>
          {{else}}
          <button type="button" class="maneuver-name rollable" data-action="useManeuver" data-item-id="{{row.itemId}}"
                  {{#if row.refused}}data-tooltip="{{row.refused}}"{{/if}}>{{row.name}}</button>
          {{/if}}
          <span class="maneuver-uses">{{row.level}}{{#if row.fromTransformation}} &middot; Transformation{{/if}}</span>
          <span class="maneuver-source">{{row.profile}}</span>
          <span class="maneuver-cost" {{#if row.freeTip}}data-tooltip="{{row.freeTip}}"{{/if}}>{{row.tp}} TP</span>
          <span class="maneuver-cost" {{#if row.kpTip}}data-tooltip="{{row.kpTip}}"{{/if}}>{{row.kp}} KP</span>
          <button type="button" class="maneuver-control" data-action="editItem" data-item-id="{{row.itemId}}"
                  data-tooltip="Build or change this Technique">&#9998;</button>
          <button type="button" class="maneuver-control" data-action="deleteTechnique" data-item-id="{{row.itemId}}"
                  data-tooltip="Delete this Technique">&#10005;</button>
        </div>
        <div class="maneuver-body">
          {{! Green for an Advantage, red for a Disadvantage: the colour says which, no heading. }}
          {{#each row.advantages as |feature|}}
          <div class="dbu-profile-line technique-advantage" {{#if feature.summary}}data-tooltip="{{feature.summary}}"{{/if}}>{{feature.label}}</div>
          {{/each}}
          {{#each row.disadvantages as |feature|}}
          <div class="dbu-profile-line technique-disadvantage" {{#if feature.summary}}data-tooltip="{{feature.summary}}"{{/if}}>{{feature.label}}</div>
          {{/each}}
          {{#unless row.advantages.length}}{{#unless row.disadvantages.length}}
          <p class="maneuver-nothing">No Advantages or Disadvantages yet. The pencil opens it.</p>
          {{/unless}}{{/unless}}
        </div>
        {{#if row.charged}}<div class="dbu-profile-note">{{row.charged}}</div>{{/if}}
        {{#if row.delayed}}
        <div class="dbu-profile-note">
          Imminent is waiting.
          <button type="button" class="dbu-clash-button" data-action="detonateTechnique" data-item-id="{{row.itemId}}"
                  data-tooltip="An Instant Maneuver: every Imminent from it goes off">Detonate</button>
        </div>
        {{/if}}
      </li>
      {{else}}
      <li class="tab-placeholder">None yet.</li>
      {{/each}}
    </ul>
  </section>
</div>

<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage"
       height="48" width="48" data-tooltip="Change the icon"/>
  <div class="header-fields">
    <input class="charname" type="text" name="name" value="{{item.name}}" placeholder="Maneuver name"/>
    <input class="header-sub" type="text" name="system.source" value="{{system.source}}"
           placeholder="Where this comes from, e.g. Core Rule"/>
  </div>
</header>

<div class="tab {{tabs.passives.cssClass}}" data-group="primary" data-tab="passives">
  <section class="panel">
    <h3 class="panel-title">
      Effect
      <span class="panel-hint">See WRITING-EFFECTS.txt</span>
    </h3>

    <textarea class="effect-script" name="system.script" rows="14" spellcheck="false"
              placeholder="[passive]&#10;soakValue += 1(bT);">{{system.script}}</textarea>

    {{! What is wrong, by line, so the mistake is pointed at rather than described. }}
    {{#if errors.length}}
    <ul class="effect-errors">
      {{#each errors as |problem|}}
      <li>{{#if problem.line}}<b>Line {{problem.line}}</b> — {{/if}}{{problem.message}}</li>
      {{/each}}
    </ul>
    {{else if system.script}}
    <p class="effect-ok">Compiles.</p>
    {{/if}}

    {{! What it comes to for the character holding it, which is the question an author
        actually has. Only shown when this Talent belongs to someone. }}
    {{#if resolved.length}}
    <details class="effect-resolved" open>
      <summary>On {{actorName}}</summary>
      <ul>
        {{#each resolved as |line|}}<li>{{line}}</li>{{/each}}
      </ul>
    </details>
    {{/if}}
  </section>

  <section class="panel">
    <h3 class="panel-title">Wording</h3>
    <textarea class="effect-text" name="system.text" rows="4"
              placeholder="The rulebook's own wording, shown to players.">{{system.text}}</textarea>
  </section>

  {{#if system.effects.length}}
  <section class="panel">
    <h3 class="panel-title">Old data rows</h3>
    <p class="tab-placeholder">
      This Talent still carries the typed rows Talents used before the script existed.
      They are read once to build the script above and are otherwise ignored.
    </p>
  </section>
  {{/if}}
</div>

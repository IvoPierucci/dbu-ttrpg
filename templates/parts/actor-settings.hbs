<div class="tab {{tabs.settings.cssClass}}" data-group="primary" data-tab="settings">

  {{! Allies and Minions (a Minion's: its Master) side by side, as the Combat tab's lists are (the user's): who they are, shown;
      adding, taking off and hiding a name in each one's Manage window. Allies: those on this list, and those whose own list names
      them - both ways; nobody else, whatever their token's disposition. A Character's Minions, or a Minion's one Master - either
      side is enough, and the two are Allies. A Minion has no Minions. }}
  <div class="dbu-combat-lists dbu-settings-lists">
    <section class="dbu-clist">
      <header class="dbu-clist-head">
        <h3>Allies</h3>
        <button type="button" class="dbu-manage" data-action="openCombatWindow" data-window="allies"
                data-tooltip="Add Allies, take them off, and hide their names">Manage</button>
      </header>
      <div class="dbu-clist-rows">
        {{#each allies as |ally|}}
          <div class="dbu-crow dbu-person{{#if ally.missing}} missing{{/if}}">
            {{#if ally.unknown}}<span class="ally-img ally-unknown" aria-hidden="true">?</span>{{else}}{{#if ally.img}}<img class="ally-img" src="{{ally.img}}" alt=""/>{{/if}}{{/if}}
            <span class="dbu-person-name">{{ally.name}}</span>
            {{#if ally.inherited}}<span class="dbu-temp" data-tooltip="{{ally.why}}">{{ally.note}}</span>
            {{else if ally.theirs}}<span class="dbu-temp" data-tooltip="Their Allies list names this character - taken off from their sheet">from their list</span>{{/if}}
          </div>
        {{else}}
        <p class="dbu-clist-empty">No Allies yet. Every other Character counts as an Opponent.</p>
        {{/each}}
      </div>
    </section>
    {{#if isMinion}}
    <section class="dbu-clist">
      <header class="dbu-clist-head">
        <h3>Master</h3>
        <button type="button" class="dbu-manage" data-action="openCombatWindow" data-window="master"
                data-tooltip="Set this Minion's Master, or take them off">Manage</button>
      </header>
      <div class="dbu-clist-rows">
        {{#if masterEntry}}
          <div class="dbu-crow dbu-person{{#if masterEntry.missing}} missing{{/if}}">
            {{#if masterEntry.unknown}}<span class="ally-img ally-unknown" aria-hidden="true">?</span>{{else}}{{#if masterEntry.img}}<img class="ally-img" src="{{masterEntry.img}}" alt=""/>{{/if}}{{/if}}
            <span class="dbu-person-name">{{masterEntry.name}}</span>
            {{#if masterEntry.theirs}}<span class="dbu-temp" data-tooltip="Their Minions list names this Minion - taken off from their sheet">from their list</span>{{/if}}
          </div>
        {{else}}
        <p class="dbu-clist-empty">No Master yet.</p>
        {{/if}}
      </div>
    </section>
    {{else}}
    <section class="dbu-clist">
      <header class="dbu-clist-head">
        <h3>Minions</h3>
        {{#if minionCaps}}<span class="dbu-clist-note" data-tooltip="Limited Control: one in a Combat Encounter (Minion Talents increase this number); outside of one, that plus your base Tier of Power">{{minionCaps.combat}} in combat &middot; {{#if minionCaps.unlimited}}no limit in all{{else}}{{minionCaps.outside}} in all{{/if}}</span>{{/if}}
        <button type="button" class="dbu-manage" data-action="openCombatWindow" data-window="minions"
                data-tooltip="Add Minions and take them off">Manage</button>
      </header>
      <div class="dbu-clist-rows">
        {{#each minionsList as |minion|}}
          <div class="dbu-crow dbu-person{{#if minion.missing}} missing{{/if}}">
            {{#if minion.unknown}}<span class="ally-img ally-unknown" aria-hidden="true">?</span>{{else}}{{#if minion.img}}<img class="ally-img" src="{{minion.img}}" alt=""/>{{/if}}{{/if}}
            <span class="dbu-person-name">{{minion.name}}</span>
            {{#if minion.kind}}<span class="dbu-temp">{{minion.kind}}</span>{{/if}}
            {{#if minion.theirs}}<span class="dbu-temp" data-tooltip="This Minion's sheet names you as its Master - taken off there">from their sheet</span>{{/if}}
          </div>
        {{else}}
        <p class="dbu-clist-empty">No Minions.</p>
        {{/each}}
      </div>
    </section>
    {{/if}}
  </div>

  {{#if combatWindow.allies}}
  <div class="dbu-combat-overlay">
    <div class="dbu-combat-window" role="dialog" aria-modal="true">
      <header><h3>Allies</h3></header>
      <p class="dbu-manage-note">Ticked: on your Allies list. Greyed: an Ally through someone else - taken off there.</p>
      <div class="dbu-combat-window-body dbu-picks ally-picks">
        {{#each allyPicks as |who|}}
        <label class="dbu-pick{{#if who.on}} on{{/if}}{{#if who.locked}} greyed{{/if}}"{{#if who.tip}} data-tooltip="{{who.tip}}"{{/if}}>
          <input type="checkbox" data-action="pickAlly" data-id="{{who.id}}" {{#if who.on}}checked{{/if}}
                 {{#if who.locked}}disabled{{/if}} {{#unless @root.editable}}disabled{{/unless}}/>
          {{#if who.unknown}}<span class="ally-img ally-unknown" aria-hidden="true">?</span>{{else}}{{#if who.img}}<img class="ally-img" src="{{who.img}}" alt=""/>{{/if}}{{/if}}
          {{who.name}}
          {{#if who.note}}<span class="dbu-pick-from">{{who.note}}</span>{{/if}}
          {{#if who.eye}}
          <button type="button" class="ally-eye{{#if who.nameHidden}} off{{/if}}" data-action="toggleAllyName" data-ally-id="{{who.id}}"
                  data-tooltip="{{#if who.nameHidden}}Hidden: this sheet's players see &quot;Unknown Ally&quot;{{else}}Shown to this sheet's players{{/if}}">
            <i class="fa-solid {{#if who.nameHidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></button>
          {{/if}}
        </label>
        {{else}}
        <p class="dbu-clist-empty">No other Character whose sheet you can see.</p>
        {{/each}}
      </div>
      <footer><button type="button" class="dbu-manage" data-action="closeCombatWindow">Close</button></footer>
    </div>
  </div>
  {{/if}}

  {{#if isMinion}}
  {{#if combatWindow.master}}
  <div class="dbu-combat-overlay">
    <div class="dbu-combat-window" role="dialog" aria-modal="true">
      <header><h3>Master</h3></header>
      <p class="dbu-manage-note">Tick its one Master. Greyed: named by their Minions list - taken off there.</p>
      <div class="dbu-combat-window-body dbu-picks ally-picks">
        {{#each masterPicks as |who|}}
        <label class="dbu-pick{{#if who.on}} on{{/if}}{{#if who.locked}} greyed{{/if}}"{{#if who.tip}} data-tooltip="{{who.tip}}"{{/if}}>
          <input type="checkbox" data-action="pickMaster" data-id="{{who.id}}" {{#if who.on}}checked{{/if}}
                 {{#if who.locked}}disabled{{/if}} {{#unless @root.editable}}disabled{{/unless}}/>
          {{#if who.unknown}}<span class="ally-img ally-unknown" aria-hidden="true">?</span>{{else}}{{#if who.img}}<img class="ally-img" src="{{who.img}}" alt=""/>{{/if}}{{/if}}
          {{who.name}}
          {{#if who.note}}<span class="dbu-pick-from">{{who.note}}</span>{{/if}}
        </label>
        {{else}}
        <p class="dbu-clist-empty">No Character whose sheet you can see with room for a Minion.</p>
        {{/each}}
      </div>
      <footer><button type="button" class="dbu-manage" data-action="closeCombatWindow">Close</button></footer>
    </div>
  </div>
  {{/if}}

  <section class="panel minion-kind-panel">
    <h3 class="panel-title">Kind of Minion</h3>
    <label class="debug-toggle"
           data-tooltip="Special Minions ignore the Weakness, Single Attack, Thresholds, and Ki Points &amp; Capacity rules for Minions.">
      <input type="checkbox" name="system.specialMinion" {{#if specialMinionShown}}checked{{/if}}
             {{#if system.duplicate}}disabled{{/if}} {{#unless editable}}disabled{{/unless}}/>
      Special Minion
      {{#if system.duplicate}}<em>as a Duplicate</em>{{/if}}
    </label>
    <label class="debug-toggle"
           data-tooltip="A copy of its Master, and a Special Minion: not its Master's Ally nor they its; no Empower; no Unique Ability or Special Maneuver at its Master; their [x/Encounter] limits shared. It ceases to exist - deleted - at the end of the Combat Encounter.">
      <input type="checkbox" name="system.duplicate" {{#if system.duplicate}}checked{{/if}} {{#unless editable}}disabled{{/unless}}/>
      Duplicate
    </label>
    {{#if system.duplicate}}
    {{! Whom it is a copy of (the user's): chosen, its Traits, Talents, Maneuvers, gear and Progression copied from them; its Progression
        tab locked while it is set. }}
    <label class="debug-toggle duplicate-of" data-tooltip="Whom this Duplicate is a copy of: choosing copies their Attributes, Race, Progression, Traits, Talents, Maneuvers and gear, and locks the Progression tab">
      of
      <select data-duplicate-of {{#unless editable}}disabled{{/unless}}>
        <option value="" {{#unless system.duplicateOf}}selected{{/unless}}>- choose -</option>
        {{#each duplicateCandidates as |who|}}
        <option value="{{who.id}}" {{#if who.selected}}selected{{/if}}>{{who.name}}{{#if who.master}} (Master){{/if}}</option>
        {{/each}}
      </select>
    </label>
    {{/if}}
    {{#unless system.duplicate}}
    <label class="debug-toggle"
           data-tooltip="Minion Creation, Step 11: Gain a Minion Trait or increase your Life Points by 2 for every Power Level you reach (this bonus to your Life Points is applied after all calculation). Ticked: the Life Points.">
      <input type="checkbox" name="system.minionLifeStep" {{#if system.minionLifeStep}}checked{{/if}} {{#unless editable}}disabled{{/unless}}/>
      Step 11: Life Points instead of a Minion Trait
      {{#if system.minionLifeStep}}<em>+2 a Power Level</em>{{/if}}
    </label>
    {{/unless}}
  </section>
  {{else}}
  {{#if combatWindow.minions}}
  <div class="dbu-combat-overlay">
    <div class="dbu-combat-window" role="dialog" aria-modal="true">
      <header><h3>Minions</h3></header>
      <p class="dbu-manage-note">Ticked: on your Minions list. Only Minions with no other Master are offered.</p>
      <div class="dbu-combat-window-body dbu-picks ally-picks">
        {{#each minionPicks as |who|}}
        <label class="dbu-pick{{#if who.on}} on{{/if}}{{#if who.locked}} greyed{{/if}}"{{#if who.tip}} data-tooltip="{{who.tip}}"{{/if}}>
          <input type="checkbox" data-action="pickMinion" data-id="{{who.id}}" {{#if who.on}}checked{{/if}}
                 {{#if who.locked}}disabled{{/if}} {{#unless @root.editable}}disabled{{/unless}}/>
          {{#if who.unknown}}<span class="ally-img ally-unknown" aria-hidden="true">?</span>{{else}}{{#if who.img}}<img class="ally-img" src="{{who.img}}" alt=""/>{{/if}}{{/if}}
          {{who.name}}
          {{#if who.note}}<span class="dbu-pick-from">{{who.note}}</span>{{/if}}
        </label>
        {{else}}
        <p class="dbu-clist-empty">No Minion without a Master whose sheet you can see.</p>
        {{/each}}
      </div>
      <footer><button type="button" class="dbu-manage" data-action="closeCombatWindow">Close</button></footer>
    </div>
  </div>
  {{/if}}
  {{/if}}

  {{! The States' Triggered effects, set beforehand as a Racial Trait's are (the user's): Triggered, offered where its
      moment is, to take or leave; Automatic, it answers that moment by itself, every time - the State held or not yet. }}
  {{! A button, the list in a window over the sheet when asked for (the user's: open, it took the whole tab). }}
  {{#if stateTriggers.length}}
  <section class="panel">
    <h3 class="panel-title">
      Triggered / Automatic
      <span class="panel-note">States</span>
      <button type="button" class="edit-toggle" data-action="openCombatWindow" data-window="stateTriggers"
              data-tooltip="Which of the States' Triggered effects answer by themselves">Open</button>
    </h3>
  </section>
  {{/if}}

  {{#if combatWindow.stateTriggers}}
  <div class="dbu-combat-overlay">
    <div class="dbu-combat-window" role="dialog" aria-modal="true">
      <header><h3>Triggered / Automatic &middot; States</h3></header>
      <p class="dbu-manage-note">Triggered: offered where its moment is, to take or leave. Automatic: it answers that moment by
        itself, every time.</p>
      <div class="dbu-combat-window-body">
        <ul class="dbu-state-triggers">
          {{#each stateTriggers as |state|}}
          <li>
            <span class="dbu-state-trigger-name">{{state.name}}</span>
            <span class="dbu-state-trigger-buttons">
              {{#each state.buttons as |trigger|}}
              <button type="button" class="trait-arm {{#if trigger.automatic}}active{{/if}}"
                      data-action="automateTrigger" data-effect-id="{{trigger.id}}"
                      data-tooltip="{{trigger.label}}">
                {{#if trigger.automatic}}Automatic{{else}}Triggered{{/if}}
              </button>
              {{/each}}
            </span>
          </li>
          {{/each}}
        </ul>
      </div>
      <footer><button type="button" class="dbu-manage" data-action="closeCombatWindow">Close</button></footer>
    </div>
  </div>
  {{/if}}

  {{! What Add Racial Trait and Add Other Trait offer: ticked, the Traits greyed as not this character's are left out. }}
  <section class="panel">
    <h3 class="panel-title">Trait lists</h3>
    <label class="debug-toggle"
           data-tooltip="Add Racial Trait and Add Other Trait leave out the Traits shown greyed - those of another race, or that you should not have.">
      <input type="checkbox" name="system.hideUnfitTraits" {{#if system.hideUnfitTraits}}checked{{/if}} {{#unless editable}}disabled{{/unless}}/>
      Only Traits you may have
    </label>
  </section>

  {{! Stand-ins for systems that do not exist yet, so the rules that depend on them
      can still be tried out. }}
  <section class="panel">
    <h3 class="panel-title">
      Debug
      <span class="panel-note">Manual stand-ins for unimplemented systems</span>
    </h3>
    <label class="debug-toggle"
           data-tooltip="From a Form entered through the Transformation Maneuver: Maximum Ki doubled, Max Capacity increased by half.">
      <input type="checkbox" name="system.debug.kiMultiplier"
             {{#if system.debug.kiMultiplier}}checked{{/if}}/>
      Ki Multiplier
      {{#if system.debug.kiMultiplier}}<em>Ki x2 &middot; Capacity x1.5</em>{{/if}}
    </label>
    {{! Set by hand, for what nothing on the sheet works out yet - the Tier of Power's and the Critical Target's. }}
    <div class="character-fields">
      <label data-tooltip="Adjustment from Transformations and effects. Breakthrough caps the result at BToP + 2.">ToP Mod
        <input type="number" name="system.tierOfPowerModifier" value="{{system.tierOfPowerModifier}}"/>
      </label>

      <label data-tooltip="Base Die result needed to crit. Effects can lower it to 7.">Crit Target
        <input type="number" name="system.criticalTarget" value="{{system.criticalTarget}}" min="7" max="10"/>
      </label>
    </div>
    {{! Turning the round and the Encounter over by hand - for a table playing without a formal Encounter, and for putting
        things right when one gets out of step. A Combat does the round on its own. }}
    <div class="capacity">
      <button type="button" data-action="resetCapacity" class="capacity-reset"
              data-tooltip="Give back the Actions and the Capacity, and clear the attacks made and the Diminishing stacks. A Combat does this on its own each round.">New round</button>
      <button type="button" data-action="resetEncounter" class="capacity-reset"
              data-tooltip="Restore maneuvers limited to once per encounter">New encounter</button>
      {{#if canEnterEncounter}}
      {{! For somebody who walked into an Encounter already under way: it began for
          everyone else when it began, and it begins for them now. Gone once taken, and
          back with the next Encounter. }}
      <button type="button" data-action="enterEncounter" class="capacity-reset"
              data-tooltip="The Combat Encounter begins for you now. Applies your start-of-Encounter effects, once.">Enter the encounter</button>
      {{/if}}
    </div>
  </section>

</div>

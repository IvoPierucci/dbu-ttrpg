<div class="tab {{tabs.settings.cssClass}}" data-group="primary" data-tab="settings">

  {{! Who this character's Allies are, for every effect: those on this list, and those whose own list names them - both ways.
      Nobody else, whatever their token's disposition. }}
  <section class="panel ally-panel">
    <h3 class="panel-title">Allies</h3>
    {{#if editable}}
    <button type="button" class="edit-toggle ally-add" data-action="addAllies">+ Add Allies</button>
    {{/if}}
    {{#if allies.length}}
    <ul class="ally-list">
      {{#each allies as |ally|}}
      <li class="ally{{#if ally.theirs}} theirs{{/if}}{{#if ally.missing}} missing{{/if}}">
        {{#if ally.theirs}}
        <span class="ally-x-space"></span>
        {{else}}
          {{#if @root.editable}}
          <button type="button" class="ally-x" data-action="removeAlly" data-ally-id="{{ally.id}}"
                  data-tooltip="Take {{ally.name}} off the Allies list">&#10005;</button>
          {{else}}
          <span class="ally-x-space"></span>
          {{/if}}
        {{/if}}
        {{#if ally.unknown}}<span class="ally-img ally-unknown" aria-hidden="true">?</span>{{else}}{{#if ally.img}}<img class="ally-img" src="{{ally.img}}" alt=""/>{{/if}}{{/if}}
        <span class="ally-name">{{ally.name}}</span>
        {{#if ally.theirs}}<span class="ally-note" data-tooltip="Their Allies list names this character - taken off from their sheet">from their list</span>{{/if}}
        {{#if @root.isGM}}{{#unless ally.theirs}}
        <button type="button" class="ally-eye{{#if ally.nameHidden}} off{{/if}}" data-action="toggleAllyName" data-ally-id="{{ally.id}}"
                data-tooltip="{{#if ally.nameHidden}}Hidden: this sheet's players see &quot;Unknown Ally&quot;{{else}}Shown to this sheet's players{{/if}}">
          <i class="fa-solid {{#if ally.nameHidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></button>
        {{/unless}}{{/if}}
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="tab-placeholder">No Allies yet. Every other Character counts as an Opponent.</p>
    {{/if}}
  </section>

  {{! Set by hand, for what nothing on the sheet works out yet - from the Progression tab (the user's). }}
  <section class="panel">
    <h3 class="panel-title">Tier of Power and Critical Target</h3>
    <div class="character-fields">
      <label data-tooltip="Adjustment from Transformations and effects. Breakthrough caps the result at BToP + 2.">ToP Mod
        <input type="number" name="system.tierOfPowerModifier" value="{{system.tierOfPowerModifier}}"/>
      </label>

      <label data-tooltip="Base Die result needed to crit. Effects can lower it to 7.">Crit Target
        <input type="number" name="system.criticalTarget" value="{{system.criticalTarget}}" min="7" max="10"/>
      </label>
    </div>
  </section>

  {{! The States' Triggered effects, set beforehand as a Racial Trait's are (the user's): Triggered, offered where its
      moment is, to take or leave; Automatic, it answers that moment by itself, every time - the State held or not yet. }}
  {{#if stateTriggers.length}}
  <section class="panel">
    <h3 class="panel-title">
      Triggered / Automatic
      <span class="panel-note">States</span>
    </h3>
    <ul class="dbu-state-triggers">
      {{#each stateTriggers as |state|}}
      <li>
        <span class="dbu-state-trigger-name">{{state.name}}</span>
        <span class="dbu-state-trigger-buttons">
          {{#each state.buttons as |trigger|}}
          <button type="button" class="trait-arm {{#if trigger.automatic}}active{{/if}}"
                  data-action="automateTrigger" data-effect-id="{{trigger.id}}"
                  data-tooltip="{{trigger.label}}">
            {{#if trigger.automatic}}Automatic{{else}}Triggered{{/if}}
          </button>
          {{/each}}
        </span>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{! Turning the round and the Encounter over by hand - for a table playing without a formal Encounter, and for putting
      things right when one gets out of step. A Combat does the round on its own. }}
  <section class="panel">
    <h3 class="panel-title">Rounds and Encounters</h3>
    <div class="capacity">
      <button type="button" data-action="resetCapacity" class="capacity-reset"
              data-tooltip="Give back the Actions and the Capacity, and clear the attacks made and the Diminishing stacks. A Combat does this on its own each round.">New round</button>
      <button type="button" data-action="resetEncounter" class="capacity-reset"
              data-tooltip="Restore maneuvers limited to once per encounter">New encounter</button>
      {{#if canEnterEncounter}}
      {{! For somebody who walked into an Encounter already under way: it began for
          everyone else when it began, and it begins for them now. Gone once taken, and
          back with the next Encounter. }}
      <button type="button" data-action="enterEncounter" class="capacity-reset"
              data-tooltip="The Combat Encounter begins for you now. Applies your start-of-Encounter effects, once.">Enter the encounter</button>
      {{/if}}
    </div>
  </section>

  {{! Stand-ins for systems that do not exist yet, so the rules that depend on them
      can still be tried out. }}
  <section class="panel">
    <h3 class="panel-title">
      Debug
      <span class="panel-note">Manual stand-ins for unimplemented systems</span>
    </h3>
    <label class="debug-toggle"
           data-tooltip="From a Form entered through the Transformation Maneuver: Maximum Ki doubled, Max Capacity increased by half.">
      <input type="checkbox" name="system.debug.kiMultiplier"
             {{#if system.debug.kiMultiplier}}checked{{/if}}/>
      Ki Multiplier
      {{#if system.debug.kiMultiplier}}<em>Ki x2 &middot; Capacity x1.5</em>{{/if}}
    </label>
  </section>

</div>

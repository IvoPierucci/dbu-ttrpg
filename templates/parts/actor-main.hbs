<div class="tab {{tabs.main.cssClass}}" data-group="primary" data-tab="main">

  {{! The user's design (2026-11-15): the Attributes' Modifiers as seven cards, rolled from them; the Skills in a block per
      Attribute, in the Attributes' order. The Score cap is Progression's now, by the Scores it caps. }}
  <section class="panel">
    <h3 class="panel-title">Attributes <span class="panel-note">Modifiers</span></h3>
    <div class="dbu-main-attributes">
      {{#each attributeCards as |attribute|}}
      {{! As Might's box on Combat (the user's, 2026-11-16): its name, in the accent, is what rolls; its Modifier shows what it is
          made of on hover. }}
      <div class="dbu-main-attribute">
        <button type="button" class="stat-roll dbu-main-attribute-name" data-action="rollAttribute" data-attribute="{{attribute.key}}"
                data-tooltip="Roll 1d10 + Modifier">{{attribute.key}}</button>
        <span class="dbu-main-attribute-mod" data-tooltip-html="{{attribute.workings}}">{{attribute.mod}}</span>
      </div>
      {{/each}}
    </div>
  </section>

  {{! The Aptitudes are no longer here (the user's): Surgency on the Combat tab with the rest of them, the Stress Bonus on
      Progression, Ingenuity on the Gear tab. }}

  <!-- Skills. Ranks come from the Skill Improvement rows in the Progression tab. -->
  <section class="panel">
    <h3 class="panel-title">
      Skills
      <span class="panel-note">Bonus = 1/2 Attribute Score + 2 per Rank &middot; Rank cap: {{system.skillRankCap}}</span>
    </h3>

    <div class="dbu-main-skills">
      {{#each skillColumns as |column|}}
      <div class="dbu-main-column">
        {{#each column as |group|}}
        <div class="dbu-main-block skill-group">
          <header><b>{{group.label}}</b><span>Mod <strong>{{group.mod}}</strong></span></header>
          <ul class="dbu-main-rows">
            {{#each group.skills as |skill|}}
            <li class="skill dbu-main-row {{#if skill.untrained}}skill-untrained{{/if}} {{#if skill.overCap}}skill-over-cap{{/if}}">
              <div class="dbu-main-line">
                <span class="skill-name">
                  {{#if skill.untrained}}
                    {{! A Required Skill with no Ranks always fails, so there is nothing to roll. }}
                    <span class="skill-label">{{skill.label}}</span>
                  {{else}}
                    <button type="button" class="skill-label rollable" data-action="rollSkill"
                            data-skill="{{skill.key}}" data-tooltip="{{#if skill.folded}}Roll it - every one of them has this Bonus{{else}}Roll this Skill{{/if}}">{{skill.label}}</button>
                  {{/if}}
                  {{#if skill.required}}<span class="skill-flag" data-tooltip="Required: cannot be rolled without at least one Rank">R</span>{{/if}}
                </span>
                {{! The Ranks as pips up to the Rank cap; past it, red. }}
                <span class="dbu-main-pips skill-ranks" data-tooltip="{{skill.ranks}} Rank{{#unless (eq skill.ranks 1)}}s{{/unless}}">{{#each skill.pips as |pip|}}<i class="{{#if pip.on}}on{{/if}}{{#if pip.over}} over{{/if}}"></i>{{/each}}</span>
                <span class="skill-bonus dbu-main-bonus" data-tooltip-html="{{skill.workings}}">{{numberFormat skill.roll decimals=0 sign=true}}</span>
                <span class="skill-crit {{#if skill.criticalLowered}}skill-crit-lowered{{/if}}" data-tooltip="Critical Target">({{skill.critical}}+)</span>
              </div>

              {{#if skill.specialties}}
              {{! The Specialties the entry lists, ticked - any number of them. }}
              <div class="skill-specialties dbu-main-sub">
                {{#each skill.specialties as |specialty|}}
                <label class="skill-specialty" data-tooltip="{{specialty.label}} Specialty">
                  <input type="checkbox" data-action="toggleSpecialty" data-skill="{{skill.key}}" data-specialty="{{specialty.value}}"
                         {{#if specialty.held}}checked{{/if}}/>{{specialty.label}}</label>
                {{/each}}
              </div>
              {{else if skill.encompassing}}
              <div class="dbu-main-sub">
                <input type="text" class="skill-specialization" placeholder="specialisation"
                       name="system.skillSpecializations.{{skill.key}}" value="{{skill.specialization}}"/>
              </div>
              {{/if}}
            </li>
            {{/each}}
          </ul>
        </div>
        {{/each}}
      </div>
      {{/each}}
    </div>
  </section>

  {{! The Saving Throws are on the Combat tab (the user's). }}

</div>

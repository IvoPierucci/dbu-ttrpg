<div class="tab {{tabs.gear.cssClass}}" data-group="primary" data-tab="gear">

{{! Gear, which is the rulebook's Equipment. "There are four Item Types in DBU: Basic Item,
    Accessory, Apparel, and Weapon" - drawn as three lists, because "Accessories are also
    counted as Basic Items for rules and effects" and so share the first.

    Apparel and Weapons are built on their own sheets rather than picked from a list. }}
  <section class="panel">
    <details class="condition-group" data-section="gearBasic"
             {{#if openSections.gearBasic}}open{{/if}}>
      <summary class="panel-title">Basic Items &amp; Accessories</summary>

      {{#each gear.basic as |row|}}
      <div class="gear-row" data-item-id="{{row.itemId}}" draggable="true">
        <img src="{{row.img}}" width="24" height="24"/>
        <span class="gear-name">{{row.name}}</span>
        {{#each row.tags as |tag|}}<span class="gear-tag">[{{tag}}]</span>{{/each}}
        {{#if row.materialized}}<span class="gear-warning" data-tooltip="Magical Materialization: destroyed at the end of a Combat Encounter, unless a Karma Point is spent to preserve it">Materialized</span>{{/if}}
        <span class="gear-type">{{row.typeLabel}}{{#if row.sizeLabel}} &middot; {{row.sizeLabel}}{{/if}}</span>
        {{#if row.intendedName}}
        <span class="gear-type">for {{row.intendedName}}</span>
        {{/if}}
        {{#if row.accessory}}
        {{#if row.lockedOn}}
        <span class="gear-type">Locked on</span>
        {{else}}
        {{#if row.equipped}}<span class="gear-type">Equipped</span>{{/if}}
        <button type="button" class="gear-act" data-action="equipGear"
                data-item-id="{{row.itemId}}">{{#if row.equipped}}Unequip{{else}}Equip{{/if}}</button>
        {{/if}}
        {{/if}}
        {{#if row.shrinks}}
        {{#if row.shrunkTo}}<span class="gear-type">{{row.shrunkTo}}</span>{{/if}}
        <button type="button" class="gear-act" data-action="shrinkGear"
                data-item-id="{{row.itemId}}">{{#if row.shrunkTo}}Return{{else}}Shrink{{/if}}</button>
        {{/if}}
        {{#if row.lockable}}
        <button type="button" class="gear-act" data-action="lockGear"
                data-item-id="{{row.itemId}}"
                data-tooltip="Target them first.">Lock on</button>
        {{/if}}
        {{#if row.unlocks}}
        <button type="button" class="gear-act" data-action="unlockGear"
                data-item-id="{{row.itemId}}"
                data-tooltip="Target the one wearing it, or nobody for yourself.">Unlock</button>
        {{/if}}
        {{#if row.explosive}}
        {{#if row.placed}}
        <span class="gear-type">{{row.triggerLabel}}{{#if row.countdown}} &middot; {{row.countdown}} Rounds{{/if}}</span>
        {{#if row.canDetonate}}
        <button type="button" class="gear-act" data-action="detonateGear"
                data-item-id="{{row.itemId}}"
                data-tooltip="Target the first one it catches. Add the rest from the card.">Detonate</button>
        {{/if}}
        {{else}}
        <button type="button" class="gear-act" data-action="placeGear"
                data-item-id="{{row.itemId}}" data-tooltip="{{row.triggerLabel}}">Place</button>
        {{/if}}
        {{/if}}
        {{#if row.capsule}}
        {{#if row.heldId}}
        <a class="gear-type" data-action="editItem" data-item-id="{{row.heldId}}">holds {{row.heldName}}</a>
        <button type="button" class="gear-act" data-action="throwGear"
                data-item-id="{{row.itemId}}"
                data-tooltip="Where it appears is the table's.">Throw</button>
        {{else}}
        <button type="button" class="gear-act" data-action="storeGear"
                data-item-id="{{row.itemId}}">Store</button>
        {{/if}}
        {{/if}}
        {{#if row.setLabel}}
        <span class="gear-type">{{row.setLabel}}</span>
        {{/if}}
        {{#if row.assigns}}
        <span class="gear-type">{{#if row.assignedName}}&rarr; {{row.assignedName}}{{else}}not assigned{{/if}}</span>
        {{/if}}
        {{#if row.teleports}}
        <button type="button" class="gear-act" data-action="teleportGear"
                data-item-id="{{row.itemId}}"
                data-tooltip="Moving the tokens is yours.">Teleport</button>
        {{/if}}
        {{#each row.portions as |portion|}}
        <button type="button" class="gear-act" data-action="eatPortion"
                data-item-id="{{../itemId}}" data-portion="{{portion.key}}">{{portion.label}} ({{portion.count}})</button>
        {{/each}}
        {{#if row.draws}}
        <button type="button" class="gear-act" data-action="drawGear"
                data-item-id="{{row.itemId}}">Draw</button>
        {{/if}}
        {{#if row.crystalBall}}
        <button type="button" class="gear-act" data-action="crystalBall" data-item-id="{{row.itemId}}"
                data-tooltip="Use Magic Check (Expert): passed, you may use Second Sight through it">Second Sight</button>
        {{/if}}
        {{#if row.spendsCharge}}
        <button type="button" class="gear-act" data-action="chargeGear"
                data-item-id="{{row.itemId}}">{{row.chargeUseLabel}}</button>
        {{/if}}
        {{#if row.summons}}
        <button type="button" class="gear-act" data-action="summonGear"
                data-item-id="{{row.itemId}}"
                data-tooltip="Every Action left this turn, three at least.">Summon</button>
        {{/if}}
        {{#if row.restores}}
        <button type="button" class="gear-act" data-action="restoreGear"
                data-item-id="{{row.itemId}}">Eat</button>
        {{#if row.feeds}}
        <button type="button" class="gear-act" data-action="restoreGear" data-feed="1"
                data-item-id="{{row.itemId}}"
                data-tooltip="Target the Defeated character beside you first.">Feed</button>
        {{/if}}
        {{/if}}
        {{#if row.lights}}
        <button type="button" class="gear-act" data-action="lightGear"
                data-item-id="{{row.itemId}}">{{#if row.lit}}Put out{{else}}Light{{/if}}</button>
        {{/if}}
        {{#if row.bursts}}
        <button type="button" class="gear-act" data-action="burstGear"
                data-item-id="{{row.itemId}}"
                data-tooltip="Target everyone in the area first.">Throw</button>
        {{/if}}
        {{#if row.breaksAt}}
        <span class="gear-type"
              data-tooltip="Destroyed when a Character of Tier of Power {{row.breaksAt}}+ uses the Power Up Maneuver within 15 Squares.">Fragile</span>
        {{/if}}
        {{#if row.scans}}
        <button type="button" class="gear-act" data-action="scanGear"
                data-item-id="{{row.itemId}}"
                data-tooltip="Target the one to scan first.">Scan</button>
        {{/if}}
        {{#if row.remote}}
        <span class="gear-type">{{#if row.connectedName}}&rarr; {{row.connectedName}}{{else}}not connected{{/if}}</span>
        {{#if row.canTrigger}}
        <button type="button" class="gear-act" data-action="remoteGear"
                data-item-id="{{row.itemId}}"
                data-tooltip="Target the first one it catches. Add the rest from the card.">Trigger</button>
        {{/if}}
        {{/if}}
        {{#if row.chargesLabel}}
        <span class="gear-type">{{row.charges}} {{row.chargesLabel}}</span>
        {{/if}}
        {{#if row.poisons}}
        <button type="button" class="gear-act" data-action="poisonGear"
                data-item-id="{{row.itemId}}" data-tooltip="1 Action and a Drop: one of your Weapons, until the Encounter ends.">Poison</button>
        {{/if}}
        {{#if row.snares}}
        <button type="button" class="gear-act" data-action="snareGear"
                data-item-id="{{row.itemId}}"
                data-tooltip="Target the one it is thrown at first.">Throw</button>
        {{/if}}
        {{#if row.consumable}}
        {{#if row.usedUp}}
        <span class="gear-type">Used this Encounter</span>
        {{else}}
        <button type="button" class="gear-act" data-action="consumeGear"
                data-item-id="{{row.itemId}}">Consume</button>
        {{/if}}
        {{/if}}
        {{#if row.clashes}}
        <button type="button" class="gear-act" data-action="clashGear"
                data-item-id="{{row.itemId}}"
                data-tooltip="Target everyone it catches first. One Clash each.">Throw</button>
        {{/if}}
        {{#if row.scatters}}
        <button type="button" class="gear-act" data-action="scatterGear"
                data-item-id="{{row.itemId}}"
                data-tooltip="Where they land is the table's. Whoever moves through them presses the card.">Scatter</button>
        {{/if}}
        <button type="button" class="gear-control" data-action="editItem"
                data-item-id="{{row.itemId}}" data-tooltip="Edit">&#9998;</button>
        <button type="button" class="gear-remove" data-action="deleteItem"
                data-item-id="{{row.itemId}}" data-tooltip="Remove">&times;</button>
      </div>
      {{else}}
      <p class="tab-placeholder">None yet.</p>
      {{/each}}

      <button type="button" class="dbu-clash-button" data-action="addGear" data-list="basic">
        Add Item
      </button>
    </details>
  </section>

  <section class="panel">
    <details class="condition-group" data-section="gearApparel"
             {{#if openSections.gearApparel}}open{{/if}}>
      <summary class="panel-title">Apparel</summary>

      {{#each gear.apparel as |row|}}
      <div class="gear-row" data-item-id="{{row.itemId}}" draggable="true">
        <img src="{{row.img}}" width="24" height="24"/>
        <span class="gear-name">{{row.name}}</span>
        <span class="gear-type">{{row.typeLabel}}</span>
        {{#if row.overSlots}}
        <span class="gear-warning" data-tooltip="More Qualities than its Quality Slots. It still works.">+{{row.overSlots}} over</span>
        {{/if}}
        {{! Worn: the one button, off the Layer it is on. Not: a button for each Layer, closed
            while another piece is on it. }}
        {{#if row.breakLabel}}<span class="gear-type">{{row.breakLabel}}</span>{{/if}}
        {{#if row.repairable}}
        <button type="button" class="gear-act" data-action="repairGear" data-item-id="{{row.itemId}}"
                data-tooltip="After a Qualified Apparel Craft Skill Check, out of a Combat Encounter, with an hour to spend on it.">Repair</button>
        {{/if}}
        {{#if row.actsAsTop}}
        <span class="gear-type" data-tooltip="Nothing is on the Top Layer: this acts as it, and its Category applies.">as Top</span>
        {{/if}}
        {{#if row.worn}}
        <button type="button" class="gear-act" data-action="layerGear"
                data-item-id="{{row.itemId}}" {{#if row.offCost}}data-tooltip="{{row.offCost}}"{{/if}}>Unequip{{#if row.layerLabel}} {{row.layerLabel}}{{/if}}</button>
        {{else}}
        {{#each row.layers as |layer|}}
        <button type="button" class="gear-act" data-action="layerGear" data-item-id="{{../itemId}}"
                data-layer="{{layer.key}}" {{#if layer.blocked}}disabled data-tooltip="{{layer.blocked}}"{{else}}{{#if layer.cost}}data-tooltip="{{layer.cost}}"{{/if}}{{/if}}>Equip {{layer.label}}</button>
        {{/each}}
        {{/if}}
        <button type="button" class="gear-control" data-action="editItem"
                data-item-id="{{row.itemId}}" data-tooltip="Edit">&#9998;</button>
        <button type="button" class="gear-remove" data-action="deleteItem"
                data-item-id="{{row.itemId}}" data-tooltip="Remove">&times;</button>
      </div>
      {{else}}
      <p class="tab-placeholder">None yet.</p>
      {{/each}}

      <button type="button" class="dbu-clash-button" data-action="addApparel">
        Add Apparel
      </button>
    </details>
  </section>

  <section class="panel">
    <details class="condition-group" data-section="gearWeapons"
             {{#if openSections.gearWeapons}}open{{/if}}>
      <summary class="panel-title">Weapons</summary>

      {{#each gear.weapon as |row|}}
      <div class="gear-row" data-item-id="{{row.itemId}}" draggable="true">
        <img src="{{row.img}}" width="24" height="24"/>
        <span class="gear-name">{{row.name}}</span>
        <span class="gear-type">{{row.typeLabel}}</span>
        {{#if row.overSlots}}
        <span class="gear-warning" data-tooltip="More Qualities than its Quality Slots. It still works.">+{{row.overSlots}} over</span>
        {{/if}}
        {{#if row.breakLabel}}<span class="gear-type">{{row.breakLabel}}</span>{{/if}}
        {{#if row.repairable}}
        <button type="button" class="gear-act" data-action="repairGear" data-item-id="{{row.itemId}}"
                data-tooltip="The Full Repair Adventuring Maneuver: 2+ Ranks in Craft, once an Adventuring Session - 1/5 of its Life Points for every 2 hours.">Repair</button>
        {{/if}}
        {{#if row.flexedTo}}<span class="gear-type" data-tooltip="Flexible: until the end of this turn.">as {{row.flexedTo}}</span>{{/if}}
        {{#each row.flexes as |flex|}}
        <button type="button" class="gear-act" data-action="flexGear" data-item-id="{{../itemId}}"
                data-value="{{flex.value}}" data-tooltip="Flexible: this Category until the end of your turn.">{{flex.label}}</button>
        {{/each}}
        {{#each row.resizes as |size|}}
        <button type="button" class="gear-act" data-action="resizeGear" data-item-id="{{../itemId}}"
                data-value="{{size.value}}" data-tooltip="Variable: the No Effort Maneuver, in a Combat Encounter.">{{size.label}}</button>
        {{/each}}
        {{#if row.remote}}
        <span class="gear-type">{{#if row.connectedName}}&rarr; {{row.connectedName}}{{else}}not attuned{{/if}}</span>
        {{#if row.attunes}}
        <button type="button" class="gear-act" data-action="attuneGear" data-item-id="{{row.itemId}}"
                data-tooltip="Controller Weapon: which of your Items it sets off.">Attune</button>
        {{/if}}
        {{#if row.canTrigger}}
        <button type="button" class="gear-act" data-action="remoteGear" data-item-id="{{row.itemId}}"
                data-tooltip="1 Action. Target the first one it catches.">Trigger</button>
        {{/if}}
        {{/if}}
        {{#if row.snacks}}
        <button type="button" class="gear-act" data-action="snackGear" data-item-id="{{row.itemId}}"
                data-tooltip="1 Action. {{row.snacks}} left this Encounter.">Snack</button>
        {{/if}}
        {{#if row.sheathedName}}<span class="gear-type">in {{row.sheathedName}}</span>{{/if}}
        {{#if row.poisoned}}<span class="gear-type">Poisoned</span>{{/if}}
        {{#if row.wielded}}<span class="gear-type">Wielded</span>{{/if}}
        <button type="button" class="gear-act" data-action="wieldGear" data-item-id="{{row.itemId}}"
                {{#if row.wieldBlocked}}disabled data-tooltip="{{row.wieldBlocked}}"{{else}}{{#if row.wieldCost}}data-tooltip="{{row.wieldCost}}"{{/if}}{{/if}}>{{#if row.wielded}}Sheathe{{else}}Wield{{/if}}</button>
        <button type="button" class="gear-control" data-action="editItem"
                data-item-id="{{row.itemId}}" data-tooltip="Edit">&#9998;</button>
        <button type="button" class="gear-remove" data-action="deleteItem"
                data-item-id="{{row.itemId}}" data-tooltip="Remove">&times;</button>
      </div>
      {{else}}
      <p class="tab-placeholder">None yet.</p>
      {{/each}}

      <button type="button" class="dbu-clash-button" data-action="addWeapon">
        Add Weapon
      </button>
    </details>
  </section>

  <section class="panel">
    <details class="condition-group" data-section="gearBuddies"
             {{#if openSections.gearBuddies}}open{{/if}}>
      <summary class="panel-title">Buddies</summary>

      {{#each gear.buddy as |row|}}
      <div class="gear-row" data-item-id="{{row.itemId}}" draggable="true">
        <img src="{{row.img}}" width="24" height="24"/>
        <span class="gear-name" data-tooltip="{{row.tip}}">{{row.name}}</span>
        {{#if row.buddyKind}}<span class="gear-tag">[{{row.buddyKind}}]</span>{{/if}}
        {{#if row.choiceLabel}}<span class="gear-type">{{row.choiceLabel}}</span>{{/if}}
        {{#if row.destroyed}}<span class="gear-type">Destroyed</span>{{/if}}
        {{#if row.locked}}<span class="gear-type" data-tooltip="Until the Combat Encounter ends.">Locked</span>{{/if}}
        {{#if row.active}}<span class="gear-type">Active</span>{{/if}}
        {{#each row.actions as |action|}}
        <button type="button" class="gear-act" data-action="useBuddy" data-item-id="{{../itemId}}"
                data-key="{{action.key}}" data-form="{{action.form}}"
                {{#if action.used}}disabled data-tooltip="Used this Combat Round."{{else}}data-tooltip="{{action.tip}}"{{/if}}>{{action.label}}</button>
        {{/each}}
        {{#if row.remote}}
        {{#if row.canTrigger}}
        <button type="button" class="gear-act" data-action="remoteGear" data-item-id="{{row.itemId}}"
                data-tooltip="A Remote Control for every Bomb and Collar of yours. 1 Action.">Trigger</button>
        {{/if}}
        {{/if}}
        {{#if row.grows}}
        <button type="button" class="gear-act" data-action="growSenzu" data-item-id="{{row.itemId}}"
                data-tooltip="While Adventuring: 1~4 Months for a Bag of Senzu Beans.">Grow Senzu</button>
        {{/if}}
        {{#unless row.destroyed}}
        <button type="button" class="gear-act" data-action="callBuddy" data-item-id="{{row.itemId}}"
                {{#if row.callBlocked}}disabled data-tooltip="{{row.callBlocked}}"{{else}}data-tooltip="An Instant Maneuver, at the start of your turn."{{/if}}>{{#if row.active}}Dismiss{{else}}Call{{/if}}</button>
        {{/unless}}
        <button type="button" class="gear-control" data-action="editItem"
                data-item-id="{{row.itemId}}" data-tooltip="Edit">&#9998;</button>
        <button type="button" class="gear-remove" data-action="deleteItem"
                data-item-id="{{row.itemId}}" data-tooltip="Remove">&times;</button>
      </div>
      {{else}}
      <p class="tab-placeholder">None yet.</p>
      {{/each}}

      <button type="button" class="dbu-clash-button" data-action="addGear" data-list="buddy">
        Add Buddy
      </button>
    </details>
  </section>
</div>

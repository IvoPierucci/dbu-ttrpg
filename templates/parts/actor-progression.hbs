<div class="tab {{tabs.progression.cssClass}}" data-group="primary" data-tab="progression">

  <!-- Everything the character is built from. The header only reports these. -->
  <section class="panel">
    <h3 class="panel-title">Character</h3>
    <div class="character-fields">
      <label>Race
        <select name="system.race">
          <option value=""></option>
          {{#each raceOptions as |race|}}
          <option value="{{race.value}}" {{#if race.selected}}selected{{/if}}
                  data-tooltip="{{race.description}}">{{race.label}}</option>
          {{/each}}
        </select>
      </label>

      {{#if subraceOptions.length}}
      <label>Subrace
        <select name="system.subrace">
          <option value=""></option>
          {{#each subraceOptions as |subrace|}}
          <option value="{{subrace.value}}" {{#if subrace.selected}}selected{{/if}}>{{subrace.label}}</option>
          {{/each}}
        </select>
      </label>
      {{/if}}

      <label data-tooltip="Larger is tougher, smaller is harder to hit. Both scale with Tier of Power.">Size
        <select name="system.size">
          {{#each sizeOptions as |size|}}
          <option value="{{size.value}}" {{#if size.selected}}selected{{/if}}>{{size.label}}</option>
          {{/each}}
        </select>
      </label>

      <label>Power Level
        <input type="number" name="system.powerLevel" value="{{system.powerLevel}}" min="1" max="30"/>
      </label>

      <label data-tooltip="Adjustment from Transformations and effects. Breakthrough caps the result at BToP + 2.">ToP Mod
        <input type="number" name="system.tierOfPowerModifier" value="{{system.tierOfPowerModifier}}"/>
      </label>

      <label data-tooltip="Base Die result needed to crit. Effects can lower it to 7.">Crit Target
        <input type="number" name="system.criticalTarget" value="{{system.criticalTarget}}" min="7" max="10"/>
      </label>

      {{! Sum of every TP grant from Level 1 up to the current Power Level. }}
      <span class="character-readout" data-tooltip="Total granted up to your Power Level">
        <em>Technique Points</em>
        <span class="computed-value headline">{{system.techniquePoints}}</span>
      </span>
    </div>
  </section>

  <!-- Where the table's Attribute columns and the Aptitudes they feed end up. -->
  <section class="progression-summary">
    <div class="stat-grid scores">
      {{#each attributeColumns as |column|}}
      <div class="stat" data-tooltip="{{column.key}}"><em>{{column.abbr}}</em><span>{{column.score}}</span></div>
      {{/each}}
    </div>
    <div class="stat-grid">
      <div class="stat"><em>Haste</em><span>{{system.haste}}</span></div>
      <div class="stat"><em>Awareness</em><span>{{system.awareness}}</span></div>
      <div class="stat"><em>Defense Value</em><span>{{system.defenseValue}}</span></div>
    </div>
  </section>

  {{#if racialSkillRanks.length}}
  <!-- What the race grants. Kept apart from the Power Level table because none of it
       is earned by levelling, though the Skill Ranks do count toward the same cap. -->
  <section class="panel racial-grants">
    <h3 class="panel-title">
      Racial Grants
      <span class="panel-note">Granted at Power Level 1 &middot; Skill Ranks count toward the rank cap</span>
    </h3>

    {{#if racialAttributeChoices.length}}
    <div class="racial-row">
      <span class="racial-row-label">Attribute Increase</span>
      <div class="racial-slots">
        {{#each racialAttributeChoices as |choice|}}
        <label class="racial-choice">
          <em>+{{choice.amount}}</em>
          <select name="{{choice.name}}">
            <option value=""></option>
            {{#each choice.options as |option|}}
            <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}
                    {{#if option.disabled}}disabled{{/if}}>{{option.label}}</option>
            {{/each}}
          </select>
        </label>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <div class="racial-row">
      <span class="racial-row-label">Skill Ranks</span>
      {{! The Skill Improvement's window, for the race's Ranks: the slots hidden, written as it closes. }}
      <div class="racial-slots racial-skills" data-benefit-scope>
        {{#each racialSkillRanks as |slot|}}
        <input type="hidden" name="{{slot.name}}" value="{{slot.value}}" data-benefit-skill/>
        {{/each}}
        <button type="button" class="benefit-pick{{#unless racialSkillBenefit.label}} empty{{/unless}}" data-benefit="skills"
                data-benefit-data="{{racialSkillBenefit.data}}">{{#if racialSkillBenefit.label}}{{racialSkillBenefit.label}}{{else}}Choose&hellip;{{/if}}{{#if racialSkillBenefit.left}} <span class="benefit-left">({{racialSkillBenefit.left}} left)</span>{{/if}}{{#if racialSkillBenefit.over}} <span class="benefit-over">(over the cap)</span>{{/if}}</button>
      </div>
    </div>
  </section>
  {{/if}}

  <table class="progression-table">
    <thead>
      <tr>
        <th>Level</th>
        <th>Choice</th>
        <th>Benefits</th>
        <th>TP</th>
      </tr>
    </thead>
    <tbody>
      {{#each progressionRows as |row|}}
      <tr class="{{#if row.firstOfLevel}}level-start{{/if}} {{#unless row.reached}}unreached{{/unless}}">

        <td class="level-cell">
          {{! Foundry rebuilds the whole progression array from the submitted form, so
              every schema field of a row must appear in it. Fields with no visible
              control are carried as hidden inputs - otherwise they would silently fall
              back to their schema `initial` on every save. }}
          <input type="hidden" name="system.progression.{{row.index}}.lvl" value="{{row.entry.lvl}}" data-dtype="Number"/>
          <input type="hidden" name="system.progression.{{row.index}}.stepType" value="{{row.entry.stepType}}"/>
          <input type="hidden" name="system.progression.{{row.index}}.locked" value="{{row.entry.locked}}" data-dtype="Boolean"/>
          {{#if row.firstOfLevel}}{{row.entry.lvl}}{{/if}}
        </td>

        <td>
          {{#if row.entry.locked}}
            <span class="locked-choice">{{row.entry.choice}}</span>
            <input type="hidden" name="system.progression.{{row.index}}.choice" value="{{row.entry.choice}}"/>
          {{else}}
            <select name="system.progression.{{row.index}}.choice">
              <option value="Character Perk" {{#if (eq row.entry.choice "Character Perk")}}selected{{/if}}>Character Perk</option>
              <option value="Attribute Addition" {{#if (eq row.entry.choice "Attribute Addition")}}selected{{/if}}>Attribute Addition</option>
              <option value="Skill Improvement" {{#if (eq row.entry.choice "Skill Improvement")}}selected{{/if}}>Skill Improvement</option>
              <option value="Talent Addition" {{#if (eq row.entry.choice "Talent Addition")}}selected{{/if}}>Talent Addition</option>
            </select>
          {{/if}}
        </td>

        <td class="benefit-cell" data-benefit-scope>
          {{! What every row carries whatever it is: its seven Attribute points and its Skill Rank slots - written by the
              Attribute Addition's and the Skill Improvement's windows, submitted as they close. }}
          {{#each row.attributeFields as |field|}}
          <input type="hidden" name="{{field.name}}" value="{{field.value}}" data-dtype="Number" data-benefit-attribute="{{field.key}}"/>
          {{/each}}
          {{#each row.skillRanks as |slot|}}
          <input type="hidden" name="{{slot.name}}" value="{{slot.value}}" data-benefit-skill/>
          {{/each}}
          {{#if row.benefit}}
            <button type="button" class="benefit-pick{{#unless row.benefit.label}} empty{{/unless}}" data-benefit="{{row.benefit.kind}}"
                    data-benefit-data="{{row.benefit.data}}">{{#if row.benefit.label}}{{row.benefit.label}}{{else}}Choose&hellip;{{/if}}{{#if row.benefit.left}} <span class="benefit-left">({{row.benefit.left}} left)</span>{{/if}}{{#if row.benefit.over}} <span class="benefit-over">(over the cap)</span>{{/if}}</button>
          {{/if}}
          {{#if row.isTalentAddition}}
            {{! A list typed into: the box shows the Talent chosen, letters narrow the list under it (by name or Category), a
                pick writes the hidden field the row submits. The box itself is never submitted. }}
            <div class="dbu-combo" data-combo>
              <input type="hidden" name="system.progression.{{row.index}}.talent" value="{{row.entry.talent}}"/>
              <input type="text" class="dbu-combo-input" autocomplete="off" spellcheck="false" placeholder="Choose a Talent"
                     role="combobox" aria-expanded="false" aria-label="Talent"/>
              <span class="dbu-combo-caret" aria-hidden="true">&#9662;</span>
              <div class="dbu-combo-list" role="listbox" hidden>
                <div class="dbu-combo-option dbu-combo-none" role="option" data-value="">None</div>
                {{#each row.talentGroups as |group|}}
                <div class="dbu-combo-group" data-group="{{group.label}}">{{group.label}}</div>
                {{#each group.options as |option|}}
                <div class="dbu-combo-option{{#if option.selected}} chosen{{/if}}" role="option" data-value="{{option.value}}"
                     data-group="{{group.label}}">{{option.label}}</div>
                {{/each}}
                {{/each}}
                <div class="dbu-combo-empty" hidden>No Talent has that in its name or Category.</div>
              </div>
            </div>
          {{else}}
            <input type="hidden" name="system.progression.{{row.index}}.talent" value="{{row.entry.talent}}"/>
          {{/if}}
        </td>


        <td>
          <span class="computed-value">{{row.entry.technique}}</span>
          <input type="hidden" name="system.progression.{{row.index}}.technique" value="{{row.entry.technique}}" data-dtype="Number"/>
        </td>


      </tr>
      {{/each}}
    </tbody>
  </table>

  {{! Character Perks from anywhere: the table's Choices without a Level - where each came from, written; its TP as written. }}
  <details class="trait-group perk-group" data-section="perks" {{#if openSections.perks}}open{{/if}}>
    <summary>
      Character Perks
      <span class="trait-count">{{characterPerks.length}}</span>
    </summary>
    <button type="button" class="edit-toggle perk-add" data-action="addPerk">+ Add Character Perk</button>
    {{#if characterPerks.length}}
    <table class="progression-table perk-table">
      <thead>
        <tr>
          <th></th>
          <th>Source</th>
          <th>Level</th>
          <th>Choice</th>
          <th>Benefits</th>
          <th>TP</th>
        </tr>
      </thead>
      <tbody>
        {{#each characterPerks as |perk|}}
        <tr class="{{#unless perk.reached}}unreached{{/unless}}">
          <td class="perk-remove">
            <button type="button" class="perk-x" data-action="removePerk" data-index="{{perk.index}}"
                    data-tooltip="Remove this Character Perk">&#10005;</button>
          </td>
          <td class="perk-source">
            <input type="text" name="system.characterPerks.{{perk.index}}.source" value="{{perk.entry.source}}"
                   placeholder="Where it came from" {{#if perk.entry.source}}data-tooltip="{{perk.entry.source}}"{{/if}}/>
          </td>
          <td class="perk-level">
            <input type="number" name="system.characterPerks.{{perk.index}}.lvl" value="{{perk.lvl}}" min="1" max="30" step="1"
                   data-dtype="Number" {{#unless perk.reached}}data-tooltip="Not reached yet: it counts once the character is Power Level {{perk.lvl}}"{{/unless}}/>
          </td>
          <td class="perk-choice">
            <select name="system.characterPerks.{{perk.index}}.choice" data-perk-choice>
              <option value="" {{#unless perk.entry.choice}}selected{{/unless}}>Choose&hellip;</option>
              <option value="Attribute Addition" {{#if (eq perk.entry.choice "Attribute Addition")}}selected{{/if}}>Attribute Addition</option>
              <option value="Skill Improvement" {{#if (eq perk.entry.choice "Skill Improvement")}}selected{{/if}}>Skill Improvement</option>
              <option value="Talent Addition" {{#if (eq perk.entry.choice "Talent Addition")}}selected{{/if}}>Talent Addition</option>
            </select>
          </td>
          <td class="benefit-cell" data-benefit-scope>
            {{#each perk.attributeFields as |field|}}
            <input type="hidden" name="{{field.name}}" value="{{field.value}}" data-dtype="Number" data-benefit-attribute="{{field.key}}"/>
            {{/each}}
            {{#each perk.skillRanks as |slot|}}
            <input type="hidden" name="{{slot.name}}" value="{{slot.value}}" data-benefit-skill/>
            {{/each}}
            {{#if perk.benefit}}
              <button type="button" class="benefit-pick{{#unless perk.benefit.label}} empty{{/unless}}" data-benefit="{{perk.benefit.kind}}"
                      data-benefit-data="{{perk.benefit.data}}">{{#if perk.benefit.label}}{{perk.benefit.label}}{{else}}Choose&hellip;{{/if}}{{#if perk.benefit.left}} <span class="benefit-left">({{perk.benefit.left}} left)</span>{{/if}}{{#if perk.benefit.over}} <span class="benefit-over">(over the cap)</span>{{/if}}</button>
            {{/if}}
            {{#if perk.isTalentAddition}}
            <div class="dbu-combo" data-combo>
              <input type="hidden" name="system.characterPerks.{{perk.index}}.talent" value="{{perk.entry.talent}}"/>
              <input type="text" class="dbu-combo-input" autocomplete="off" spellcheck="false" placeholder="Choose a Talent"
                     role="combobox" aria-expanded="false" aria-label="Talent"/>
              <span class="dbu-combo-caret" aria-hidden="true">&#9662;</span>
              <div class="dbu-combo-list" role="listbox" hidden>
                <div class="dbu-combo-option dbu-combo-none" role="option" data-value="">None</div>
                {{#each perk.talentGroups as |group|}}
                <div class="dbu-combo-group" data-group="{{group.label}}">{{group.label}}</div>
                {{#each group.options as |option|}}
                <div class="dbu-combo-option{{#if option.selected}} chosen{{/if}}" role="option" data-value="{{option.value}}"
                     data-group="{{group.label}}">{{option.label}}</div>
                {{/each}}
                {{/each}}
                <div class="dbu-combo-empty" hidden>No Talent has that in its name or Category.</div>
              </div>
            </div>
            {{else}}
            <input type="hidden" name="system.characterPerks.{{perk.index}}.talent" value="{{perk.entry.talent}}"/>
            {{/if}}
          </td>
          <td class="perk-tp">
            <input type="number" name="system.characterPerks.{{perk.index}}.technique" value="{{perk.entry.technique}}" min="0"
                   data-dtype="Number" data-perk-tp/>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="tab-placeholder">No Character Perks yet.</p>
    {{/if}}
  </details>

</div>

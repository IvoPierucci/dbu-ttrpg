<div class="tab {{tabs.options.cssClass}}" data-group="primary" data-tab="options">
  {{! A Racial Trait's Option effect: which printed effect asks for it, and the one chosen - changeable, its script and
      what it gives changing with it. Empty for a Trait with none. }}
  {{#if racial.optionGroups.length}}
  <section class="panel racial-options">
    {{#each racial.optionGroups as |group|}}
    {{#each group.selects as |pick|}}
    <label class="racial-option-row">
      <span>{{group.label}}</span>
      <select data-racial-option data-replacing="{{pick.replacing}}">
        {{#unless pick.replacing}}<option value="" selected>-</option>{{/unless}}
        {{#each pick.options as |option|}}
        <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
        {{/each}}
      </select>
    </label>
    {{/each}}
    {{/each}}
  </section>
  {{/if}}
  {{#if racial.tail}}
  <section class="panel racial-options">
    <label class="racial-option-row" data-tooltip="Lost to a Called Shot: not Tailed, or benefiting from it, until it regrows">
      <span>Tail lost</span>
      <input type="checkbox" data-tail-lost {{#if racial.tailLost}}checked{{/if}}/>
    </label>
  </section>
  {{/if}}
  {{#if racial.addendum}}
  {{! Its Addendum effect's text box, as written. }}
  <section class="panel racial-addendum">
    <h3 class="panel-title">{{racial.addendumTitle}}</h3>
    {{#each racial.addendum as |line|}}
    {{#if line.gap}}<div class="dbu-entry-break"></div>{{else}}
    <div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{line.text}}</div>{{/if}}
    {{/each}}
  </section>
  {{/if}}
</div>

<div class="tab {{tabs.ua.cssClass}}" data-group="primary" data-tab="ua">
  {{#if isUnique}}
  {{! What a Unique Ability is and costs, as its file says - read here, changed there (the user's ruling).
      Only three things are the character's: the type it counts as where it lists both, its TP Cost Change,
      and Free. Used as a Maneuver: "only once per Combat Round", paying its KP Cost and Action Cost. }}
  <section class="panel">
    <h3 class="panel-title">Unique Ability</h3>
    <div class="stat-grid">
      <div class="stat" data-tooltip="Technical: pure skill. Magical: it needs magic. Both: chosen when it is gained.">
        <em>Type</em>
        <span class="stat-read">{{unique.typeLabel}}</span>
      </div>
      {{#if unique.both}}
      <div class="stat" data-tooltip="Listed as both: the one it counts as.">
        <em>Counts as</em>
        <select name="system.unique.chosenType">
          <option value="" {{#unless system.unique.chosenType}}selected{{/unless}}>-</option>
          {{#each unique.chosen as |type|}}
          <option value="{{type.value}}" {{#if type.selected}}selected{{/if}}>{{type.label}}</option>
          {{/each}}
        </select>
      </div>
      {{/if}}
      <div class="stat" data-tooltip="Its listed TP Cost. Restrictions reduce it, never below half.">
        <em>TP Cost</em>
        <span class="stat-read">{{system.unique.tpCost}}</span>
      </div>
      <div class="stat" data-tooltip="Added to the TP Cost, or taken off it with a negative number - never below half the listed cost.">
        <em>TP Cost Change</em>
        <input type="number" name="system.unique.tpChange" value="{{system.unique.tpChange}}"/>
      </div>
      <div class="stat" data-tooltip="Its own TP Cost is not charged. Advancements bought onto it still are.">
        <em>Free</em>
        <input type="checkbox" name="system.unique.free" {{#if system.unique.free}}checked{{/if}}/>
      </div>
      <div class="stat stat-wide">
        <em>Prerequisite</em>
        <span class="stat-read">{{#if system.unique.prerequisite}}{{system.unique.prerequisite}}{{else}}N/A{{/if}}</span>
      </div>
    </div>
  </section>

  <section class="panel">
    <h3 class="panel-title">Costs <span class="panel-note">Once per Combat Round</span></h3>
    <div class="stat-grid">
      <div class="stat">
        <em>Maneuver Type</em>
        <span class="stat-read">{{unique.maneuverTypeLabel}}</span>
      </div>
      <div class="stat">
        <em>Action Cost</em>
        <span class="stat-read">{{unique.actionLabel}}</span>
      </div>
      <div class="stat" data-tooltip="At 4(T) or more it is never reduced below half.">
        <em>KP Cost</em>
        <span class="stat-read">{{unique.kpLabel}}</span>
      </div>
    </div>
  </section>
  {{/if}}
</div>

<div class="tab {{tabs.qualities.cssClass}}" data-group="primary" data-tab="qualities">
  <section class="panel">
    {{! The search stays on top; what is added goes under it. }}
    <div class="gear-add-quality">
      {{#if crafted.qualityChoices.length}}
      {{! A search, not a field of the Item: no name, so nothing typed is saved. }}
      <div class="gear-quality-search-row">
        <input type="text" class="gear-quality-search" data-quality-search autocomplete="off"
               placeholder="Type a Quality"/>
        <button type="button" class="dbu-clash-button" data-action="addQuality">Add</button>
      </div>
      <ol class="gear-quality-list" data-quality-list hidden>
        {{#each crafted.qualityGroups as |group|}}
        <li class="gear-quality-group" data-quality-group="{{group.label}}">{{group.label}}</li>
        {{#each group.choices as |choice|}}
        <li class="gear-quality-option" data-quality-option="{{choice.value}}"
            data-name="{{choice.name}}" data-group="{{group.label}}">{{choice.label}}</li>
        {{/each}}
        {{/each}}
        <li class="gear-quality-none" data-quality-none hidden>None starts with that.</li>
      </ol>
      {{else}}
      <p class="tab-placeholder">No Qualities to add for this Category yet.</p>
      {{/if}}
    </div>
    {{! What its Qualities do, all in one place: a block to each, a typed line to each effect. }}
    {{#if crafted.effects.length}}
    <div class="gear-effects">
      <h4 class="gear-effects-title">Effects</h4>
      {{#each crafted.effects as |block|}}
      <div class="gear-effect{{#if block.off}} off{{/if}}">
        <div class="gear-effect-name">{{block.name}}{{#if block.choiceLabel}} &middot; {{block.choiceLabel}}{{/if}}{{#if block.offNote}} <span class="gear-effect-off">({{block.offNote}})</span>{{/if}}</div>
        {{#each block.lines as |line|}}
        <div class="gear-effect-line">
          <span class="gear-effect-badge {{line.type}}">{{line.label}}</span>
          <span class="gear-effect-text">{{line.text}}</span>
        </div>
        {{/each}}
      </div>
      {{/each}}
    </div>
    {{/if}}
    {{#each crafted.qualities as |quality|}}
    <div class="gear-row">
      <span class="gear-name" data-tooltip="{{quality.tip}}">{{quality.name}}</span>
      {{#if quality.choiceLabel}}<span class="gear-type">{{quality.choiceLabel}}</span>{{/if}}
      <span class="gear-type">{{quality.slotsLabel}}</span>
      {{#if quality.toggle}}
      <label class="gear-type"><input type="checkbox" data-action="toggleQuality"
             data-index="{{quality.index}}" {{#if quality.on}}checked{{/if}}/> {{quality.toggle}}</label>
      {{/if}}
      {{#if quality.misfit}}<span class="gear-warning">{{quality.misfit}}</span>{{/if}}
      <button type="button" class="gear-remove" data-action="removeQuality"
              data-index="{{quality.index}}" data-tooltip="Remove">&times;</button>
    </div>
    {{else}}
    <p class="tab-placeholder">None.</p>
    {{/each}}
    {{#if crafted.overNote}}<p class="gear-insufficient" data-tooltip="{{crafted.overNote}}">Insufficient Quality Slots</p>{{/if}}
    {{#if crafted.specialNote}}<p class="gear-warning">{{crafted.specialNote}}</p>{{/if}}
  </section>
</div>

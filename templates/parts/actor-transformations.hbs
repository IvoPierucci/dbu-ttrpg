<div class="tab {{tabs.transformations.cssClass}}" data-group="primary" data-tab="transformations">

{{! The Transformations this character has (transformations.mjs) - the user's approved mockup, 2026-11-16: what is in use above,
    a section for each type they have one of, a row each that opens to its Grades, Aspects and Traits, and below the Traits of
    what is in use (and the Constant effects of what is not). Every field is written onto its Transformation Item
    (actor-character-sheet.mjs), never submitted with the character's form. }}
  {{#with transformationsTab as |tf|}}
  <section class="panel dbu-tf">
    <h3 class="panel-title">
      <span>Transformations</span>
      {{#if @root.editable}}
      <button type="button" class="edit-toggle" data-action="addTransformation" data-tooltip="Add a Transformation">Add</button>
      {{/if}}
    </h3>

    <div class="dbu-tf-bar">
      <span class="dbu-tf-dim">Active Aspects</span>
      {{#each tf.aspects as |aspect|}}
      <span class="dbu-tf-chip" data-tooltip="From {{aspect.from}}{{#if aspect.summary}}: {{aspect.summary}}{{/if}}">{{aspect.label}}</span>
      {{else}}
      <span class="dbu-tf-dim">none</span>
      {{/each}}
    </div>

    {{! The sections, and the Stress Bonus at the right of their row (the user's). }}
    <nav class="dbu-tf-sections">
      {{#each tf.sections as |section|}}
      <button type="button" class="dbu-tf-section{{#if section.active}} active{{/if}}" data-action="transformationSection"
              data-key="{{section.key}}">{{section.label}}<b>{{section.count}}</b></button>
      {{/each}}
      <span class="dbu-tf-chip dbu-tf-push" data-tooltip="Power Level + Determination">Stress Bonus {{tf.stressBonus}}</span>
    </nav>

    {{#if tf.sections.length}}

    {{#if tf.awakeningLimit}}
    {{! The Awakening Limit by base Tier of Power - said, never refused. }}
    <div class="dbu-tf-on dbu-tf-limit">
      <span class="dbu-tf-dim">Awakening Limit:</span>
      {{#if tf.awakeningLimit.none}}
      <span class="dbu-tf-chip">No Awakening Limit (Adversary)</span>
      {{else}}
      <span class="dbu-tf-chip{{#if tf.awakeningLimit.lesserOver}} warn{{/if}}">Lesser {{tf.awakeningLimit.lesser}} of {{tf.awakeningLimit.lesserMax}}</span>
      <span class="dbu-tf-chip{{#if tf.awakeningLimit.greaterOver}} warn{{/if}}">Greater {{tf.awakeningLimit.greater}} of {{tf.awakeningLimit.greaterMax}}</span>
      {{/if}}
    </div>
    {{/if}}
    <ul class="dbu-tf-list">
      {{#each tf.rows as |row|}}
      {{#if row.line}}
      <li class="dbu-tf-line">{{row.line}}{{#if row.race}} <span class="dbu-tf-dim">({{row.race}})</span>{{/if}}</li>
      {{else}}
      <li class="dbu-tf-row{{#if row.inUse}} in-use{{/if}}{{#if row.open}} maneuver-open{{/if}}" data-tf-id="{{row.id}}">
        <div class="dbu-tf-head maneuver-head">
          <input type="checkbox" data-tf-field="active" {{checked row.active}} {{#if row.fixed}}disabled{{/if}}
                 data-tooltip="{{#if row.fixed}}An Awakening is always in use{{else}}In use: its bonuses, Aspects and Traits - no Stress Test{{/if}}"/>
          <button type="button" class="dbu-tf-open" data-action="toggleTransformation" aria-label="Open">
            <span class="maneuver-mark" aria-hidden="true"></span></button>
          <span class="dbu-tf-name"{{#if row.gone}} data-tooltip="Its file is no longer in this system"{{/if}}>{{row.name}}</span>
          {{#each row.facts as |fact|}}<span class="dbu-tf-dim">{{fact}}</span>{{/each}}
          {{#if row.variant}}<span class="dbu-tf-chip">{{row.variant}}</span>{{/if}}
          {{#if row.racialUnmet}}<span class="dbu-tf-chip warn" data-tooltip="Its Racial Requirement: said, never refused">{{row.racialUnmet}}</span>{{/if}}
          {{#if row.prerequisite}}<span class="dbu-tf-chip warn" data-tooltip="Its Prerequisite: the table's to check">Prerequisite: {{row.prerequisite}}</span>{{/if}}
          <span class="dbu-tf-fields">
            {{#if row.transcendent}}
            <label class="dbu-tf-in"><input type="checkbox" data-tf-field="transcended" {{checked row.transcended}}/>Transcended</label>
            {{/if}}
            {{#if row.prelude}}
            <label class="dbu-tf-in" data-tooltip="Prelude: Tier of Power Requirement -1, Stress -3; its Attribute Modifier Bonuses -1(T) and its last Trait left out. Untick it while something raises your Tier of Power."><input type="checkbox" data-tf-field="prelude" {{checked row.inPrelude}}/>Prelude</label>
            {{/if}}
            {{#if row.grades}}
            <label class="dbu-tf-in" data-tooltip="{{row.gradeTip}}">Grade<input type="number" class="dbu-tf-n" data-tf-field="grade" min="1"
              max="{{row.grades}}" value="{{row.grade}}"/></label>
            {{/if}}
            {{#if row.awakening}}
            <label class="dbu-tf-in"{{#if row.stacksFixed}} data-tooltip="Its Characters' - Released below"{{/if}}>Stacks<input type="number" class="dbu-tf-n" data-tf-field="stacks" min="0" value="{{row.stacks}}" {{#if row.stacksFixed}}disabled{{/if}}/>
              <span class="dbu-tf-dim{{#if row.overStacks}} warn{{/if}}">of {{row.maxStacks}}</span></label>
            {{/if}}
            <span class="dbu-tf-dim">Tier {{row.tier}}</span>
            {{#if row.stress}}<span class="dbu-tf-dim">Stress {{row.stress}}</span>{{/if}}
            {{#if row.peaked}}<span class="dbu-tf-chip">Peaked</span>{{/if}}
            {{#if row.masteryMax}}
            <label class="dbu-tf-in" data-tooltip="Times Mastered (M) - the most shown is said, never refused">Mastery<input type="number"
              class="dbu-tf-n" data-tf-field="mastery" min="0" value="{{row.mastery}}"/><span class="dbu-tf-dim{{#if row.overMastery}} warn{{/if}}">of {{row.masteryMax}}</span></label>
            {{/if}}
            {{#if @root.editable}}
            <a class="dbu-tf-delete" data-action="removeTransformation" data-tooltip="Remove {{row.name}} - and its Traits"><i class="fa-solid fa-trash"></i></a>
            {{/if}}
          </span>
        </div>
        {{#if row.heartbeat}}{{#if @root.editable}}
        {{! Heartbeat: in it for a Maneuver's duration - entered and left from here. }}
        <div class="dbu-tf-on">
          {{#if row.heartbeat.on}}
          <span class="dbu-tf-chip ext">In it through Heartbeat</span>
          <button type="button" class="dbu-tf-small" data-action="endHeartbeat" data-tooltip="The Maneuver is over: leave it, back as you were">End Heartbeat</button>
          {{else}}
          <button type="button" class="dbu-tf-small" data-action="heartbeatTransformation" {{#if row.heartbeat.why}}disabled{{/if}}
            data-tooltip="{{#if row.heartbeat.why}}{{row.heartbeat.why}}{{else}}Enter it for the duration of a Maneuver you use or that targets you - no Stress Test, Legend Realized or Burst Limit{{/if}}">Heartbeat</button>
          {{/if}}
        </div>
        {{/if}}{{/if}}
        {{#if row.temporaryStacks}}
        {{! A Temporary Awakening: till the end of the Combat Encounter - a Level 1's the ARC may let stay. }}
        <div class="dbu-tf-on">
          <span class="dbu-tf-chip ext">Temporary Awakening, Level {{row.temporary}}: {{row.temporaryStacks}} of its Stacks</span>
          {{#if @root.editable}}
          <button type="button" class="dbu-tf-small" data-action="keepTemporaryAwakening" data-tooltip="The ARC lets it stay: no longer temporary">Keep</button>
          <button type="button" class="dbu-tf-small" data-action="endTemporaryAwakening" data-tooltip="Its temporary Stacks gone">End</button>
          {{/if}}
        </div>
        {{/if}}
        <div class="dbu-tf-bonuses">
          {{#each row.bonuses as |bonus|}}<span class="dbu-tf-bonus{{#if bonus.up}} up{{/if}}">{{bonus.label}} {{bonus.value}}</span>{{/each}}
        </div>
        <div class="dbu-tf-detail maneuver-body">
          {{#if row.gradeValues.length}}
          <div class="dbu-tf-part"><div class="dbu-tf-heading">Grade {{row.grade}}</div>
            <div class="dbu-tf-kv">{{#each row.gradeValues as |value|}}<span class="dbu-tf-dim">{{value}}</span>{{/each}}</div></div>
          {{/if}}
          {{#if row.owners}}
          {{! Each stack's Character - the Absorbed, the Merged: let go with Release (where they go is the table's). }}
          <div class="dbu-tf-part"><div class="dbu-tf-heading">Stacks, each with its Character</div>
            <div class="dbu-tf-chips">
              {{#each row.owners as |owner|}}<span class="dbu-tf-chip{{#if owner.temporary}} ext{{/if}}"{{#if owner.temporary}} data-tooltip="Temporary"{{/if}}>{{owner.name}}{{#if @root.editable}}
                <button type="button" class="dbu-tf-small" data-action="releaseTransformationOwner" data-uuid="{{owner.uuid}}">Release</button>{{/if}}</span>{{else}}<span class="dbu-tf-dim">none</span>{{/each}}
            </div></div>
          {{/if}}
          {{#if row.choices.length}}
          {{! What it asks to be chosen as it is gained - Monster Form's Attribute, Aspect, Saves, Growth, Rampaging. }}
          <div class="dbu-tf-part"><div class="dbu-tf-heading">Choices</div>
            <div class="dbu-tf-choices">
              {{#each row.choices as |choice|}}<label class="dbu-tf-in"><span>{{choice.label}}</span>
                <select data-tf-choice="{{choice.key}}" {{#unless @root.editable}}disabled{{/unless}}>
                  <option value="">Not chosen</option>
                  {{#each choice.options as |option|}}<option value="{{option.value}}" {{#if (eq option.value choice.chosen)}}selected{{/if}}>{{option.label}}</option>{{/each}}
                </select></label>{{/each}}
            </div></div>
          {{/if}}
          {{#if row.ownerChoice}}
          <div class="dbu-tf-part"><div class="dbu-tf-heading">Its Character</div>
            <select data-tf-owner {{#unless @root.editable}}disabled{{/unless}}>
              <option value="">None chosen</option>
              {{#each row.ownerChoice.options as |option|}}<option value="{{option.uuid}}" {{#if (eq option.uuid ../row.ownerChoice.chosen)}}selected{{/if}}>{{option.name}}</option>{{/each}}
            </select></div>
          {{/if}}
          {{#each row.groups as |group|}}
          {{! Traits of which some are chosen (the Trait's group): those chosen, taken away by their trash; one more picked from the list. }}
          <div class="dbu-tf-part"><div class="dbu-tf-heading">{{group.label}}: {{group.chosen.length}} of {{group.picks}}</div>
            <div class="dbu-tf-chips">
              {{#each group.chosen as |chosen|}}<span class="dbu-tf-chip active">{{chosen.name}}{{#if @root.editable}}
                <a class="dbu-tf-delete" data-action="toggleRacialTrait" data-item-id="{{chosen.itemId}}" data-tooltip="Remove {{chosen.name}}"><i class="fa-solid fa-trash"></i></a>{{/if}}</span>{{/each}}
              {{#if group.open}}{{#if @root.editable}}
              <select data-tf-group="{{group.group}}">
                <option value="">Choose one</option>
                {{#each group.offered as |offer|}}<option value="{{offer.id}}">{{offer.name}}{{#if offer.prerequisite}} ({{offer.prerequisite}}){{/if}}</option>{{/each}}
              </select>
              {{/if}}{{/if}}
            </div></div>
          {{/each}}
          {{#if row.aspects.length}}
          <div class="dbu-tf-part"><div class="dbu-tf-heading">Aspects</div>
            <div class="dbu-tf-chips">{{#each row.aspects as |aspect|}}<span class="dbu-tf-chip"{{#if aspect.summary}} data-tooltip="{{aspect.summary}}"{{/if}}>{{aspect.label}}</span>{{/each}}</div></div>
          {{/if}}
          <div class="dbu-tf-part"><div class="dbu-tf-heading">Traits</div>
            {{#each row.traits as |trait|}}
            <div class="dbu-tf-trait{{#if trait.off}} off{{/if}}">
              {{#if trait.note}}<div class="dbu-tf-trait-note">{{trait.note}}</div>{{/if}}
              {{#each trait.lines as |line|}}{{#if line.gap}}<div class="dbu-entry-break"></div>{{else}}<div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{{line.html}}}</div>{{/if}}{{/each}}
            </div>
            {{/each}}
          </div>
          {{#unless row.fixed}}
          <label class="dbu-tf-in"><input type="checkbox" data-tf-field="newLevel" {{checked row.newLevel}}/>New Level of Power</label>
          {{/unless}}
        </div>
      </li>
      {{/if}}
      {{/each}}
    </ul>
    {{else}}
    <p class="panel-note">No Transformations yet. Add one: the ARC gives access to them.</p>
    {{/if}}
  </section>

  <details class="trait-group" data-section="transformationTraits" {{#if @root.openSections.transformationTraits}}open{{/if}}>
    <summary>
      Transformation Traits
      <span class="trait-count">{{tf.traitCount}}</span>
    </summary>
    {{! Those of what is in use, by type (the user's): Awakenings, Enhancements, Forms - an Evolved Stage's among the Forms. }}
    {{#each tf.traitGroups as |group|}}
    <div class="dbu-tf-dim dbu-tf-subhead">{{group.label}}</div>
    <ul class="trait-list">
      {{#each group.entries as |entry|}}
      <li class="trait{{#if entry.open}} trait-open{{/if}}" data-item-id="{{entry.item.id}}">
        <div class="trait-head trait-fold" data-action="toggleTrait">
          <span class="maneuver-mark" aria-hidden="true"></span>
          <span class="trait-name">{{entry.item.name}}</span>
          <span class="trait-prereq">{{entry.from}}</span>
          {{#each entry.triggered as |trigger|}}
          <button type="button" class="trait-arm {{#if trigger.automatic}}active{{/if}}"
                  data-action="automateTrigger" data-effect-id="{{trigger.id}}"
                  data-tooltip="{{trigger.label}}{{#if trigger.limits}} - {{trigger.limits}}{{/if}}">
            {{#if trigger.automatic}}Automatic{{else}}Triggered{{/if}}
          </button>
          {{/each}}
          {{#if entry.changeable}}{{#if @root.editable}}
          <button type="button" class="trait-control" data-action="editItem" data-item-id="{{entry.item.id}}"
                  data-tooltip="Change what was chosen for it - its Option or choice, on its sheet">&#9998;</button>
          {{/if}}{{/if}}
        </div>
        <div class="trait-body">
          {{#each entry.lines as |line|}}{{#if line.gap}}<div class="dbu-entry-break"></div>{{else}}<div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{{line.html}}}</div>{{/if}}{{/each}}
          {{#if entry.maneuvers.length}}
          {{! Its own effects that are Maneuvers - the same Items as on the Maneuvers tab, as the Traits tab's lists draw them. }}
          <ul class="maneuver-list trait-maneuvers">
            {{#each entry.maneuvers as |maneuver|}}
            <li class="maneuver" data-item-id="{{maneuver.itemId}}" draggable="true">
              <div class="maneuver-head">
                <span class="maneuver-mark" aria-hidden="true"></span>
                <button type="button" class="maneuver-name rollable" data-action="useManeuver"
                        data-item-id="{{maneuver.itemId}}">{{maneuver.name}}</button>
                <span class="maneuver-uses">{{#if maneuver.usageLabel}}{{maneuver.usageLabel}}
                  ({{maneuver.usesLeft}} left){{/if}}</span>
                <span class="maneuver-cost">{{maneuver.actionLabel}}</span>
                <span class="maneuver-cost">{{maneuver.kiCost}} KP</span>
                <button type="button" class="maneuver-control" data-action="editItem"
                        data-item-id="{{maneuver.itemId}}"
                        data-tooltip="Edit this Maneuver: its name, its description, what it costs">&#9998;</button>
              </div>
            </li>
            {{/each}}
          </ul>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{/each}}
    {{#if tf.constant.length}}
    <div class="dbu-tf-dim dbu-tf-subhead">Outside their Transformation: only their Constant effects</div>
    <ul class="trait-list">
      {{#each tf.constant as |entry|}}
      <li class="trait{{#if entry.open}} trait-open{{/if}}" data-item-id="{{entry.item.id}}">
        <div class="trait-head trait-fold" data-action="toggleTrait">
          <span class="maneuver-mark" aria-hidden="true"></span>
          <span class="trait-name">{{entry.item.name}}</span>
          <span class="trait-prereq">{{entry.from}}, not in use</span>
          {{#each entry.triggered as |trigger|}}
          <button type="button" class="trait-arm {{#if trigger.automatic}}active{{/if}}"
                  data-action="automateTrigger" data-effect-id="{{trigger.id}}"
                  data-tooltip="{{trigger.label}}{{#if trigger.limits}} - {{trigger.limits}}{{/if}}">
            {{#if trigger.automatic}}Automatic{{else}}Triggered{{/if}}
          </button>
          {{/each}}
          {{#if entry.changeable}}{{#if @root.editable}}
          <button type="button" class="trait-control" data-action="editItem" data-item-id="{{entry.item.id}}"
                  data-tooltip="Change what was chosen for it - its Option or choice, on its sheet">&#9998;</button>
          {{/if}}{{/if}}
        </div>
        {{#each entry.constantLines as |line|}}<div class="dbu-tf-constant">{{{line}}}</div>{{/each}}
        <div class="trait-body">
          {{#each entry.lines as |line|}}{{#if line.gap}}<div class="dbu-entry-break"></div>{{else}}<div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{{line.html}}}</div>{{/if}}{{/each}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{/if}}
    {{#unless tf.traitCount}}<p class="panel-note">None in use.</p>{{/unless}}
  </details>
  {{/with}}
</div>

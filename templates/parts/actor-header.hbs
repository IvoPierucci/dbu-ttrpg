<header class="sheet-header flexrow">
  <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img"
       title="{{actor.name}}" height="100" width="100"/>

  <div class="header-fields flexcol">
    <input class="character-name" name="name" type="text" value="{{actor.name}}" placeholder="Character Name"/>

    {{! Everything here is read-only: these are chosen or derived in Progression. }}
    <div class="header-traits">
      <span class="header-field">
        <em>Race</em>
        <span class="computed-value">{{#if raceName}}{{raceName}}{{else}}&mdash;{{/if}}</span>
      </span>

      {{#if subraceName}}
      <span class="header-field">
        <em>Subrace</em>
        <span class="computed-value">{{subraceName}}</span>
      </span>
      {{/if}}

      <span class="header-field">
        <em>Level</em>
        <span class="computed-value">{{system.powerLevel}}</span>
      </span>

      <span class="header-field" data-tooltip="Base Tier of Power, from Power Level alone">
        <em>BToP</em>
        <span class="computed-value">{{system.baseTierOfPower}}</span>
      </span>

      <span class="header-field" data-tooltip="Current Tier of Power. Breakthrough caps it at BToP + 2.">
        <em>ToP</em>
        <span class="computed-value">{{system.tierOfPower}}</span>
      </span>
    </div>

    <div class="header-pools">
      <div class="resource-card resource-life">
        <label>Life Points</label>
        <div class="resource-values">
          <input type="number" name="system.life.value" value="{{system.life.value}}" min="0"/>
          <span class="resource-sep">/</span>
          <span class="computed-value">{{system.life.max}}</span>
        </div>
        <div class="meter"><div class="meter-fill" style="width: {{lifePercent}}%"></div></div>
      </div>

      <div class="resource-card resource-ki">
        <label>Ki Points</label>
        <div class="resource-values">
          <input type="number" name="system.ki.value" value="{{system.ki.value}}" min="0"/>
          <span class="resource-sep">/</span>
          <span class="computed-value">{{system.ki.max}}</span>
        </div>
        <div class="meter"><div class="meter-fill" style="width: {{kiPercent}}%"></div></div>
      </div>
    </div>
  </div>
</header>

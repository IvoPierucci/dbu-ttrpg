<div class="tab {{tabs.adventure.cssClass}}" data-group="primary" data-tab="adventure">

  {{! Everything that is time spent outside a Combat Encounter. What is always wanted stays open at
      the top; the rest folds away by subject, closed until opened (the user's ruling). }}
  <section class="panel adventure-standing">
    <h3 class="panel-title">Adventure</h3>

    <label class="bio-toggle"
           data-tooltip="Out of a Combat Encounter. Off when one starts, on again when it ends. A Buddy's Adventure Effect applies while it is on.">
      <input type="checkbox" name="system.adventuring" {{#if system.adventuring}}checked{{/if}}/>
      Adventuring
    </label>

    <div class="adventure-actions">
      <button type="button" class="adventure-travel" data-action="travel"
              data-tooltip="Moving to another location. Its time is the ARC's to declare. Medium Travel costs 1/10 of your Maximum Ki Points, Long 1/4 - doubled under 2 Ranks in Flight, none by Vehicle or with a Rest on the way.">
        Travel
      </button>
      <button type="button" class="adventure-travel" data-action="newAdventureSession"
              data-tooltip="A new Adventuring Session: every Adventuring Maneuver's Session Limit full again, and Pickpocket's attempts forgotten.">
        New Session
      </button>
    </div>
  </section>

  {{! "Each Adventuring Maneuver has a Time Cost" and a Session Limit. A click on the row opens its
      entry as printed - the Maneuvers tab's rows, and the same toggle; Use is its own button. }}
  <section class="panel">
    <details class="condition-group" data-section="adventure-maneuvers"
             {{#if openSections.adventure-maneuvers}}open{{/if}}>
      <summary class="panel-title">
        Adventuring Maneuvers
        <span class="panel-note">{{adventuringManeuvers.length}}</span>
      </summary>
      <ul class="maneuver-list adventuring-list">
        {{#each adventuringManeuvers as |maneuver|}}
        <li class="maneuver{{#if maneuver.exhausted}} maneuver-exhausted{{/if}}{{#if maneuver.open}} maneuver-open{{/if}}"
            data-item-id="adv-{{maneuver.id}}">
          <div class="maneuver-head" data-action="toggleManeuver">
            <span class="maneuver-mark" aria-hidden="true"></span>
            <span class="maneuver-name">{{maneuver.name}}</span>
            {{#if maneuver.buffed}}
            <button type="button" class="edit-toggle" data-action="cancelAdventuringBuff" data-maneuver="{{maneuver.id}}"
                    data-tooltip="End what it gave, if its time has passed.">Cancel buff</button>
            {{/if}}
            <span class="adventuring-time" data-tooltip="Time Cost">{{maneuver.timeCost}}</span>
            <span class="maneuver-uses" data-tooltip="Session Limit">{{#if maneuver.limit}}{{maneuver.left}}/{{maneuver.limit}} left{{else}}&infin;{{/if}}</span>
            <button type="button" class="edit-toggle" data-action="useAdventuring" data-maneuver="{{maneuver.id}}">Use</button>
          </div>
          <div class="maneuver-body">
            <div class="maneuver-entry">
              {{#each maneuver.lines as |line|}}
              {{#if line.gap}}
              <div class="dbu-entry-break"></div>
              {{else}}
              <div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{line.text}}</div>
              {{/if}}
              {{/each}}
            </div>
          </div>
        </li>
        {{/each}}
      </ul>
    </details>
  </section>

  {{! Cooking: Hunger, and what cooking does about it. The stage shows on the fold while closed. }}
  <section class="panel">
    <details class="condition-group" data-section="adventure-cooking"
             {{#if openSections.adventure-cooking}}open{{/if}}>
      <summary class="panel-title">
        Cooking
        <span class="panel-note">{{hungerNow}}</span>
      </summary>
      {{! "Hunger is a penalty that comes in three stages", given by the ARC. }}
      <div class="adventure-hunger">
        <span class="karma-label" data-tooltip="Given by your ARC when it seems narratively impactful.">Hunger</span>
        {{#each hungerStages as |entry|}}
        <button type="button" class="hunger-stage{{#if entry.active}} active{{/if}}" data-action="setHunger"
                data-stage="{{entry.stage}}" data-tooltip="{{entry.tip}}">{{entry.label}}</button>
        {{/each}}
      </div>
    </details>
  </section>

  {{! The other sub-rules of Adventure, filled in as each is built. }}
  {{#each adventureSubjects as |subject|}}
  <section class="panel">
    <details class="condition-group" data-section="adventure-{{subject.key}}"
             {{#if subject.open}}open{{/if}}>
      <summary class="panel-title">{{subject.label}}</summary>
      <p class="adventure-empty">Not built yet.</p>
    </details>
  </section>
  {{/each}}
</div>

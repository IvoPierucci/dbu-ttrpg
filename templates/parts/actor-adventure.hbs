<div class="tab {{tabs.adventure.cssClass}}" data-group="primary" data-tab="adventure">

  {{! Everything that is time spent outside a Combat Encounter. }}
  <section class="panel adventure-standing">
    <h3 class="panel-title">Adventure</h3>

    <label class="bio-toggle"
           data-tooltip="Out of a Combat Encounter. Off when one starts, on again when it ends. A Buddy's Adventure Effect applies while it is on.">
      <input type="checkbox" name="system.adventuring" {{#if system.adventuring}}checked{{/if}}/>
      Adventuring
    </label>

    <button type="button" class="adventure-travel" data-action="travel"
            data-tooltip="Moving to another location. Its time is the ARC's to declare. Medium Travel costs 1/10 of your Maximum Ki Points, Long 1/4 - doubled under 2 Ranks in Flight, none by Vehicle or with a Rest on the way.">
      Travel
    </button>
  </section>

  {{! "Each Adventuring Maneuver has a Time Cost" and a Session Limit. The whole entry is on the
      name's hover. }}
  <section class="panel">
    <h3 class="panel-title">
      Adventuring Maneuvers
      <button type="button" class="edit-toggle" data-action="newAdventureSession"
              data-tooltip="A new Adventuring Session: every Session Limit full again.">New Session</button>
    </h3>
    <ul class="adventuring-list">
      {{#each adventuringManeuvers as |maneuver|}}
      <li class="adventuring-row{{#if maneuver.exhausted}} maneuver-exhausted{{/if}}">
        <button type="button" class="maneuver-name rollable" data-action="useAdventuring"
                data-maneuver="{{maneuver.id}}" data-tooltip="{{maneuver.text}}">{{maneuver.name}}</button>
        {{#if maneuver.buffed}}
        <button type="button" class="edit-toggle" data-action="cancelAdventuringBuff" data-maneuver="{{maneuver.id}}"
                data-tooltip="End what it gave, if its time has passed.">Cancel buff</button>
        {{/if}}
        <span class="adventuring-time" data-tooltip="Time Cost">{{maneuver.timeCost}}</span>
        <span class="maneuver-uses" data-tooltip="Session Limit">{{#if maneuver.limit}}{{maneuver.left}}/{{maneuver.limit}} left{{else}}&infin;{{/if}}</span>
      </li>
      {{/each}}
    </ul>
  </section>
</div>

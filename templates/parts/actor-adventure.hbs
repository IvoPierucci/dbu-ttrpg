<div class="tab {{tabs.adventure.cssClass}}" data-group="primary" data-tab="adventure">

  {{! Everything that is time spent outside a Combat Encounter. What is always wanted stays open at
      the top; the rest folds away by subject, closed until opened (the user's ruling). }}
  <section class="panel adventure-standing">
    <h3 class="panel-title">Adventure</h3>

    <label class="bio-toggle"
           data-tooltip="Out of a Combat Encounter. Off when one starts, on again when it ends. A Buddy's Adventure Effect applies while it is on.">
      <input type="checkbox" name="system.adventuring" {{#if system.adventuring}}checked{{/if}}/>
      Adventuring
    </label>

    <div class="adventure-actions">
      <button type="button" class="adventure-travel" data-action="travel"
              data-tooltip="Moving to another location. Its time is the ARC's to declare. Medium Travel costs 1/10 of your Maximum Ki Points, Long 1/4 - doubled under 2 Ranks in Flight, none by Vehicle or with a Rest on the way.">
        Travel
      </button>
      <button type="button" class="adventure-travel" data-action="newAdventureSession"
              data-tooltip="A new Adventuring Session: every Adventuring Maneuver's Session Limit full again, and Pickpocket's attempts forgotten.">
        New Session
      </button>
    </div>
  </section>

  {{! "Each Adventuring Maneuver has a Time Cost" and a Session Limit. The Maneuvers tab's rows: the
      name uses it, and the arrow - or anywhere else on the row - opens its entry as printed. No Use
      button (the user's ruling). }}
  <section class="panel">
    <details class="condition-group" data-section="adventure-maneuvers"
             {{#if openSections.adventure-maneuvers}}open{{/if}}>
      <summary class="panel-title">
        Adventuring Maneuvers
        <span class="panel-note">{{adventuringManeuvers.length}}</span>
      </summary>
      <ul class="maneuver-list adventuring-list">
        {{#each adventuringManeuvers as |maneuver|}}
        <li class="maneuver{{#if maneuver.exhausted}} maneuver-exhausted{{/if}}{{#if maneuver.open}} maneuver-open{{/if}}"
            data-item-id="adv-{{maneuver.id}}">
          <div class="maneuver-head" data-action="toggleManeuver">
            <span class="maneuver-mark" aria-hidden="true"></span>
            <button type="button" class="maneuver-name rollable" data-action="useAdventuring"
                    data-maneuver="{{maneuver.id}}">{{maneuver.name}}</button>
            {{#if maneuver.buffed}}
            <button type="button" class="edit-toggle" data-action="cancelAdventuringBuff" data-maneuver="{{maneuver.id}}"
                    data-tooltip="End what it gave, if its time has passed.">Cancel buff</button>
            {{/if}}
            <span class="adventuring-time" data-tooltip="Time Cost">{{maneuver.timeCost}}</span>
            <span class="maneuver-uses" data-tooltip="Session Limit">{{#if maneuver.limit}}{{maneuver.left}}/{{maneuver.limit}} left{{else}}&infin;{{/if}}</span>
          </div>
          <div class="maneuver-body">
            <div class="maneuver-entry">
              {{#each maneuver.lines as |line|}}
              {{#if line.gap}}
              <div class="dbu-entry-break"></div>
              {{else}}
              <div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{line.text}}</div>
              {{/if}}
              {{/each}}
            </div>
          </div>
        </li>
        {{/each}}
      </ul>
    </details>
  </section>

  {{! Cooking: Hunger, and what cooking does about it. The stage shows on the fold while closed. }}
  <section class="panel">
    <details class="condition-group" data-section="adventure-cooking"
             {{#if openSections.adventure-cooking}}open{{/if}}>
      <summary class="panel-title">
        Cooking
        <span class="panel-note">{{hungerNow}}</span>
      </summary>
      {{! "Hunger is a penalty that comes in three stages", given by the ARC. }}
      <div class="adventure-hunger">
        <span class="karma-label" data-tooltip="Given by your ARC when it seems narratively impactful.">Hunger</span>
        {{#each hungerStages as |entry|}}
        <button type="button" class="hunger-stage{{#if entry.active}} active{{/if}}" data-action="setHunger"
                data-stage="{{entry.stage}}" data-tooltip="{{entry.tip}}">{{entry.label}}</button>
        {{/each}}
      </div>
    </details>
  </section>

  {{! The other sub-rules of Adventure, filled in as each is built. }}
  {{#each adventureSubjects as |subject|}}
  <section class="panel">
    <details class="condition-group" data-section="adventure-{{subject.key}}"
             {{#if subject.open}}open{{/if}}>
      <summary class="panel-title">
        {{subject.label}}
        {{#if subject.isReputation}}<span class="panel-note">{{@root.reputation.length}}</span>{{/if}}
        {{#if subject.isTraining}}<span class="panel-note">{{@root.trainingBonuses.length}}</span>{{/if}}
        {{#if subject.isWealth}}<span class="panel-note">{{@root.wealth.status.label}}</span>{{/if}}
      </summary>
      {{#if subject.isReputation}}
      {{! Factions and Individuals, each with its Affection and Alarm Rating (0~4) - an Individual under its
          Faction, since theirs supersedes it. What each value means is on its name's hover. }}
      <div class="adventure-actions">
        <button type="button" class="adventure-travel" data-action="addReputation" data-kind="faction">Create Faction</button>
        <button type="button" class="adventure-travel" data-action="addReputation" data-kind="individual">Add Individual</button>
      </div>
      <ul class="reputation-list">
        {{#each @root.reputation as |entry|}}
        <li class="reputation-row{{#if entry.member}} reputation-member{{/if}}">
          <span class="reputation-name" data-tooltip="{{entry.kindLabel}}">{{entry.name}}</span>
          <span class="reputation-rating">
            <span class="karma-label">Affection</span>
            <button type="button" class="karma-step" data-action="stepReputation" data-id="{{entry.id}}" data-which="affection" data-step="-1">&minus;</button>
            <span class="reputation-value" data-tooltip="{{entry.affectionTip}}">{{entry.affectionLabel}} ({{entry.affection}})</span>
            <button type="button" class="karma-step" data-action="stepReputation" data-id="{{entry.id}}" data-which="affection" data-step="1">+</button>
          </span>
          <span class="reputation-rating">
            <span class="karma-label">Alarm</span>
            <button type="button" class="karma-step" data-action="stepReputation" data-id="{{entry.id}}" data-which="alarm" data-step="-1">&minus;</button>
            <span class="reputation-value" data-tooltip="{{entry.alarmTip}}">{{entry.alarmLabel}} ({{entry.alarm}})</span>
            <button type="button" class="karma-step" data-action="stepReputation" data-id="{{entry.id}}" data-which="alarm" data-step="1">+</button>
          </span>
          <span class="reputation-tn" data-tooltip="The TN of Persuasion and of Intimidation Checks against them">TN {{entry.persuasionTN}} / {{entry.intimidationTN}}</span>
          <button type="button" class="maneuver-control" data-action="renameReputation" data-id="{{entry.id}}" data-tooltip="Rename">&#9998;</button>
          <button type="button" class="maneuver-control" data-action="deleteReputation" data-id="{{entry.id}}" data-tooltip="Remove">&#10005;</button>
        </li>
        {{/each}}
      </ul>
      {{else if subject.isWealth}}
      {{! Riches, set as the ARC says, and the Status they come to; Scam's day adds 1 while its mark is held. }}
      <div class="karma">
        <span class="karma-label" data-tooltip="Up to 10. Gaining or losing them is the ARC's to decide.">Riches</span>
        <button type="button" class="karma-step" data-action="stepRiches" data-step="-1">&minus;</button>
        <span class="karma-count">{{@root.wealth.total}}<span class="karma-max">/10</span></span>
        <button type="button" class="karma-step" data-action="stepRiches" data-step="1">+</button>
        {{#if @root.wealth.scammed}}<span class="reputation-tn" data-tooltip="Scam: increase your Riches by 1 for 1 day">+1 Scam</span>{{/if}}
      </div>
      <div class="karma">
        <span class="karma-label">Status</span>
        <span class="reputation-value" data-tooltip="{{@root.wealth.status.tip}}">{{@root.wealth.status.label}}</span>
      </div>
      <div class="adventure-actions">
        <button type="button" class="adventure-travel" data-action="wealthCheck"
                data-tooltip="A d10, increased by your Riches.">Wealth Check</button>
      </div>
      {{else if subject.isTraining}}
      {{! Training Bonuses: "temporary effects that grant heightened powers to players for a short period".
          A published one works by itself; the ARC's own is on its name's hover, for the table. }}
      <div class="adventure-actions">
        <button type="button" class="adventure-travel" data-action="gainTrainingBonus">Gain Training Bonus</button>
      </div>
      <ul class="reputation-list">
        {{#each @root.trainingBonuses as |bonus|}}
        <li class="reputation-row">
          <span class="reputation-name" data-tooltip="{{bonus.tip}}">{{bonus.name}}</span>
          {{#if bonus.length}}<span class="reputation-tn">{{bonus.length}}</span>{{/if}}
          <button type="button" class="edit-toggle" data-action="endTrainingBonus" data-id="{{bonus.id}}"
                  data-tooltip="Its time has elapsed, or its battle is over.">End</button>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="adventure-empty">Not built yet.</p>
      {{/if}}
    </details>
  </section>
  {{/each}}
</div>

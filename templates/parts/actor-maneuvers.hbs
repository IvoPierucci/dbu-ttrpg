<div class="tab {{tabs.maneuvers.cssClass}}" data-group="primary" data-tab="maneuvers">

{{! Its own tab rather than the bottom of the Combat one. Four lists of rows that each
    open to a published entry is most of a page by itself, and it was the part of the
    Combat tab a player scrolled past everything else to reach. }}
  {{! A tab for each type (the user's): Standard, Counter, Instant, Out-of-Sequence, Modifier - the last one opened kept - and rows as
      the Allies' and Minions' lists are; Manage hides the ones not used, without taking them away. Each row is still the Maneuver's
      Item: dragged to the hotbar, renamed through its sheet. }}
  <section class="panel">
    <h3 class="panel-title">
      Maneuvers
      <button type="button" class="edit-toggle" data-action="grantManeuvers"
              data-tooltip="Give this character any core Maneuver they are missing. New characters get them automatically.">
        Add core maneuvers
      </button>
      {{#if editable}}
      <button type="button" class="edit-toggle" data-action="openCombatWindow" data-window="maneuvers"
              data-tooltip="Hide the Maneuvers of this tab you do not use - they stay yours">Manage</button>
      {{/if}}
    </h3>
    <div class="dbu-maneuver-tabs">
      {{#each maneuverGroups as |group|}}
      <button type="button" class="dbu-maneuver-tab{{#if group.active}} active{{/if}}" data-action="maneuverTab" data-key="{{group.key}}">
        {{group.label}}<b>{{group.count}}</b>
      </button>
      {{/each}}
    </div>
    {{#each maneuverGroups as |group|}}
    {{#if group.active}}
    <div class="maneuver-group dbu-maneuver-pane" data-section="maneuvers-{{group.key}}">
      {{#if group.note}}<p class="dbu-maneuver-note">{{group.note}}</p>{{/if}}

      <ul class="maneuver-list dbu-clist">
        {{#each group.maneuvers as |maneuver|}}
        {{! Draggable so it can be dropped on the hotbar, where it becomes a macro that
            uses it - the same call this row's own button makes. }}
        <li class="maneuver {{#if maneuver.exhausted}}maneuver-exhausted{{/if}}{{#if maneuver.unaffordable}} maneuver-unaffordable{{/if}}{{#if maneuver.open}} maneuver-open{{/if}}"
            data-item-id="{{maneuver.itemId}}" draggable="true">

          {{! The whole row opens it, bar the two things on it that do something else.
              ApplicationV2 dispatches a click to the nearest [data-action], so the name
              and the pencil keep their own and nothing here has to ask what was
              clicked. }}
          <div class="maneuver-head" data-action="toggleManeuver">
            <span class="maneuver-mark" aria-hidden="true"></span>
            {{#if maneuver.img}}<img class="dbu-maneuver-img" src="{{maneuver.img}}" alt=""/>{{/if}}

            {{#if maneuver.playable}}
            {{! Not disabled when it cannot be played: the click is refused by name where
                the rule lives, which says which rule, and a disabled button says
                nothing at all. }}
            <button type="button" class="maneuver-name rollable" data-action="useManeuver"
                    data-item-id="{{maneuver.itemId}}">{{maneuver.name}}</button>
            {{#if maneuver.asInstant}}
            <button type="button" class="maneuver-control" data-action="basicAttackInstant"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Multiple Arms: as an Instant Maneuver, for 2 Counter Actions (1/Round)">Instant</button>
            {{/if}}
            {{#if maneuver.signatureInstant}}
            <button type="button" class="maneuver-control" data-action="signatureInstant"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Furious Onslaught: as an Instant Maneuver, for 2 stacks of Overwhelm (1/Round)">Instant</button>
            {{/if}}
            {{#if maneuver.spiritInstant}}
            <button type="button" class="maneuver-control" data-action="spiritInstant"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="People of the Spirit: as an Instant Maneuver, as if 3 Actions were spent - a Surge for the one Empowered (1/Encounter)">Instant</button>
            {{/if}}
            {{#if maneuver.hateInstant}}
            <button type="button" class="maneuver-control" data-action="hateInstant"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Hate Empowerment: as an Instant Maneuver at your Inferior, for 2 Revenge Points (1/Round)">Instant</button>
            {{/if}}
            {{#if maneuver.thiefInstant}}
            <button type="button" class="maneuver-control" data-action="thiefInstant"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Thief: a Thief Maneuver as an Instant Maneuver (1/Round)">Instant</button>
            {{/if}}
            {{#if maneuver.desperateSupport}}
            <button type="button" class="maneuver-control" data-action="desperateSupport"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Desperate Support: Defeated - the Empower (as if 2 Actions) or one of its third effect's, as an Instant Maneuver (1/Encounter)">Desperate</button>
            {{/if}}
            {{#if maneuver.desperateInstant}}
            <button type="button" class="maneuver-control" data-action="desperateInstant"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Desperate Distraction: as an Instant Maneuver, below Injured (1/Round)">Instant</button>
            {{/if}}
            {{#if maneuver.soarInstant}}
            <button type="button" class="maneuver-control" data-action="soarInstant"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Frequent Flyer: as an Instant Maneuver (1/Round)">Instant</button>
            {{/if}}
            {{#if maneuver.heranInstant}}
            <button type="button" class="maneuver-control" data-action="heranInstant"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Heran Genes: as an Instant Maneuver, below Injured (1/Round)">Instant</button>
            {{/if}}
            {{#if maneuver.flipInstant}}
            <button type="button" class="maneuver-control" data-action="flipInstant"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Acrobat Star: as an Instant Maneuver">Instant</button>
            {{/if}}
            {{#if maneuver.burrowInstant}}
            <button type="button" class="maneuver-control" data-action="burrowInstant"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="As an Instant Maneuver - Burrowing Beast in Cover, Underwater Beast Underwater (1/Round each)">Instant</button>
            {{/if}}
            {{#if maneuver.majinOutOfSequence}}
            <button type="button" class="maneuver-control" data-action="majinOutOfSequence"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Genetic Focus: Majins: out of sequence, after its Healing Surge">Out of Sequence</button>
            {{/if}}
            {{#if maneuver.wingedOutOfSequence}}
            <button type="button" class="maneuver-control" data-action="wingedOutOfSequence"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Winged Beast: out of sequence, right after the Soar (1/Round)">Out of Sequence</button>
            {{/if}}
            {{#if maneuver.glassInstant}}
            <button type="button" class="maneuver-control" data-action="glassInstant"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Glass Combat: as an Instant Maneuver, during your turn on a Glass Square - ending on one (1/Round)">Instant</button>
            {{/if}}
            {{#if maneuver.creativeOutOfSequence}}
            <button type="button" class="maneuver-control" data-action="creativeOutOfSequence"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Demonic Creativity: out of sequence, as an Instant Maneuver, for 2 stacks of Demonic Power (1/Round)">OOS</button>
            {{/if}}
            {{else}}
            {{! Reactive: it is played from the message of the attack it answers. }}
            <span class="maneuver-name maneuver-triggered">{{maneuver.name}}</span>
            {{/if}}

            {{! Drawn on every row, empty where there is no limit: it is the column the
                names end against, so one that came and went would take them with it. }}
            <span class="maneuver-uses">{{#if maneuver.usageLabel}}<span class="dbu-mchip{{#if maneuver.noUsesLeft}} out{{else}} uses{{/if}}">{{maneuver.usageLabel}}
              &middot; {{maneuver.usesLeft}} left</span>{{/if}}</span>
            <span class="maneuver-source">{{maneuver.source}}</span>
            <span class="maneuver-cost dbu-mchip">{{maneuver.actionLabel}}</span>
            <span class="maneuver-cost dbu-mchip">{{maneuver.kiCost}} KP</span>

            {{! A Maneuver is an Item, so its name, its description and what it costs are
                all the player's to change - the same pencil a Talent has. }}
            <button type="button" class="maneuver-control" data-action="editItem"
                    data-item-id="{{maneuver.itemId}}"
                    data-tooltip="Edit this Maneuver: its name, its description, what it costs">&#9998;</button>
          </div>

          <div class="maneuver-body">
            {{#if maneuver.description}}
            {{! This character's own, as they wrote it. HTML, since the pencil edits it
                through Foundry's own editor - so it is rendered, not escaped. }}
            <div class="maneuver-description">{{{maneuver.description}}}</div>
            {{/if}}

            {{#if maneuver.lines}}
            {{! The published entry, laid out as the rulebook prints it: the stat lines
                open with an en dash and the options with a bullet, both of which are
                the text's own. }}
            <div class="maneuver-entry">
              {{#each maneuver.lines as |line|}}
              {{#if line.gap}}
              <div class="dbu-entry-break"></div>
              {{else}}
              <div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{line.text}}</div>
              {{/if}}
              {{/each}}
            </div>
            {{/if}}

            {{#if maneuver.empty}}
            <p class="maneuver-nothing">Nothing written for this one yet. The pencil opens it.</p>
            {{/if}}

            {{#each maneuver.notes as |note|}}
            <div class="dbu-profile-note">{{note}}</div>
            {{/each}}
          </div>
        </li>
        {{else}}
        <li class="dbu-clist-empty">{{#if group.hidden}}All hidden - Manage shows them again.{{else}}None of this type.{{/if}}</li>
        {{/each}}
      </ul>
      {{#if group.hidden}}<p class="dbu-maneuver-note">{{group.hidden}} hidden - Manage shows them again.</p>{{/if}}
    </div>
    {{/if}}
    {{/each}}
  </section>

  {{#if combatWindow.maneuvers}}
  <div class="dbu-combat-overlay">
    <div class="dbu-combat-window" role="dialog" aria-modal="true">
      <header><h3>Manage &middot; {{maneuverManage.label}}</h3></header>
      <p class="dbu-manage-note">Ticked: shown on the list. Unticked: hidden here only - still yours, still on your hotbar, still offered where it applies.</p>
      <div class="dbu-combat-window-body dbu-picks">
        {{#each maneuverManage.picks as |pick|}}
        <label class="dbu-pick{{#if pick.shown}} on{{/if}}">
          <input type="checkbox" data-action="pickManeuver" data-id="{{pick.itemId}}" {{#if pick.shown}}checked{{/if}}
                 {{#unless @root.editable}}disabled{{/unless}}/>
          {{#if pick.img}}<img class="ally-img" src="{{pick.img}}" alt=""/>{{/if}}
          {{pick.name}}
        </label>
        {{else}}
        <p class="dbu-clist-empty">None of this type.</p>
        {{/each}}
      </div>
      <footer>
        <button type="button" class="dbu-manage" data-action="showAllManeuvers" {{#unless editable}}disabled{{/unless}}>Show all</button>
        <button type="button" class="dbu-manage" data-action="closeCombatWindow">Close</button>
      </footer>
    </div>
  </div>
  {{/if}}

</div>

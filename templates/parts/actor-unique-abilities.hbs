<div class="tab {{tabs.uniqueAbilities.cssClass}}" data-group="primary" data-tab="uniqueAbilities">
  {{! The Unique Abilities this character has: each a Maneuver, once per Combat Round, bought with the same
      Technique Points as the Signature Techniques. Only ever added from the game's files - traits/unique/ - and
      never made here (the user's ruling). }}
  <section class="panel">
    <h3 class="panel-title">
      Unique Abilities
      <button type="button" class="edit-toggle" data-action="addUniqueAbility"
              data-tooltip="A published Unique Ability: its type and Restrictions asked">Add Unique Ability</button>
    </h3>

    <div class="technique-summary">
      <span data-tooltip="TP on Unique Abilities, and on them and the Signature Techniques together, against the TP Progression has given">
        TP <b>{{uniqueAbilities.spent}}</b> &middot; with Techniques <b>{{uniqueAbilities.together}}</b> / {{uniqueAbilities.available}}</span>
    </div>
    {{#if uniqueAbilities.warning}}<p class="gear-warning">{{uniqueAbilities.warning}}</p>{{/if}}

    <ul class="maneuver-list technique-list">
      {{#each uniqueAbilities.rows as |row|}}
      <li class="maneuver{{#if row.open}} maneuver-open{{/if}}" data-item-id="{{row.itemId}}" {{#unless row.grantedBy}}draggable="true"{{/unless}}>
        <div class="maneuver-head" data-action="toggleManeuver">
          <span class="maneuver-mark" aria-hidden="true"></span>
          {{#if row.usesGranted}}
          <button type="button" class="maneuver-name rollable" data-action="useGrantedUnique" data-unique-id="{{row.libraryId}}"
                  data-tooltip="Given by {{row.grantedBy}}, while it is Active">{{row.name}}</button>
          {{else if row.playable}}
          <button type="button" class="maneuver-name rollable" data-action="useManeuver" data-item-id="{{row.itemId}}">{{row.name}}</button>
          {{else}}
          {{! A Counter: played from Respond on the card of the attack aimed at you. }}
          <span class="maneuver-name maneuver-triggered" data-tooltip="A {{row.maneuverType}} Maneuver: played from {{row.playedFrom}}">{{row.name}}</span>
          {{/if}}
          <span class="maneuver-uses">{{row.type}} &middot; {{row.maneuverType}}</span>
          {{#if row.applied}}
          <button type="button" class="maneuver-cost unique-applied" data-action="stopUnique" data-item-id="{{row.itemId}}"
                  data-tooltip="{{#if row.held}}Holds {{row.held}}. Click to release them (Instant){{else}}{{#if row.area}}{{row.area}} Sphere. {{/if}}Click to stop it{{/if}}">Applied</button>
          {{/if}}
          <span class="maneuver-cost">{{row.actions}}</span>
          <span class="maneuver-cost">{{row.kp}} KP</span>
          {{#if row.grantedBy}}
          <span class="maneuver-cost">{{row.grantedBy}}</span>
          {{else}}
          <span class="maneuver-cost">{{row.tp}} TP</span>
          <button type="button" class="maneuver-control" data-action="editItem" data-item-id="{{row.itemId}}"
                  data-tooltip="Edit this Unique Ability">&#9998;</button>
          <button type="button" class="maneuver-control" data-action="deleteTechnique" data-item-id="{{row.itemId}}"
                  data-tooltip="Delete this Unique Ability">&#10005;</button>
          {{/if}}
        </div>
        <div class="maneuver-body">
          {{! The entry as printed - its own Prerequisites line among the rest. }}
          {{#each row.lines as |line|}}
          {{#if line.gap}}<div class="dbu-entry-break"></div>{{else}}
          <div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{line.text}}</div>{{/if}}
          {{/each}}
          {{#each row.advancements as |feature|}}
          <div class="dbu-profile-line technique-advantage" {{#if feature.tip}}data-tooltip="{{feature.tip}}"{{/if}}>{{feature.label}}</div>
          {{/each}}
          {{#each row.restrictions as |feature|}}
          <div class="dbu-profile-line technique-disadvantage" {{#if feature.tip}}data-tooltip="{{feature.tip}}"{{/if}}>{{feature.label}}</div>
          {{/each}}
          {{#if row.barrierClash}}
          <div class="unique-resource">
            <button type="button" class="dbu-clash-button" data-action="barrierClash" data-item-id="{{row.itemId}}"
                    data-tooltip="Powerful Barrier: against the attacking Character you target, 1(T) off for each Energy Charge">Might Clash</button>
          </div>
          {{/if}}
          {{#if row.resource}}
          <div class="unique-resource">
            <span>{{row.resource.label}}</span>
            <b>{{row.resource.stacks}}{{#if row.resource.max}}/{{row.resource.max}}{{/if}}</b>
            <button type="button" class="stack-step" data-action="stepResource" data-resource="{{row.resource.key}}" data-step="-1"
                    data-tooltip="A stack off">&minus;</button>
            <button type="button" class="stack-step" data-action="stepResource" data-resource="{{row.resource.key}}" data-step="1"
                    data-tooltip="A stack on">+</button>
          </div>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
  </section>
</div>

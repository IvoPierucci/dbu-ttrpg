<div class="tab {{tabs.traits.cssClass}}" data-group="primary" data-tab="traits">

  {{! An Adversary's Villainous Traits (the user's): a list of their own above the Racial Traits - the page's examples and the
      ARC's own. One switched off is had and does nothing - by hand, or by a Weakpoint hit. }}
  {{#if isAdversary}}
  <details class="trait-group" data-section="villainousTraits"
           {{#if openSections.villainousTraits}}open{{/if}}>
    <summary>
      Villainous Traits
      <span class="trait-count{{#if villainousOf.over}} dbu-adversary-over{{/if}}"
            data-tooltip="Its Category gives {{villainousOf.allowed}} - said, never held to">{{villainousOf.have}} / {{villainousOf.allowed}}</span>
      <button type="button" class="edit-toggle" data-action="addVillainousTrait"
              data-tooltip="One of the page's examples, or one of your own: a name and its text">Add Villainous Trait</button>
    </summary>
    {{#if villainousTraits.length}}
    <ul class="trait-list">
      {{#each villainousTraits as |entry|}}
      <li class="trait{{#if entry.open}} trait-open{{/if}}{{#if entry.off}} dbu-villainous-off{{/if}}" data-item-id="{{entry.item.id}}">
        <div class="trait-head trait-fold" data-action="toggleTrait">
          <span class="maneuver-mark" aria-hidden="true"></span>
          <img class="trait-img" src="{{entry.item.img}}" height="20" width="20"/>
          <span class="trait-name">{{entry.item.name}}</span>
          <span class="trait-prereq">{{#if entry.custom}}Your own{{else}}Villainous{{/if}}</span>
          {{#each entry.triggered as |trigger|}}
          <button type="button" class="trait-arm {{#if trigger.automatic}}active{{/if}}"
                  data-action="automateTrigger" data-effect-id="{{trigger.id}}"
                  data-tooltip="{{trigger.label}}{{#if trigger.limits}} - {{trigger.limits}}{{/if}}">
            {{#if trigger.automatic}}Automatic{{else}}Triggered{{/if}}
          </button>
          {{/each}}
          <button type="button" class="trait-arm{{#unless entry.off}} active{{/unless}}" data-action="toggleVillainous" data-item-id="{{entry.item.id}}"
                  data-tooltip="{{#if entry.off}}Off: had, and doing nothing. Click to switch it on{{else}}On. Click to switch it off{{/if}}">{{#if entry.off}}Off{{else}}On{{/if}}</button>
          <button type="button" class="trait-control" data-action="editItem" data-item-id="{{entry.item.id}}"
                  data-tooltip="Edit this Villainous Trait - its text, and what it does on this Adversary">&#9998;</button>
          <button type="button" class="trait-control" data-action="toggleRacialTrait" data-item-id="{{entry.item.id}}"
                  data-tooltip="Remove this Villainous Trait">&times;</button>
        </div>
        <div class="trait-body">
          {{#each entry.lines as |line|}}
          {{#if line.gap}}<div class="dbu-entry-break"></div>{{else}}
          <div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{{line.html}}}</div>{{/if}}
          {{/each}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="tab-placeholder">No Villainous Traits yet.</p>
    {{/if}}
  </details>
  {{/if}}

  {{! Racial Traits come with the race (race-traits.mjs; the user's, 2026-11-27); a race Trait is exchanged for a Factor Trait from its row.
      Add Racial Trait only where Debug shows it. }}
  <details class="trait-group" data-section="racialTraits"
           {{#if openSections.racialTraits}}open{{/if}}>
    <summary>
      Racial Traits
      <span class="trait-count">{{racialTraits.length}}</span>
      {{#if system.debug.showAddRacialTrait}}
      <button type="button" class="edit-toggle" data-action="addRacialTrait"
              data-tooltip="Your race's first, then every other race's">Add Racial Trait</button>
      {{/if}}
    </summary>

    {{#if racialTraits.length}}
    {{! The bordered list it always had; a click on a Trait unfolds it to its text and what was chosen for it. }}
    <ul class="trait-list">
      {{#each racialTraits as |entry|}}
      <li class="trait{{#if entry.open}} trait-open{{/if}}" data-item-id="{{entry.item.id}}">
        <div class="trait-head trait-fold" data-action="toggleTrait">
          <span class="maneuver-mark" aria-hidden="true"></span>
          <img class="trait-img" src="{{entry.item.img}}" height="20" width="20"/>
          <span class="trait-name">{{entry.item.name}}</span>
          <span class="trait-prereq"{{#if entry.factorTip}} data-tooltip="{{entry.factorTip}}"{{/if}}>{{entry.race}}{{#if entry.kind}} &middot; {{entry.kind}}{{/if}}</span>
          {{#if entry.wereMark}}
          {{! Were-Beast: a Were-Trait applies only in a Round it was chosen for; the Normal Trait not in one. }}
          <span class="trait-arm{{#unless entry.wereAside}} active{{/unless}}" data-tooltip="{{entry.wereTip}}">{{entry.wereMark}}{{#if entry.wereAside}} - {{entry.wereOff}}{{/if}}</span>
          {{/if}}
          {{#each entry.triggered as |trigger|}}
          {{! Triggered: offered where its moment is, to take or leave. Automatic: it answers that moment by itself, every time. }}
          <button type="button" class="trait-arm {{#if trigger.automatic}}active{{/if}}"
                  data-action="automateTrigger" data-effect-id="{{trigger.id}}"
                  data-tooltip="{{trigger.label}}{{#if trigger.limits}} - {{trigger.limits}}{{/if}}">
            {{#if trigger.automatic}}Automatic{{else}}Triggered{{/if}}
          </button>
          {{/each}}
          <button type="button" class="trait-control" data-action="editItem" data-item-id="{{entry.item.id}}"
                  data-tooltip="Edit this Racial Trait - its Effect is what it does on this character">&#9998;</button>
          {{#if entry.exchange}}
          <button type="button" class="trait-control trait-exchange" data-action="exchangeRacialTrait" data-item-id="{{entry.item.id}}"
                  data-tooltip="{{entry.exchange}}"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i></button>
          {{else if entry.removable}}
          <button type="button" class="trait-control" data-action="toggleRacialTrait" data-item-id="{{entry.item.id}}"
                  data-tooltip="Remove this Racial Trait">&times;</button>
          {{/if}}
        </div>
        <div class="trait-body">
          {{#each entry.lines as |line|}}
          {{#if line.addendum}}<details class="dbu-addendum"><summary>{{line.addendum.title}}</summary>{{#each line.addendum.lines as |part|}}{{#if part.gap}}<div class="dbu-entry-break"></div>{{else}}<div class="dbu-profile-line{{#if part.bullet}} dbu-profile-bullet{{/if}}">{{{part.html}}}</div>{{/if}}{{/each}}</details>
          {{else if line.gap}}<div class="dbu-entry-break"></div>{{else}}
          <div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{{line.html}}}</div>{{/if}}
          {{/each}}
          {{#each entry.chosenLines as |chosen|}}
          <div class="dbu-profile-line technique-advantage" data-tooltip="Chosen when it was added">{{chosen}}</div>
          {{/each}}
          {{#if entry.maneuvers.length}}
          {{! Its own effects that are Maneuvers - the same Items as on the Maneuvers tab: used from here, dragged to the hotbar. }}
          <ul class="maneuver-list trait-maneuvers">
            {{#each entry.maneuvers as |maneuver|}}
            <li class="maneuver" data-item-id="{{maneuver.itemId}}" draggable="true">
              <div class="maneuver-head">
                <span class="maneuver-mark" aria-hidden="true"></span>
                <button type="button" class="maneuver-name rollable" data-action="useManeuver"
                        data-item-id="{{maneuver.itemId}}">{{maneuver.name}}</button>
                <span class="maneuver-uses">{{#if maneuver.usageLabel}}{{maneuver.usageLabel}}
                  &middot; {{maneuver.usesLeft}} left{{/if}}</span>
                <span class="maneuver-cost">{{maneuver.actionLabel}}</span>
                <span class="maneuver-cost">{{maneuver.kiCost}} KP</span>
                <button type="button" class="maneuver-control" data-action="editItem"
                        data-item-id="{{maneuver.itemId}}"
                        data-tooltip="Edit this Maneuver: its name, its description, what it costs">&#9998;</button>
              </div>
            </li>
            {{/each}}
          </ul>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="tab-placeholder">No Racial Traits yet.</p>
    {{/if}}
  </details>

  {{! Other Traits - Evolution, Bestial, Monstrous - their own list, added and removed as Racial Traits are (the user's). }}
  <details class="trait-group" data-section="otherTraits"
           {{#if openSections.otherTraits}}open{{/if}}>
    <summary>
      Other Traits
      <span class="trait-count">{{otherTraits.length}}</span>
      <button type="button" class="edit-toggle" data-action="addOtherTrait"
              data-tooltip="Evolution, Bestial and Monstrous Traits">Add Other Trait</button>
    </summary>

    {{#if otherTraits.length}}
    {{! The bordered list it always had; a click on a Trait unfolds it to its text and what was chosen for it. }}
    <ul class="trait-list">
      {{#each otherTraits as |entry|}}
      <li class="trait{{#if entry.open}} trait-open{{/if}}" data-item-id="{{entry.item.id}}">
        <div class="trait-head trait-fold" data-action="toggleTrait">
          <span class="maneuver-mark" aria-hidden="true"></span>
          <img class="trait-img" src="{{entry.item.img}}" height="20" width="20"/>
          <span class="trait-name">{{entry.item.name}}</span>
          <span class="trait-prereq"{{#if entry.factorTip}} data-tooltip="{{entry.factorTip}}"{{/if}}>{{entry.race}}{{#if entry.kind}} &middot; {{entry.kind}}{{/if}}</span>
          {{#if entry.wereMark}}
          {{! Were-Beast: a Were-Trait applies only in a Round it was chosen for; the Normal Trait not in one. }}
          <span class="trait-arm{{#unless entry.wereAside}} active{{/unless}}" data-tooltip="{{entry.wereTip}}">{{entry.wereMark}}{{#if entry.wereAside}} - {{entry.wereOff}}{{/if}}</span>
          {{/if}}
          {{#if entry.bestialOff}}
          {{! The Bestial Limit: 4 at most apply - this one set aside while the one it gave way to is held. }}
          <button type="button" class="trait-arm" data-action="bestialApply" data-item-id="{{entry.item.id}}"
                  data-tooltip="Bestial Limit: not applied while you have {{entry.bestialOffFor}}. Click to apply it - another stops in its place">Not applied</button>
          {{/if}}
          {{#each entry.triggered as |trigger|}}
          {{! Triggered: offered where its moment is, to take or leave. Automatic: it answers that moment by itself, every time. }}
          <button type="button" class="trait-arm {{#if trigger.automatic}}active{{/if}}"
                  data-action="automateTrigger" data-effect-id="{{trigger.id}}"
                  data-tooltip="{{trigger.label}}{{#if trigger.limits}} - {{trigger.limits}}{{/if}}">
            {{#if trigger.automatic}}Automatic{{else}}Triggered{{/if}}
          </button>
          {{/each}}
          <button type="button" class="trait-control" data-action="editItem" data-item-id="{{entry.item.id}}"
                  data-tooltip="Edit this Trait - its Effect is what it does on this character">&#9998;</button>
          <button type="button" class="trait-control" data-action="toggleRacialTrait" data-item-id="{{entry.item.id}}"
                  data-tooltip="Remove this Trait">&times;</button>
        </div>
        <div class="trait-body">
          {{#each entry.lines as |line|}}
          {{#if line.addendum}}<details class="dbu-addendum"><summary>{{line.addendum.title}}</summary>{{#each line.addendum.lines as |part|}}{{#if part.gap}}<div class="dbu-entry-break"></div>{{else}}<div class="dbu-profile-line{{#if part.bullet}} dbu-profile-bullet{{/if}}">{{{part.html}}}</div>{{/if}}{{/each}}</details>
          {{else if line.gap}}<div class="dbu-entry-break"></div>{{else}}
          <div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{{line.html}}}</div>{{/if}}
          {{/each}}
          {{#each entry.chosenLines as |chosen|}}
          <div class="dbu-profile-line technique-advantage" data-tooltip="Chosen when it was added">{{chosen}}</div>
          {{/each}}
          {{#if entry.maneuvers.length}}
          {{! Its own effects that are Maneuvers - the same Items as on the Maneuvers tab: used from here, dragged to the hotbar. }}
          <ul class="maneuver-list trait-maneuvers">
            {{#each entry.maneuvers as |maneuver|}}
            <li class="maneuver" data-item-id="{{maneuver.itemId}}" draggable="true">
              <div class="maneuver-head">
                <span class="maneuver-mark" aria-hidden="true"></span>
                <button type="button" class="maneuver-name rollable" data-action="useManeuver"
                        data-item-id="{{maneuver.itemId}}">{{maneuver.name}}</button>
                <span class="maneuver-uses">{{#if maneuver.usageLabel}}{{maneuver.usageLabel}}
                  &middot; {{maneuver.usesLeft}} left{{/if}}</span>
                <span class="maneuver-cost">{{maneuver.actionLabel}}</span>
                <span class="maneuver-cost">{{maneuver.kiCost}} KP</span>
                <button type="button" class="maneuver-control" data-action="editItem"
                        data-item-id="{{maneuver.itemId}}"
                        data-tooltip="Edit this Maneuver: its name, its description, what it costs">&#9998;</button>
              </div>
            </li>
            {{/each}}
          </ul>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="tab-placeholder">No Other Traits yet.</p>
    {{/if}}
  </details>

  {{! Talents are Items the character owns: drag one here to grant it. }}
  <details class="trait-group" data-section="talents"
           {{#if openSections.talents}}open{{/if}}>
    <summary>
      Talents
      <span class="trait-count">{{talents.length}}</span>
      {{#if editable}}
      <button type="button" class="edit-toggle" data-action="refreshTalents"
              data-tooltip="Match the Talents to where they come from - the Progression tab's rows, a Racial Trait - and remove those with no source">
        Refresh talents
      </button>
      {{/if}}
    </summary>

    {{#if talents.length}}
    <ul class="trait-list">
      {{#each talents as |entry|}}
      <li class="trait{{#if entry.open}} trait-open{{/if}}" data-item-id="{{entry.item.id}}" draggable="true">
        <div class="trait-head trait-fold" data-action="toggleTrait">
          <span class="maneuver-mark" aria-hidden="true"></span>
          <img class="trait-img" src="{{entry.item.img}}" height="20" width="20"/>
          <span class="trait-name">{{entry.item.name}}</span>
          {{#if entry.category}}
          <span class="trait-prereq"{{#if entry.item.system.prerequisites}} data-tooltip="Requires {{entry.item.system.prerequisites}}"{{/if}}>{{entry.category}}</span>
          {{else if entry.item.system.prerequisites}}
          <span class="trait-prereq">Requires {{entry.item.system.prerequisites}}</span>
          {{/if}}

          {{! Triggered: offered where its moment is, to take or leave. Automatic: it answers that moment by itself - as a
              Racial Trait's (the user's). }}
          {{#each entry.triggered as |trigger|}}
          <button type="button" class="trait-arm {{#if trigger.automatic}}active{{/if}}"
                  data-action="automateTrigger" data-effect-id="{{trigger.id}}"
                  data-tooltip="{{trigger.label}}{{#if trigger.limits}} - {{trigger.limits}}{{/if}}">
            {{#if trigger.automatic}}Automatic{{else}}Triggered{{/if}}
          </button>
          {{/each}}

          {{#if entry.donors}}
          <button type="button" class="trait-arm" data-action="geneticDonors" data-item-id="{{entry.item.id}}"
                  data-tooltip="Genetic Donors: {{entry.donors.names}}. Their Unique Abilities and Signature Techniques copied onto you.">Donors</button>
          {{/if}}
          <button type="button" class="trait-control" data-action="editItem" data-item-id="{{entry.item.id}}"
                  data-tooltip="Edit this talent">&#9998;</button>
        </div>

        <div class="trait-body">
          {{! Its text as printed; a Talent with none, its description. }}
          {{#if entry.lines.length}}
          {{#each entry.lines as |line|}}
          {{#if line.addendum}}<details class="dbu-addendum"><summary>{{line.addendum.title}}</summary>{{#each line.addendum.lines as |part|}}{{#if part.gap}}<div class="dbu-entry-break"></div>{{else}}<div class="dbu-profile-line{{#if part.bullet}} dbu-profile-bullet{{/if}}">{{{part.html}}}</div>{{/if}}{{/each}}</details>
          {{else if line.gap}}<div class="dbu-entry-break"></div>{{else}}
          <div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{{line.html}}}</div>{{/if}}
          {{/each}}
          {{else if entry.item.system.description}}
          <div class="trait-description">{{{entry.item.system.description}}}</div>
          {{/if}}
          {{#each entry.chosenLines as |chosen|}}
          <div class="dbu-profile-line technique-advantage" data-tooltip="Chosen when it was gained">{{chosen}}</div>
          {{/each}}
          {{#if entry.item.system.effects.length}}
          <ol class="trait-effects">
            {{#each entry.item.system.effects as |effect|}}
            <li>{{effect.text}}</li>
            {{/each}}
          </ol>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="tab-placeholder">No talents yet. They are taken on the Progression tab.</p>
    {{/if}}
  </details>

</div>

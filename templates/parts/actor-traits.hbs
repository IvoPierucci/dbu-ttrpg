<div class="tab {{tabs.traits.cssClass}}" data-group="primary" data-tab="traits">

  {{! Racial Traits are added by hand - this race's or any other's - and removed the same way. }}
  <details class="trait-group" data-section="racialTraits"
           {{#if openSections.racialTraits}}open{{/if}}>
    <summary>
      Racial Traits
      <span class="trait-count">{{racialTraits.length}}</span>
      <button type="button" class="edit-toggle" data-action="addRacialTrait"
              data-tooltip="Your race's first, then every other race's">Add Racial Trait</button>
    </summary>

    {{#if racialTraits.length}}
    {{! As the Unique Abilities' rows: a click unfolds one to its text as printed, and what was chosen for it. }}
    <ul class="maneuver-list technique-list">
      {{#each racialTraits as |entry|}}
      <li class="maneuver{{#if entry.open}} maneuver-open{{/if}}" data-item-id="{{entry.item.id}}">
        <div class="maneuver-head" data-action="toggleManeuver">
          <span class="maneuver-mark" aria-hidden="true"></span>
          <span class="maneuver-name">{{entry.item.name}}</span>
          <span class="maneuver-uses">{{entry.race}}{{#if entry.kind}} &middot; {{entry.kind}}{{/if}}</span>
          {{#each entry.triggered as |trigger|}}
          <button type="button" class="trait-arm {{#if trigger.armed}}active{{/if}}"
                  data-action="armTalent" data-effect-id="{{trigger.id}}"
                  {{#unless trigger.available}}disabled{{/unless}}
                  data-tooltip="{{#if trigger.text}}{{trigger.text}} - {{/if}}{{trigger.moment}}{{#if trigger.limits}} - {{trigger.limits}}{{/if}}">
            {{#if trigger.armed}}Armed{{else}}Arm{{/if}}
          </button>
          {{/each}}
          <button type="button" class="maneuver-control" data-action="editItem" data-item-id="{{entry.item.id}}"
                  data-tooltip="Edit this Racial Trait - its Effect is what it does on this character">&#9998;</button>
          <button type="button" class="maneuver-control" data-action="toggleRacialTrait" data-item-id="{{entry.item.id}}"
                  data-tooltip="Remove this Racial Trait">&#10005;</button>
        </div>
        <div class="maneuver-body">
          {{#each entry.lines as |line|}}
          {{#if line.gap}}<div class="dbu-entry-break"></div>{{else}}
          <div class="dbu-profile-line{{#if line.bullet}} dbu-profile-bullet{{/if}}">{{line.text}}</div>{{/if}}
          {{/each}}
          {{#each entry.chosenLines as |chosen|}}
          <div class="dbu-profile-line technique-advantage" data-tooltip="Chosen when it was added">{{chosen}}</div>
          {{/each}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="tab-placeholder">No Racial Traits yet.</p>
    {{/if}}
  </details>

  {{! Talents are Items the character owns: drag one here to grant it. }}
  <details class="trait-group" data-section="talents"
           {{#if openSections.talents}}open{{/if}}>
    <summary>
      Talents
      <span class="trait-count">{{talents.length}}</span>
      {{#if isGM}}
      <button type="button" class="edit-toggle" data-action="importTalents"
              data-tooltip="Fill the DBU Talents compendium with the published talents, ready to drag onto a character">
        Import core talents
      </button>
      <button type="button" class="edit-toggle" data-action="reloadTalents"
              data-tooltip="Read every core talent back from its file, overwriting what is in the compendium">
        Reload from files
      </button>
      <button type="button" class="edit-toggle" data-action="importManeuvers"
              data-tooltip="Fill the DBU Maneuvers compendium from the files">
        Import core maneuvers
      </button>
      {{/if}}
    </summary>

    {{#if talents.length}}
    <ul class="trait-list">
      {{#each talents as |entry|}}
      <li class="trait" data-item-id="{{entry.item.id}}" draggable="true">
        <div class="trait-head">
          <img class="trait-img" src="{{entry.item.img}}" height="20" width="20"/>
          <span class="trait-name">{{entry.item.name}}</span>
          {{#if entry.item.system.prerequisites}}
          <span class="trait-prereq">Requires {{entry.item.system.prerequisites}}</span>
          {{/if}}

          {{! One button per triggered effect, not per talent: a talent carrying two of
              them has each armed on its own. }}
          {{#each entry.triggered as |trigger|}}
          <button type="button" class="trait-arm {{#if trigger.armed}}active{{/if}}"
                  data-action="armTalent" data-effect-id="{{trigger.id}}"
                  {{#unless trigger.available}}disabled{{/unless}}
                  data-tooltip="{{trigger.text}} — {{trigger.round}} left this round, {{trigger.encounter}} this encounter.">
            {{#if trigger.armed}}Armed{{else}}Arm{{/if}}
          </button>
          {{/each}}

          <button type="button" class="trait-control" data-action="editItem" data-item-id="{{entry.item.id}}"
                  data-tooltip="Edit this talent">&#9998;</button>
          <button type="button" class="trait-control" data-action="deleteItem" data-item-id="{{entry.item.id}}"
                  data-tooltip="Remove from this character">&times;</button>
        </div>

        {{#if entry.item.system.description}}
        <div class="trait-description">{{{entry.item.system.description}}}</div>
        {{/if}}

        <ol class="trait-effects">
          {{#each entry.item.system.effects as |effect|}}
          <li>{{effect.text}}</li>
          {{/each}}
        </ol>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="tab-placeholder">No talents yet. Drag a talent Item onto this sheet to grant one.</p>
    {{/if}}
  </details>

</div>

id: precision-performance
name: Precision Performance
order: 3
optionOf: show-stopping-performance
optionEffect: 1
description: >
  While you are Hyped, increase your Strike Rolls by 1(T).
text: >
  Precision Performance [Passive]: While you are Hyped, increase your Strike Rolls by 1(T).

---

[passive]
if (hasCondition("hyped")) {
  strike += 1(T);
}

id: battle-goo
name: Battle Goo
talentCategory: racial
race: majin
prerequisites: Majin, Primordial Majin Factor
description: >
  Your Goops are now combat-ready!
text: >
  Battle Goo: Your Goops are now combat-ready!
  –Prerequisites: Majin, Primordial Majin Factor
  (1)-[Passive]: Increase your maximum number of Minions by 2.
  (2)-[Passive]: Increase the Life Points of your Goops by 2 for each Power Level reached (after all other calculations).
  (3)-[Passive]: Your Goops gain access to (and can use) the Basic Attack Maneuver and Intervene Maneuver, but if a Goop uses the Intervene Maneuver, they are destroyed after using the Maneuver even if they have any Life Points remaining.

---

[passive]
# (1) "Your maximum number of Minions": how many you may possess in a Combat Encounter - and so outside of one (maneuvers.mjs
# minionCaps).
minions.combat += 2;
# (2) Given to each of your Goops as it is prepared, after all other calculations (allies.mjs minionGifts).
goops.lifePerLevel += 2;
# (3) Their Basic Attack and Intervene (maneuvers.mjs whyNotMinionManeuver); a Goop that Intervened destroyed as the turn moves on
# (combat.mjs).
allow battleGoo.maneuvers;

id: risky-bet
name: Risky Bet
talentCategory: durability
prerequisites: Resilience, Tenacity Score of 8+
description: >
  You can throw more power into your attacks at the cost of opening your guard.
text: >
  Risky Bet: You can throw more power into your attacks at the cost of opening your guard.
  –Prerequisites: Resilience, Tenacity Score of 8+
  (1)-[Passive]: While you are below the Injured Health Threshold, increase your Soak Value by 1(bT).
  (2)-[Triggered, 1/Round]: When making an Attacking Maneuver, reduce your Soak Value by up to 4(bT) until the start of your next turn to increase your Wound Rolls for that Attacking Maneuver by twice the reduction.

---

[passive]
# (1) Injured or Critical.
if (belowThreshold("injured")) {
    soakValue += 1(bT);
}
# (2) Asked as an Attacking Maneuver is declared, once a Round: how much off your Soak Value, up to 4(bT) - Risky Bet (a mark, a
# stack a point) till the start of your next turn, and twice as much on that attack's Wound Roll (maneuvers.mjs askRiskyBet).
allow wound.riskyBet;

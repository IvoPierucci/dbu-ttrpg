id: slow-starter
name: Slow Starter
talentCategory: starter
prerequisites: 2+ Skill Ranks in Concealment
description: >
  You are partial to holding back your true power until a foe has proven worthy.
text: >
  Slow Starter: You are partial to holding back your true power until a foe has proven worthy.
  –Prerequisites: 2+ Skill Ranks in Concealment
  (1)-[Passive]: Increase the Dice Score of your Clairvoyance and Concealment Skill Checks by 2.
  (2)-[Passive]: While you have a stack of Holding Back, reduce the Ki Point Cost of all Maneuvers by 1(T).
  (3)-[Triggered/Start of Combat Encounter]: Use the Holding Back Maneuver as an Out-of-Sequence Maneuver.
  (4)-[Triggered, 1/Encounter]: If you lose all stacks of Holding Back, you may apply the effects of Legend Realized even if you are not in a Transformation.

---

[passive]
# (1)
skill.clairvoyance += 2;
skill.concealment += 2;
# (2) Every Maneuver's Ki Point Cost (maneuvers.mjs maneuverKiCost).
if (hasResource("holdingback")) {
    maneuvers.kiCost -= 1(T);
}

# (3) Entering the Encounter, ticked in its window - never Automatic, it hands over an Out-of-Sequence Maneuver: the Holding
# Back Maneuver out of sequence (chat.mjs slowStarter).
[triggered/start-of-encounter, outOfSequence, effect 3]
slowStarter();

# (4) The last stack of Holding Back gone in a Combat (the `holding-back-lost` Moment): Legend Realized, once an Encounter.
# Automatic by default, its Triggered/Automatic button.
[triggered/holding-back-lost, 1/encounter, effect 4]
legendRealized();

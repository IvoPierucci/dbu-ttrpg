id: personal-space
name: Personal Space
talentCategory: grappling
prerequisites: N/A
description: >
  You are adept at keeping others from grabbing hold of you.
text: >
  Personal Space: You are adept at keeping others from grabbing hold of you.
  –Prerequisites: N/A
  (1)-[Passive]: Increase the Dice Score of your Grapple Checks by 1(T) if they are initiated by another Character or while you are in a Grapple as the Grappled.
  (2)-[Triggered/Start of Turn]: Make a Grapple Check to escape a Grapple you are in as the Grappled. This counts as spending 1 Action for the effects of Escaping a Grapple.
  (3)-[Triggered, 1/Round]: If you escape a Grapple or an Opponent ends their turn within your Melee Range, you may use the Movement Maneuver as an Out-of-Sequence Maneuver.

---

[passive]
# (1) The Defender's side of every Grapple Check - the one aimed at you, and every one as the Grappled (chat.mjs
# grappleAllParts).
allow personalSpace.grapple;
# (3) An escape, or an Opponent's turn ended within your Melee Range: the Movement offered out of sequence on that card, once a
# Round (chat.mjs offerPersonalSpace, personalSpaceTurnEnd).
allow personalSpace.move;

# (2) As your turn begins, as the Grappled: the escape's Grapple Check, no Action paid but counted as one (use-maneuver.mjs
# escapeGrapple).
[triggered/start-of-turn, toggle, effect 2]
if (grappledInGrapple) {
  personalEscape();
}

id: honorable-demon
name: Honorable Demon
talentCategory: racial
race: demon
prerequisites: Demon Race
description: >
  Whenever you fight, you avoid the dirty tricks your demonic brethren often resort to, ensuring that every fight is won with honor and dignity.
text: >
  Honorable Demon: Whenever you fight, you avoid the dirty tricks your demonic brethren often resort to, ensuring that every fight is won with honor and dignity.
  –Prerequisites: Demon Race
  (1)-[Passive]: If you have not inflicted a Combat Condition on an Opponent during this Combat Encounter, increase your Combat Rolls and Soak Value by 1(T).
  (2)-[Triggered, 1/Round]: If you win the Clash for the 3rd effect of Demonic Combat, instead of knocking that Opponent Prone, you may enter the Superior State until the start of your next turn.
  (3)-[Triggered, 1/Round]: If you would inflict a Combat Condition on an Opponent (except through the 3rd effect of Demonic Combat), you may instead use the Power Up Maneuver as an Out-of-Sequence Maneuver.
  (4)-[Triggered/Power, 1/Encounter]: If you have not inflicted a Combat Condition on an Opponent during this Combat Encounter and you are below the Injured Health Threshold, use a Surge of your choice as an Out-of-Sequence Maneuver.

---

[passive]
# (1) No Combat Condition put on an Opponent this Combat Encounter (kept as one is - chat.mjs conditionGained).
if (!inflictedThisEncounter) {
    combatRolls += 1(T);
    soakValue += 1(T);
}
# (2) Demonic Combat (3)'s Clash won: asked, once a Round - Superior till the start of your next turn, not their Prone (chat.mjs
# settleThrownProne).
allow honorable.superior;
# (3) A Combat Condition put on an Opponent - but by Demonic Combat (3): asked, once a Round - taken back, the Power Up out of
# sequence instead (chat.mjs honorableInstead).
allow honorable.powerUp;

# (4) Ticked in the Power Up's window, once an Encounter, never Automatic: none inflicted, below Injured - a Surge of your choice
# out of sequence.
[triggered/power, 1/encounter, outOfSequence, effect 4]
requires !inflictedThisEncounter && belowThreshold("injured");
surgeOutOfSequence();

id: balanced-warrior
name: Balanced Warrior
prerequisites: Force and Magic Scores of 4+
description: >
  Proficient in combat and magic, you train to use both equally.
text: >
  While your Force and Magic Scores are equal, each one's Attribute Modifier is
  increased by the other's Attribute Score, up to the Attribute Score Limit.
  Reduce the Ki Point Cost of all Attacking Maneuvers by 1(T).

---

[passive]
if (force.score == magic.score) {
    force.mod += max(0, min(magic.score, attributeScoreCap - force.score));
    magic.mod += max(0, min(force.score, attributeScoreCap - magic.score));
}

[passive]
attack.kiCost -= 1(T);

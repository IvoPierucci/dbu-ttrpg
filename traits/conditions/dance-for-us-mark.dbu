id: dance-for-us-mark
name: Dance for Us
kind: conditions
maxStacks: 10
# Not a Combat Condition: Desperate Support's, on an Ally, held on the supporter's clock.
combatCondition: no
source: Core Rule
description: >
  Desperate Support: Strike and Dodge Rolls 1(bT) higher, the supporter's base Tier, until the start of their next turn.
text: >
  Dance for us.: The Ally has their Strike and Dodge Rolls increased by 1(bT) until the start of your next turn.

---

[passive]
strike += stacks;
dodge += stacks;

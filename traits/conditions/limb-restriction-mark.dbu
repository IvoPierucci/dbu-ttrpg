id: limb-restriction-mark
name: Limb Restriction
kind: conditions
maxStacks: 1
# Not a Combat Condition: Swaggering Wager's, till the start of your next turn (chat.mjs swaggerChoose, swaggerSpend).
combatCondition: no
source: Core Rule
description: >
  Swaggering Wager: your Combat Rolls 2(bT) lower until the start of your next turn.
text: >
  Swaggering Wager: your Combat Rolls 2(bT) lower until the start of your next turn.

---

[passive]
combatRolls -= 2(bT);

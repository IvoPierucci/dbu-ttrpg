id: post-training-confidence
name: Post-Training Confidence
kind: conditions
maxStacks: 1
# A Training Bonus: not a Combat Condition, and gained on the Adventure tab's Training fold.
combatCondition: no
trainingBonus: true
# "They will only maintain that for a length of time that depends on the ARC": ended by hand.
endedByHand: true
source: Core Rule
description: >
  Saving Throws 1(bT) higher, and no Impediment.
text: >
  Post-Training Confidence: After training, you feel unstoppable.
  –Effects: Increase your Saving Throws by 1(bT) and you cannot gain the Impediment Combat Condition.

---

[passive]
save.all += 1(bT);
forbid condition.impediment;

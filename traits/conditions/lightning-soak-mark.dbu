id: lightning-soak-mark
name: Lightning Soak
kind: conditions
maxStacks: 1
# Not a Combat Condition: Lightning Surge's, for the rest of the Combat Encounter.
combatCondition: no
source: Core Rule
description: >
  Lightning Surge: Soak Value 1(T) higher for the rest of the Combat Encounter.
text: >
  Lightning Surge: Soak Value 1(T) higher for the remainder of the Combat Encounter.

---

[passive]
soakValue += 1(T);

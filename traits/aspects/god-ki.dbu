# Its id leads with aspect-: a State of the same name (Raging, Mindful, God Ki) has the bare one.
id: aspect-god-ki
name: God Ki
polarity: positive
# number: its script is the whole of it. moment: entering, leaving, the start of a turn (stages 4-5).
# rule: how a Transformation is entered, left or Mastered - asked by transformations.mjs aspectLevel.
group: moment
# The rule in short, for its hovers; its own words below (the page the user gave, 2026-11-20).
summary: >
  You are in the God Ki State.
text: >
  God Ki: This Transformation grants access to divine ki.
  –Effect: While you are in this Transformation, you are in the God Ki State.

---

# "While you are in this Transformation, you are in the God Ki State": the way in open, and it entered as the Transformation is (left with
# it: the table's).
[passive]
allow godKi.access;

[automatic/transform]
enterState(god-ki, 1, encounter);

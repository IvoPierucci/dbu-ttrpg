# Its id leads with aspect-: a State of the same name (Raging, Mindful, God Ki) has the bare one.
id: aspect-growth
name: Growth
polarity: positive
levels: true
max: 3
# number: its script is the whole of it. moment: entering, leaving, the start of a turn (stages 4-5).
# rule: how a Transformation is entered, left or Mastered - asked by transformations.mjs aspectLevel.
group: moment
# The rule in short, for its hovers; its own words below (the page the user gave, 2026-11-20).
summary: >
  Level 1: Size Category Large; one Size Category more for each level after; it never makes you smaller.
text: >
  Growth [LV~3]: This Transformation increases the size of your body.
  –Effect: The first level of this Aspect sets your Size Category to Large while in this Transformation. For every level after the first, increase the Size Category you are set to by 1. This Aspect cannot cause your Size Category to be lower than it would be prior to applying its effects.

---

# Level 1 Large, one larger a level (never smaller than you would be: the table's where you are larger already).
[passive]
if ($level == 1) {
    allow size.base.large;
}
if ($level == 2) {
    allow size.base.enormous;
}
if ($level >= 3) {
    allow size.base.gigantic;
}

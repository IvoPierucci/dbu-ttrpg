id: arrogant-declaration
name: Arrogant Declaration
type: standard
actionCost: 1
kiCost: 0
attacking: false
usageLimit: 1/encounter
exploitable: All adjacent Opponents
resource: arrogance
resourceMax: 1
# Not a Resource the rules name: the rulebook calls exactly one thing a Resource,
# and it is Power. This is bookkeeping, held as a Resource because that is the
# thing here that takes a clock. `resourceInternal` keeps it off the sheet's
# Resources list rather than teaching a player a word the book does not use.
# What it holds: the penalty waiting for you when this Superior State ends.
resourceInternal: true
source: Core Rule
description: >
  Point your thumb at yourself and make a statement about your own superiority,
  emboldening you in the process.
text: >
  Arrogant Declaration Maneuver [1/Encounter]: Point your thumb at yourself and
  make a statement about your own superiority, emboldening you in the process.
  –Maneuver Type: Standard
  –Action Cost: 1 Action
  –KP Cost: N/A
  –Exploitable: All adjacent Opponents.
  –Effect: Enter the Superior State until the end of your next turn. Then, upon
  leaving the Superior State entered through this effect, reduce your Combat
  Rolls, Surgency, and Soak Value by 1(bT) for the remainder of the Combat
  Encounter.

  Only 1 of your Minions may use the Arrogant Declaration Maneuver in each Combat
  Encounter.

---

# The Minion limit is not here. It is a limit across a group of characters rather
# than on any one of them, and there is no notion in this system of whose Minions
# somebody is - so it is left to the player and the Gamemaster, the way every other
# thing a table says out loud is.

# Used: the Superior State, and the boast marked. Every character holds this Maneuver,
# so leaving Superior is not enough to owe the penalty - only the Superior this entered
# (it used to fire on leaving any Superior, Warrior's Pride's or Divine Physique's,
# Arrogant Declaration used or not).
[on used]
enterState(superior, 1, next-turn);
arrogance.stacks += 1;

# What the boast costs once it wears off: "upon leaving the Superior State entered
# through this effect ... for the remainder of the Combat Encounter". Marked and out of
# Superior, then. The Resource is the carrier, and the right one: a Resource is lost when
# the Combat Encounter ends, which is exactly the span the rule names - so nothing has to
# remember to take this off. (A later Superior from elsewhere holds it off while it lasts.)
[passive]
if ((arrogance.stacks > 0) && !inState("superior")) {
    combatRolls -= 1(bT);
    surgency    -= 1(bT);
    soakValue   -= 1(bT);
}

id: healing-surge-instant
name: Healing Surge (Instant)
type: instant
actionCost: 0
kiCost: 0
attacking: false
requiresTarget: false
usageLimit: 1/encounter
# Opened by an effect that lets a Healing Surge be used "as an Instant Maneuver" once an Encounter (On the Brink (2)).
special: true
source: Core Rule
description: >
  A Healing Surge as an Instant Maneuver, where an effect allows it.
text: >
  Once an Encounter: use a Healing Surge as an Instant Maneuver.
  –Maneuver Type: Instant Maneuver
  –Action Cost: N/A
  –KP Cost: N/A
  –Effect: A Healing Surge.

---

[on used]
surge(healing);

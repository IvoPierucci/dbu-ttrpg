id: arcosian-genes-agility
name: Genetic Agility
order: 3
optionOf: arcosian-genes
optionEffect: 4
# Artificial Warrior's Option chosen: this one.
follows: genetic-agility
description: >
  If you spend 2+ Adaptation Points on a Dodge Roll, increase the Dice Score by 1/2 of your Plating’s Apparel Bonus.
text: >
  Genetic Agility [Triggered]: If you spend 2+ Adaptation Points on a Dodge Roll, increase the Dice Score by 1/2 of your Plating’s Apparel Bonus.

---

# A Dodge Roll with 2+ Adaptation Points spent on it (adaptation-on-roll): half your Plating's Apparel Bonus on it, rounded down (chat.mjs
# rollSide, platingBonus). Automatic by default, its Triggered/Automatic button.
[triggered/adaptation-on-roll, effect 4]
requires dodgeRolled && spentAtLeast(2);
arcosianDodge.plating = true;

id: genetic-focus-shinjin
name: Genetic Focus: Shinjin
order: 17
category: body
# "[Uncanny Monster]": it replaces that Primary Racial Trait - which, the table's. (1) Its Prerequisite, the Shinjin Genes Factor Trait,
# shown and never enforced.
importance: primary
# (2) Those four, free and without their Requirements, gone with this (racial.mjs).
grantsUnique: magical-materialization, telepathy, telekinesis, second-sight
# Its own description was given cut short ("T"): asked for.
text: >
  Genetic Focus: Shinjin (Body) [Uncanny Monster]:
  (1)-[Prerequisite]: Shinjin Genes Factor Trait
  (2)-[Passive]: You gain access to the Magical Materialization, Telepathy, Telekinesis, and Second Sight Unique Abilities.
  (3)-[Passive]: Upon gaining this Factor Trait, gain a Skill Rank in each of the following skills while you have access to this Trait: Creature Handling, Clairvoyance, Perception, Use Magic and Investigation.
  (4)-[Passive]: Your minimum Action Cost for Combat Recovery is 1 Action.
  (5)-[Triggered, 1/Round]: If you use Combat Recovery, you may spend 2 Adaptation Points to not trigger an Exploit Maneuver.
---

[passive]
# (3) While it is had.
skill.creatureHandling.ranks += 1;
skill.clairvoyance.ranks += 1;
skill.perception.ranks += 1;
skill.useMagic.ranks += 1;
skill.investigation.ranks += 1;
# (4) Skill of the Watcher (2)'s words: Combat Recovery's 2~3 Actions become 1~3.
combat-recovery.actionCost.minimum = 1;
# (5) Combat Recovery used, with 2 Adaptation Points: asked, once a Round - spent, no Exploit offered from it (chat.mjs offerExploits). It
# spends: no button.
allow focusShinjin.noExploit;

id: angel-raised
name: Angel-Raised
order: 1
category: mind
# A Factor Trait replaces a Secondary Racial Trait.
importance: secondary
description: >
  Thanks to your upbringing at the hands of the divine, you allow your instincts to guide your survival in combat.
text: >
  Angel-Raised (Mind): Thanks to your upbringing at the hands of the divine, you allow your instincts to guide your survival in combat.
  (1)-[Passive]: While you possess no Counter Actions, increase your Defense Value by 1(T).
  (2)-[Passive]: While you possess no Counter Actions, increase the Dice Score for any Clash initiated by an Opponent that uses your Saving Throws by 1(T).
  (3)-[Triggered, 1/Round]: If you are targeted by an Opponent’s Attacking Maneuver while you possess no Counter Actions, you may spend 3(bT) Ki Points to use the Defend Maneuver without spending a Counter Action.
  (4)-[Triggered/Start of Combat Round]: You may spend a Counter Action to use the Movement Maneuver or Power Up Maneuver as an Out-of-Sequence Maneuver.

---

[passive]
# (1)
if (noCounterActions) {
    defenseValue += 1(T);
}
# (2) Your side of a Saving Throw Clash an Opponent opened, with no Counter Action left (chat.mjs angelRaisedClashBonus).
allow angelRaised.clash;
# (3) Defending with no Counter Action left: asked, once a Round - 3(bT) Ki instead (chat.mjs, the Defend's choice).
allow angelRaised.defend;

# (4) The Combat Round beginning: a Counter Action for the Movement or the Power Up Maneuver, out of sequence - which, asked; never
# Automatic (chat.mjs angelRaisedStart).
[triggered/start-of-round, outOfSequence, effect 4]
angelRaisedStart();

id: tuffle-raised
name: Tuffle-Raised
order: 18
category: mind
# A Factor Trait replaces a Secondary Racial Trait.
importance: secondary
# (1)'s count, its Resource.
resource: grudge
resourceLabel: Tuffle-Raised
description: >
  Schooled by the greatest Tuffle minds, your petty need for vengeance rivals even that of your adoptive race.
text: >
  Tuffle-Raised (Mind): Schooled by the greatest Tuffle minds, your petty need for vengeance rivals even that of your adoptive race.
  (1)-[Triggered/Threshold]: If you were knocked through this Health Threshold by an Opponent’s Attacking Maneuver, increase your Combat Rolls by 1(T) but increase the Ki Point Cost of your Attacking Maneuvers by 1(T) for the remainder of the Combat Encounter.
  (2)-[Triggered, 1/Round]: If an Ally is Defeated by an Opponent’s Attacking Maneuver, you may trigger the first effect of Tuffle-Raised as if you had been knocked through your next Health Threshold.
  (3)-[Triggered/Defeated]: Target an Ally, they regain 2x(bT) Life and Ki Points and their Combat Rolls are increased by x(bT) until the end of their next turn. X, for this effect, is equal to the amount of times you have triggered the first effect of Tuffle-Raised.

---

# Each time (1) is triggered, a stack of its Resource - lost as the Combat Encounter ends, as every Resource is: "for the remainder of
# the Combat Encounter".
[passive]
if (hasResource("grudge")) {
    combatRolls += grudge.stacks * 1(T);
    attack.kiCost += grudge.stacks * 1(T);
}

# (1) Knocked through by an Opponent's Attacking Maneuver - chosen on the Threshold's card, it starts Triggered: the Ki it costs is the
# player's to weigh.
[triggered/threshold, startsTriggered, effect 1]
requires knockedByOpponent;
grudge.stacks += 1;

# (2) An Ally Defeated by an Opponent's Attacking Maneuver - (1) once more, asked.
[triggered/ally-defeated, 1/round, startsTriggered, effect 2]
requires knockedByOpponent;
grudge.stacks += 1;

# (3) Defeated, with (1) triggered at least once: an Ally, asked - 2x(bT) Life and Ki Points, Combat Rolls x(bT) till the end of their
# next turn (chat.mjs tuffleLegacy). Chosen on the Defeated card.
[triggered/defeated, effect 3]
requires hasResource("grudge");
tuffleLegacy();

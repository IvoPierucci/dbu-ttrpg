id: hefty-plating
name: Hefty Plating
kind: crafting
categories: weights
slots: 1
prerequisites: Force Score of 6+
source: Core Rule
description: >
  Hardness Value 4. Thrown and hitting, a Might Clash that knocks them Prone. Needs a Force
  Score of 6+.
# What it does, for the Effects on its Item's sheet: its Effects line as printed, word for
# word, cut into one line to an effect, each opening with its tag as the rulebook writes one.
summary: >
  [Passive]: The Hardness Value of this piece of Apparel is set to 4.

  [Automatic]: If you hit an Opponent with this piece of Apparel through the Throw Maneuver,
  make a Might Clash against them. If you win, they are knocked Prone.
text: >
  Hefty Plating: The sturdy weights in this outfit can be weaponized.
  –Apparel Category: Weights
  –Prerequisites: Force Score of 6+
  –Quality Slots: 1
  –Effects: The Hardness Value of this piece of Apparel is set to 4. If you hit an Opponent
  with this piece of Apparel through the Throw Maneuver, make a Might Clash against them. If
  you win, they are knocked Prone.

---

# --- What is built -----------------------------------------------------------------------------
#
# The Hardness Value: its sheet shows 4, and thrown with the Throw Maneuver it is the Collision
# Damage. A hit with it thrown opens a Might Clash against the one hit, and winning knocks them
# Prone - while the one throwing it meets the Force Score of 6+, the Prerequisite being theirs.

[passive]
piece.hardnessValue = 4;
# "If you hit an Opponent with this piece of Apparel through the Throw Maneuver, make a Might
# Clash against them. If you win, they are knocked Prone." Its Prerequisite is the thrower's.
if (force.score >= 6) {
  piece.thrownMightClash = true;
}

id: unbreakable
name: Unbreakable
kind: crafting
# A Special Apparel Quality: "typically gained through your ARC granting you unique pieces of
# Apparel".
special: true
slots: 1
# "Prerequisites: Durable Apparel Quality" - a Prerequisite about the piece: without Durable on
# it, Unbreakable does not apply at all.
requiresQualities: durable
prerequisites: Durable Apparel Quality
source: Core Rule
description: >
  Its Break Value is never reduced. Needs Durable on the same piece.
# What it does, for the Effects on its Item's sheet: its Effects line as printed, word for
# word, cut into one line to an effect, each opening with its tag as the rulebook writes one.
summary: >
  [Passive]: This piece of Apparel cannot have its Break Value reduced.
text: >
  Unbreakable: This outfit is somehow indestructible.
  –Apparel Category: All
  –Prerequisites: Durable Apparel Quality
  –Quality Slots: 1
  –Effects: This piece of Apparel cannot have its Break Value reduced.

---

# Loses no Break Value, from anything - a Health Threshold, a Called Shot.

[passive]
piece.unbreakable = true;

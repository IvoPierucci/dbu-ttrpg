id: combat-clothing
name: Combat Clothing
kind: crafting
source: Core Rule
description: >
  Defense Value higher by half the Apparel Bonus, while the Top Layer.
text: >
  Combat Clothing. While this is the Top Layer of Apparel, increase your Defense Value by 1/2
  (rounded up) of the Apparel Bonus.

---

# "While this is the Top Layer of Apparel, increase your Defense Value by 1/2 (rounded up) of
# the Apparel Bonus."
[passive]
defenseValue += ceil($apparelBonus(bT) / 2);

id: god-of-many
name: God of Many
order: 8
optionOf: divine-magic
# "You gain the Master of Minions Talent" - given with it when it is written.
grantsTalent: master-of-minions
description: >
  You gain the Master of Minions Talent, and your Minions have their Combat Rolls increased by 1(T) while you are in the Spectator State.
text: >
  God of Many [Passive]: You gain the Master of Minions Talent, and your Minions have their Combat Rolls increased by 1(T) while you are in the Spectator State.

---

# "Your Minions have their Combat Rolls increased by 1(T) while you are in the Spectator State" - given to each of them as it is
# prepared (allies.mjs minionGifts).
[passive]
requires inState("spectator");
minions.combatRolls += 1(T);

id: god-of-wisdom
name: God of Wisdom
order: 5
optionOf: divine-magic
description: >
  If Scholarship and/or Personality have the highest Attribute Score among your Attributes, increase all of your Combat Rolls and Initiative Rolls by 1(bT).
text: >
  God of Wisdom [Passive]: If Scholarship and/or Personality have the highest Attribute Score among your Attributes, increase all of your Combat Rolls and Initiative Rolls by 1(bT).

---

# The highest - tied counts: "have the highest Attribute Score".
[passive]
if (max(scholarship.score, personality.score) >=
    max(max(agility.score, force.score), max(max(tenacity.score, insight.score), magic.score))) {
    combatRolls += 1(bT);
    initiative += 1(bT);
}

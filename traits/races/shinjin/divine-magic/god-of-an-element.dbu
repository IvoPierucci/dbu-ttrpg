id: god-of-an-element
name: God of an Element
order: 10
optionOf: divine-magic
# "Select a Profile with 'Elemental' in the name" - asked when it is added, `$choice`.
choose: elementalProfile
description: >
  Upon gaining this effect, select a Profile with ‘Elemental’ in the name – it becomes a Favored Element.
text: >
  God of an Element [Passive]: Upon gaining this effect, select a Profile with ‘Elemental’ in the name – it becomes a Favored Element.

---

[passive]
favored.$choice = true;

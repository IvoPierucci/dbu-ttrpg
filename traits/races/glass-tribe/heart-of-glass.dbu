id: heart-of-glass
name: Heart of Glass
order: 2
category: mind
importance: primary
# (2) Fatigued not felt in the Healthy Health Threshold (registry.mjs conditionsIgnored).
ignoresConditions: fatigued
ignoresConditionsWhileThreshold: healthy
description: >
  Implacable and unrevealing, your impassive demeanor betrays none of your pain nor turmoil.
text: >
  Heart of Glass (Mind): Implacable and unrevealing, your impassive demeanor betrays none of your pain nor turmoil.
  (1)-[Passive]: Ignore all Health Threshold Penalties while in the Surging State.
  (2)-[Passive]: Ignore the effects of the Fatigued Combat Condition while in the Healthy Health Threshold.
  (3)-[Triggered, 1/Round]: If you use an Attacking Maneuver of the Glass Profile while occupying a Square with the Glass Environmental Quality, you may enter the Surging State for the duration of that Attacking Maneuver.
  (4)-[Triggered/Threshold]: When you make a Steadfast Check, you may choose to fail that Steadfast Check without rolling to use a Ki Surge as an Out-of-Sequence Maneuver. Then, you may enter the Surging State until the end of your turn.
  (5)-[Triggered, 1/Encounter]: If you leave the Surging State, you may use a Healing Surge as an Out-of-Sequence Maneuver. If you do, remove any stacks of the Fatigued Combat Condition you are suffering from.

---

[passive]
# (1)
if (inState("surging")) {
    threshold.penalty = 0;
}
# (3) An attack of the Glass Profile declared on a Glass Square - asked, once a Round: Surging till it is concluded
# (maneuvers.mjs askGlassSurge, chat.mjs glassSurgeEnds).
allow surging.glassAttack;
# (4) A box in the Steadfast Check's window: failed without rolling - a Ki Surge out of sequence, then Surging till the
# end of your turn asked (chat.mjs rollSteadfastCheck, heartOfGlassFail).
allow steadfast.heartOfGlass;

# (5) Leaving the Surging State - asked in its window, never Automatic: a Healing Surge out of sequence, and every stack
# of Fatigued off (the one leaving it gave included).
[triggered/left-state/surging, 1/encounter, outOfSequence, effect 5]
surge(healing);
remove("fatigued");

id: leader
name: Leader
order: 5
optionOf: functional-purpose
optionEffect: 2
description: >
  Increase the Combat Rolls of all your Minions by 1(T) and increase their Maximum Life Points by 5(bT).
text: >
  Leader [Passive]: Increase the Combat Rolls of all your Minions by 1(T) and increase their Maximum Life Points by 5(bT).

---

# Given to each of your Minions as it is prepared (allies.mjs minionGifts) - the Life after its quarter.
[passive]
minions.combatRolls += 1(T);
minions.lifeMax += 5(bT);

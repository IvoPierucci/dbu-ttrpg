id: tailless
name: Tailless
order: 2
optionOf: saiyan-heritage
description: >
  Increase your Wound Rolls and Soak Value by 1(T) while in a Form and/or Enhancement.
text: >
  Tailless [Passive]: Increase your Wound Rolls and Soak Value by 1(T) while in a Form and/or Enhancement.

---

# "While in a Form and/or Enhancement" - a Null Stage is the Normal State, not a Form.
[passive]
if (inFormOrTranscended || inEnhancement) {
    wound += 1(T);
    soakValue += 1(T);
}

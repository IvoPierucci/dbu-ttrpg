id: surprising-resilience
name: Surprising Resilience
order: 4
category: body
importance: secondary
description: >
  Your body can take far more punishment than most would think.
text: >
  Surprising Resilience (Body): Your body can take far more punishment than most would think.
  (1)-[Passive]: Increase the Dice Score of your Steadfast Checks by 1.
  (2)-[Passive]: Increase your Stress Bonus by 1 while you are not suffering from the Threshold Penalties of any Health Thresholds.
  (3)-[Triggered/Threshold]: If you succeed at the Steadfast Check for this Health Threshold, maximize your stacks of Overwhelm.

---

[passive]
# (1)
steadfast.dice += 1;
# (2) No Steadfast Check failed at or above where you are - nothing it costs.
if (threshold.failures <= 0) {
    stressBonus += 1;
}

# (3) The Steadfast Check for a Health Threshold passed (moment steadfast-passed, chat.mjs rollSteadfastCheck): Overwhelm
# at its most (Overwhelming Fighter's, 4). Automatic by default; set Triggered, asked in a window as it passes.
[triggered/steadfast-passed, effect 3]
overwhelm.stacks = 4;

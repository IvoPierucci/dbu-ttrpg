id: evolved-right-eye
name: Evolved Right Eye
order: 1
category: body
importance: primary
resource: criticaleye
resourceLabel: Critical Eye
resourceMax: 3
description: >
  A powerful evolved eye that allows Cerealians to see details that others can’t, including at a much further distance than others could possibly imagine.
text: >
  Evolved Right Eye (Body): A powerful evolved eye that allows Cerealians to see details that others can’t, including at a much further distance than others could possibly imagine.
  (1)-[Passive]: Increase your Perception Skill Checks by 2 and reduce their Critical Target by 1.
  (2)-[Passive]: Reduce the Critical Target for your Combat Rolls by 1.
  (3)-[Passive]: You cannot suffer from the Long Range Penalty.
  (4)-[Triggered, Resource]: Each time you score a Critical Result on a Combat Roll, gain a stack of Critical Eye (max. 3). When you hit an Opponent with an Attacking Maneuver, you can spend any number of Critical Eye stacks to increase the Wound Roll of that Attacking Maneuver by 2(T) for each Critical Eye stack spent.
  (5)-[Triggered, 1/Round, 2/Encounter]: After rolling your Strike Roll for an Attacking Maneuver, you may declare that it is a Critical Result regardless of the Natural Result. If your result would have been a Botch Result, it is also no longer a Botch Result.

---

[passive]
# (1)
skill.perception += 2;
skill.perception.criticalTarget -= 1;
# (2) Combat Rolls alone - a Strike, a Dodge, a Wound (chat.mjs rollSide).
criticalTarget.combat -= 1;
# (3) (maneuvers.mjs longRangePenalty).
allow longRange.ignore;
# (4) Its second half: an Opponent hit, how many stacks asked as its Wound Roll is about to be made - 2(T) on it for each
# (chat.mjs rollAttackWound).
allow criticalEye.spend;
# (5) A button on the attack's card once its Strike is rolled, before its Wound Roll: the Strike a Critical Result -
# its Critical dice rolled, any Botch gone, the hit settled again (chat.mjs declareStrikeCritical).
allow strike.declareCritical;

# (4) A Critical Result on a Combat Roll - a new moment, critical-scored (chat.mjs rollSide), the one (5) declares among
# them: a stack of Critical Eye. Automatic by default, its Triggered/Automatic button; set Triggered, asked in a window.
[triggered/critical-scored, effect 4]
criticaleye.stacks += 1;

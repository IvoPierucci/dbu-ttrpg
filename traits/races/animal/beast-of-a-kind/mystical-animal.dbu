id: mystical-animal
name: Mystical
order: 4
optionOf: beast-of-a-kind
optionEffect: 2
# "Select a Profile with 'Elemental' in the name" - asked when it is added, `$choice`.
choose: elementalProfile
description: >
  Upon gaining this effect, select a Profile with ‘Elemental’ in the name – it becomes a Favored Element (see — Favored Element).
text: >
  Mystical [Passive]: Upon gaining this effect, select a Profile with ‘Elemental’ in the name – it becomes a Favored Element (see — Favored Element).

---

[passive]
favored.$choice = true;

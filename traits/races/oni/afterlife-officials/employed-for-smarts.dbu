id: employed-for-smarts
name: Employed for Smarts
order: 5
optionOf: afterlife-officials
optionEffect: 3
description: >
  While your Scholarship Score has the highest Attribute Score among your Attributes, increase all of your Combat Rolls and Initiative by 1(bT).
text: >
  Employed for Smarts [Passive]: While your Scholarship Score has the highest Attribute Score among your Attributes, increase all of your Combat Rolls and Initiative by 1(bT).
  Employed for Smarts [Triggered, 1/Round]: When you use the Analysis Maneuver, all Allies within your Area of Rule regain Ki Points equal to 1/2 of your Scholarship Modifier. Then, you may select one willing Ally to use the Power Up Maneuver as an Out-of-Sequence Maneuver.

---

# The highest - another as high included.
[passive]
if (highestScore("scholarship")) {
    combatRolls += 1(bT);
    initiative += 1(bT);
}

# (4) The Analysis used: Ki to every Ally within your Area of Rule, then an Ally's Power Up offered out of sequence (chat.mjs employedSmarts)
# - never Automatic.
[triggered/analysis, 1/round, outOfSequence, effect 4]
employedSmarts();

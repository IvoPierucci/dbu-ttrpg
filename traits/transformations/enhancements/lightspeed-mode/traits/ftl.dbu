id: lightspeed-mode-ftl
name: FTL
order: 4
slot: mastery
mastery: 1
# Its [Permanent] effects: they hold outside the Transformation too.
permanent: 1
# (1) Its second and higher Grades gain Heartbeat (LV2) - had at every Grade here.
aspects: +Heartbeat (LV2)
description: >
  You rocket forward faster than light itself, streaking past friend and foe alike to strike at your desired target.
text: >
  FTL: You rocket forward faster than light itself, streaking past friend and foe alike to strike at your desired target.
  (1)-[Permanent]: The second and higher Grades of Lightspeed Mode gain the Heartbeat (LV2) Aspect.
  (2)-[Passive]: Increase your Wound Rolls of your Signature Techniques by 1/2 (rounded up) of G(T).
  (3)-[Passive]: Reduce the extra Damage you receive from your Grade of Lightspeed Mode by 2(bT).
  (4)-[Passive]: Your use of the Movement Maneuver while in the second or higher Grades of Lightspeed Mode does not trigger the Exploit Maneuver.
  (5)-[Triggered/Start of Turn]: If you are in the first Grade of Lightspeed Mode, regain 3(bT) Ki Points.

---

# (2) Signature Techniques' Wound 1/2 (rounded up) of G(T).
[passive, effect 2]
wound.signature += ceil($G / 2) * 1(T);

# (3) The extra Damage 2(bT) lower: in Gear Shift's. (4) No Exploit at its second Grade or higher: the table's.

# (5) In its first Grade, at the start of your turn: 3(bT) Ki Points.
[triggered/start-of-turn, effect 5]
requires $G == 1;
ki.value += 3(bT);

id: lightspeed-mode-lightspeed-assault
name: Lightspeed Assault
order: 3
slot: burst
# Its Speeds and Combat Rolls till the start of your next turn - bookkeeping, kept off the Resources list.
resource: lightspeedassault
resourceInternal: true
resourceLabel: Lightspeed Assault
resourceMax: 1
resourceDuration: true
description: >
  In a blur of motion, you close the distance between you and your target.
text: >
  Lightspeed Assault: In a blur of motion, you close the distance between you and your target.
  (1)-[Triggered/Transform]: Use the Movement Maneuver as an Out-of-Sequence Maneuver. If you do, increase your Speeds and Combat Rolls by G(T) until the start of your next turn.

---

# Burst Limit: entering it, the Movement out of sequence - and Speeds and Combat Rolls G(T) till the start of your next turn.
[passive]
if (hasResource("lightspeedassault")) {
    speed.all += $G * 1(T);
    combatRolls += $G * 1(T);
}

# Ticked with Apply effects on the entering card: the Speeds and Combat Rolls then and there, the Movement out of sequence a button on that
# card (the user's, 2026-11-21).
[triggered/transform, 1/encounter, outOfSequence, effect 1]
lightspeedassault.stacks += 1;
expires(lightspeedassault, start-of-next-turn);
offerOneOf(movement);

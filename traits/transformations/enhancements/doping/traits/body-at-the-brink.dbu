id: doping-body-at-the-brink
name: Body at the Brink
order: 1
slot: trait
description: >
  The chemicals coursing through your veins have pushed your body to its limits, giving you a strong edge against the competition.
text: >
  Body at the Brink: The chemicals coursing through your veins have pushed your body to its limits, giving you a strong edge against the competition.
  (1)-[Passive]: Reduce your Muscle Penalty by 1(bT).
  (2)-[Passive]: Increase your Wound Rolls by 1(T) for each Health Threshold you are below.
  (3)-[Passive]: Increase your Strike Rolls, Dodge Rolls, and Soak Value by 1(T) while below the Injured Health Threshold.
  (4)-[Triggered/Power, 1/Encounter]: Gain 1 Action.

---

# (1) The Muscle Penalty 1(bT) lower.
[passive, effect 1]
superStack.musclePenalty -= 1(bT);

# (2) Wound Rolls 1(T) for each Health Threshold you are below.
[passive, effect 2]
wound += threshold.depth * 1(T);

# (3) Below the Injured Health Threshold: Strike, Dodge and Soak 1(T).
[passive, effect 3]
if (belowThreshold("injured")) {
    strike += 1(T);
    dodge += 1(T);
    soakValue += 1(T);
}

# (4) Using the Power Up, once an Encounter: an Action.
[triggered/power, 1/encounter, effect 4]
actions.remaining += 1;

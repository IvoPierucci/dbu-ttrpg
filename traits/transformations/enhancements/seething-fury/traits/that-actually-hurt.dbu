id: seething-fury-that-actually-hurt
name: That Actually Hurt!
order: 1
slot: trait
replaces: Frenzied Assault
# Its [Constant] effects: a [Triggered] one that may be used outside the Transformation (the user's).
constant: 5
description: >
  You've been pushed to your absolute limit, and now your furious vengeance will tear anyone who stands before you to shreds.
text: >
  That Actually Hurt! (Frenzied Assault): You've been pushed to your absolute limit, and now your furious vengeance will tear anyone who stands before you to shreds.
  (1)-[Passive]: Increase your Wound Rolls by 1(T) for each Health Threshold you are below.
  (2)-[Passive]: While your Life Points are below 0, increase the Attribute Modifier Bonus (FO/MA) of this Transformation by 1(T).
  (3)-[Triggered, 1/Round]: If you use an Attacking Maneuver while in the 2nd or higher Level of the Raging State, increase the Damage Category of that Attacking Maneuver by 1 Category.
  (4)-[Triggered, 1/Encounter]: If you would use an Attacking Maneuver while below the Critical Health Threshold, you may apply either the All Out or Complete Annihilation Super Profile to that Attacking Maneuver.
  (5)-[Constant, Triggered/Threshold, 1/Encounter]: Use the Transformation Maneuver to enter this Transformation as an Out-of-Sequence Maneuver.

---

# (1) Wound Rolls 1(T) for each Health Threshold you are below.
[passive, effect 1]
wound += threshold.depth * 1(T);

# (2) Life Points below 0: Force and Magic Attribute Modifier Bonus 1(T).
[passive, effect 2]
if (life.value < 0) {
    force.mod += 1(T);
    magic.mod += 1(T);
}

# (3) In the Raging State's 2nd Level or higher: your Attacking Maneuvers' Damage Category 1 higher (its once a Round not counted).
[passive, effect 3]
if (states.raging >= 2) {
    attack.damageCategory.all += 1;
}

# (4) Below the Critical Health Threshold, once an Encounter: All Out or Complete Annihilation offered on an attack (use-maneuver.mjs
# grantedSuperProfile).
[passive, effect 4]
if (belowThreshold("critical")) {
    allow superProfileOffer.desperate;
}

# (5) Constant: knocked through a Health Threshold, once an Encounter - the Transformation Maneuver out of sequence, into it.
[triggered/threshold, 1/encounter, outOfSequence, effect 5]
maneuverOutOfSequence(transformation);

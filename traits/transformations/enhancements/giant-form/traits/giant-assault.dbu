id: giant-form-giant-assault
name: Giant Assault
order: 3
slot: burst
# Its Wound and Soak till the start of your next turn - bookkeeping, kept off the Resources list.
resource: giantassault
resourceInternal: true
resourceLabel: Giant Assault
resourceMax: 1
resourceDuration: true
description: >
  Your massive bulk allows you to withstand blows and dish them out with great force.
text: >
  Giant Assault: Your massive bulk allows you to withstand blows and dish them out with great force.
  (1)-[Triggered/Transform]: Increase your Wound Rolls and Soak Value by G(T) until the start of your next turn. Additionally, until the end of your turn, all of your qualifying Signature Techniques gain the Intense Blast Advantage.

---

# Burst Limit: Wound and Soak G(T) till the start of your next turn. Intense Blast on its qualifying Signature Techniques this turn: the
# table's.
[passive]
if (hasResource("giantassault")) {
    wound += $G * 1(T);
    soakValue += $G * 1(T);
}

[triggered/transform, 1/encounter, effect 1]
giantassault.stacks += 1;
expires(giantassault, start-of-next-turn);

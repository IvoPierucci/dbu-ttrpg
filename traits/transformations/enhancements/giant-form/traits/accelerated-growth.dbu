id: giant-form-accelerated-growth
name: Accelerated Growth
order: 1
slot: trait
# (2) "This Transformation gains the Armored Aspect if your Size Category is Gigantic or higher" - read as its 3rd Grade or higher
# (Growth 3, Gigantic); one Gigantic without it: the table's. Great Namekian, its Variant, the same (This).
grantsAspectTo: This = Armored if $G >= 3
description: >
  You have the ability to increase in size at will, or return to your original size.
text: >
  Accelerated Growth: You have the ability to increase in size at will, or return to your original size.
  (1)-[Passive]: Increase the Dice Category of your Punching Down Extra Dice by 1 Dice Category.
  (2)-[Passive]: This Transformation gains the Armored Aspect if your Size Category is Gigantic or higher.
  (3)-[1/Round]: If your Size Category is Enormous or higher, you may use the Sudden Stop Maneuver without spending a Counter Action.
  (4)-[Graded]: This Transformation has 3 Grades. Each Grade:
  • Increases the Stress Test Requirement by 3.
  • Increases your Growth Aspect by 1 level.
  • Sets your Attribute Modifier Bonuses as shown on the table above.

---

# (2) Armored: its header. (3) Below. (4) Its Grades: Growth G (its Aspect), its Attribute Modifier
# Bonuses G(T).

# (1) Punching Down's Extra Dice a Category higher.
[passive, effect 1]
punchingDown.category += 1;

# (3) Enormous or larger, once a Round: the Sudden Stop Maneuver without spending a Counter Action (chat.mjs payCounter).
[triggered/counter-maneuver, 1/round, effect 3]
requires counterManeuver("sudden-stop") && size.steps >= 2;
allow counter.free;

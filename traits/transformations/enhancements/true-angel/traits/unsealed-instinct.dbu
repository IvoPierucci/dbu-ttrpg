id: true-angel-unsealed-instinct
name: Unsealed Instinct
order: 2
slot: burst
# Activated: True Angel Linked to Autonomous Ultra Instinct for the rest of it - bookkeeping, kept off the Resources list.
resource: unsealed
resourceInternal: true
resourceLabel: Unsealed Instinct
resourceMax: 1
resourceDuration: true
grantsAspectTo: This = Linked (Autonomous Ultra Instinct) if unsealed.stacks >= 1
description: >
  No longer holding back, you tap into the angelic power of Autonomous Ultra Instinct.
text: >
  Unsealed Instinct: No longer holding back, you tap into the angelic power of Autonomous Ultra Instinct.
  (1)-[Triggered/Transform]: True Angel gains the Linked (Autonomous Ultra Instinct) Aspect and triggers its effects. Additionally, you have access to Autonomous Ultra Instinct while in the True Angel Transformation.

---

# Burst Limit, ticked with Apply effects on the entering card: True Angel Linked (Autonomous Ultra Instinct) - entered beside it, any
# other Enhancement left, no Stress Test; had while in True Angel where it is not had (chat.mjs enterLinked), taken back as True Angel is
# left. Kept for the Encounter (True Angel left, its (8) erases you anyway).
[triggered/transform, 1/encounter, effect 1]
unsealed.stacks += 1;
expires(unsealed, encounter);
enterLinked(autonomous-ultra-instinct);

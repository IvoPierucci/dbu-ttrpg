id: kaioken-crimson-sacrifice
name: Crimson Sacrifice
order: 2
slot: trait
description: >
  By burning away your life force, you turn that energy into pure power.
text: >
  Crimson Sacrifice: By burning away your life force, you turn that energy into pure power.
  (1)-[Passive]: You cannot regain Life Points.
  (2)-[Passive]: You do not suffer from Reduced Momentum if you are knocked through a Health Threshold due to paying the Life Point Cost of Kaioken.
  (3)-[Passive]: If you are using Kaioken in conjunction with a Form or Transcended Enhancement that does not possess the Perfect Ki Control Aspect, increase the Life Point Cost by 2(bT).
  (4)-[Triggered]: If you lose Life Points due to paying Kaioken's Life Point Cost, regain G(bT) Ki Points.
  (5)-[Triggered, 1/Encounter]: If you use an Ultimate Signature Technique, apply your Kaioken Dice an additional time to the Strike and Wound Roll of that Attacking Maneuver. Additionally, increase the Wound Roll of that Attacking Maneuver by G(T).

---

# (1) No Life Points regained (combat.mjs). (2) No Reduced Momentum from paying it: none is given for it (it is paid by this effect, not
# as a Life Wager or Damage of your own).
[passive, effect 1]
allow life.noRegain;

# Its Grade's Life Point Cost, paid as any Attacking Maneuver is declared (the user's: charged by itself) - G+1 (bT), 1(bT) less once
# Mastered (Deep Red (4)) - and (4) G(bT) Ki Points for it.
[automatic/declare-maneuver, effect 4]
requires attackingManeuver;
life.value -= ($G + 1 - min($M, 1)) * 1(bT);
ki.value += $G * 1(bT);
# (3) Beside a Form or Transcended Enhancement without the Perfect Ki Control Aspect: 2(bT) more.
if (inFormOrTranscended && !aspectInUse("perfect-ki-control")) {
    life.value -= 2(bT);
}

# (5) An Ultimate Signature Technique, once an Encounter: the Kaioken Dice again on its Strike and Wound Rolls, and G(T) on its Wound -
# offered as it is declared (use-maneuver.mjs momentDice).
[triggered/declare-maneuver, 1/encounter, effect 5]
requires usingUltimate;
if (($G == 2) || ($G == 3)) {
    attack.strikeDice += 1d4;
    attack.woundDice += 1d4;
}
if ($G == 4) {
    attack.strikeDice += 1d6;
    attack.woundDice += 1d6;
}
if ($G == 5) {
    attack.strikeDice += 1d8;
    attack.woundDice += 1d8;
}
if ($G == 6) {
    attack.strikeDice += 1d10;
    attack.woundDice += 1d10;
}
attack.woundAdd += $G * 1(T);

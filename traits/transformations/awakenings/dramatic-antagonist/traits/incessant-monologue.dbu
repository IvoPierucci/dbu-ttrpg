id: dramatic-antagonist-incessant-monologue
name: Incessant Monologue
order: 1
slot: trait
description: >
  Make this Adversary truly detestable by simply having them never. Shut. Up.
text: >
  Incessant Monologue: Make this Adversary truly detestable by simply having them never. Shut. Up.
  (1)-[Passive]: Increase your Surgency and Soak Value by 1(T).
  (2)-[Passive]: Increase the amount of Life and Ki Points you regain from Combat Recovery by 1/2 of your Surgency.
  (3)-[Passive]: You gain access to the Sinful Soliloquy Villainous Maneuver.
  (4)-[Triggered/Start of Combat Round]: If no Opponent is within a Large Sphere AoE (centered on you), you may use Combat Recovery (as if you spent 2 Actions) as an Out-of-Sequence Maneuver.
  (5)-[Triggered, PCC/Encounter]: If you defeat an Opponent with an Attacking Maneuver, regain your use of the Sinful Soliloquy Villainous Maneuver.
  (6)-[Triggered/Start of Combat Encounter]: Use the Sinful Soliloquy Villainous Maneuver as an Out-of-Sequence Maneuver.

---

# (1) Surgency and Soak Value 1(T).
[passive, effect 1]
surgency += 1(T);
soakValue += 1(T);

# (2) Combat Recovery's Life and Ki raised by 1/2 of your Surgency (traits/maneuvers/combat-recovery.dbu).
[passive, effect 2]
allow combatRecovery.halfSurgency;

# (3) Sinful Soliloquy, opened.
[passive, effect 3]
allow maneuver.sinful-soliloquy;

# (4) No Opponent in a Large Sphere on you: Combat Recovery as if 2 Actions were spent, out of sequence.
[triggered/start-of-round, outOfSequence, effect 4]
requires !opponentWithin("large");
maneuverOutOfSequence(combat-recovery);

# (5) PCC an Encounter, Defeating an Opponent: Sinful Soliloquy's use back - its 1/Encounter one more (sinful-soliloquy.uses).
[triggered/defeat-opponent, $PCC/encounter, effect 5]
sinful-soliloquy.uses += 1;

# (6) The Encounter beginning: Sinful Soliloquy out of sequence.
[triggered/start-of-encounter, outOfSequence, effect 6]
maneuverOutOfSequence(sinful-soliloquy);

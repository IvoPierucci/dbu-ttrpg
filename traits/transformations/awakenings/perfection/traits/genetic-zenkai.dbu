id: perfection-genetic-zenkai
name: Genetic Zenkai
order: 4
slot: trait
# One of these is chosen (the Transformation's row asks).
group: perfect-traits
groupLabel: Perfect Traits
# The 2nd effect's Tier of Power +1 till the end of your next turn - bookkeeping, kept off the Resources list.
resource: geneticzenkai
resourceInternal: true
resourceLabel: Genetic Zenkai
resourceMax: 1
description: >
  Brought back from the brink of death, your power grows beyond measure.
text: >
  Genetic Zenkai: Brought back from the brink of death, your power grows beyond measure.
  (1)-[Passive]: While you are below the Injured Health Threshold, increase your Wound Rolls and Soak Value by 1(T).
  (2)-[Triggered, 1/Encounter]: If you have used a [Triggered/Defeated] effect this Combat Encounter and are not Defeated after its use, increase your Tier of Power by 1 (see — Breakthrough) until the end of your next turn.

---

# (1) Below the Injured Health Threshold: Wound and Soak 1(T).
[passive, effect 1]
if (belowThreshold("injured")) {
    wound += 1(T);
    soakValue += 1(T);
}
# (2) A Triggered/Defeated effect used and not Defeated after it (defeat-escaped), once an Encounter: Tier of Power +1 (Breakthrough,
# its cap still over it) until the end of your next turn.
[passive]
if (hasResource("geneticzenkai")) {
    tierOfPower += 1;
}

[triggered/defeat-escaped, 1/encounter, effect 2]
geneticzenkai.stacks += 1;
expires(geneticzenkai, next-turn);

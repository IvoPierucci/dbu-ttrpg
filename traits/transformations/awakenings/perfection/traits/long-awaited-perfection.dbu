id: perfection-long-awaited-perfection
name: Long-Awaited Perfection
order: 2
slot: trait
stacks: 2
description: >
  You have become a being of resplendent perfection.
text: >
  Long-Awaited Perfection (2): You have become a being of resplendent perfection.
  (1)-[Passive]: Increase your Maximum Life Points and Maximum Ki Points by 2 for each Power Level reached.
  (2)-[Passive]: Reduce the Critical Target of your Combat Rolls by 1.
  (3)-[Triggered/Start of Turn]: Gain 1 Adaptation Point.
  (4)-[Triggered/Start of Turn, 1/Encounter]: You may spend 3 Adaptation Points to gain 1 Action.

---

# (1) 2 Maximum Life and Ki Points a Power Level.
[passive, effect 1]
life.perLevel += 2;
ki.perLevel += 2;

# (2) The Critical Target of your Combat Rolls 1 lower.
[passive, effect 2]
criticalTarget.strike -= 1;
criticalTarget.dodge -= 1;
criticalTarget.wound -= 1;

# (3) At the start of your turn, an Adaptation Point.
[triggered/start-of-turn, effect 3]
adaptation.stacks += 1;

# (4) At the start of your turn, once an Encounter: 3 Adaptation Points for an Action.
[triggered/start-of-turn, 1/encounter, effect 4]
requires stacksAtLeast(3, "adaptation");
adaptation.stacks -= 3;
actions.remaining += 1;

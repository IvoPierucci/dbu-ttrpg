id: perfection-critical-perfection
name: Critical Perfection
order: 3
slot: trait
# One of these is chosen (the Transformation's row asks).
group: perfect-traits
groupLabel: Perfect Traits
description: >
  You strike your enemies' weak points with perfect efficacy.
text: >
  Critical Perfection: You strike your enemies' weak points with perfect efficacy.
  (1)-[Passive]: Increase the Dice Score of any Combat Roll that you score a Critical Result on by 1(T).
  (2)-[Triggered, 1/Round]: If you roll a Combat Roll, you may increase the Natural Result of that Combat Roll by 1 after seeing the Natural Result.

---

# (1) A Combat Roll that scores a Critical Result: its Dice Score 1(T) higher (chat.mjs rollSide).
[passive, effect 1]
critical.rollBonus += 1(T);

# (2) Once a Round, a Combat Roll's Natural Result 1 higher after seeing it - offered on the attack's card (chat.mjs NUDGERS).
[passive, effect 2]
combatRoll.naturalUp += 1;

id: perfection-perfect-guard
name: Perfect Guard
order: 8
slot: trait
# One of these is chosen (the Transformation's row asks).
group: perfect-traits
groupLabel: Perfect Traits
description: >
  Your sturdy build grows tougher to damage the longer you fight.
text: >
  Perfect Guard: Your sturdy build grows tougher to damage the longer you fight.
  (1)-[Passive]: Increase your Soak Value by 1(T).
  (2)-[Triggered, 1/Encounter]: If you use the Direct Hit or Guard option of the Defend Maneuver, increase your Damage Reduction by 1/2 of your Soak Value (before modification due to the effects of the Defend Maneuver) for the duration of that Maneuver.

---

# (1) Soak Value 1(T).
[passive, effect 1]
soakValue += 1(T);
# (2) Direct Hit or Guard, once an Encounter: Damage Reduction 1/2 of your Soak Value (as it was before the Defend changed it), rounded
# down, for that attack - ticked in Respond as you Defend.
[triggered/guard-or-direct-hit, 1/encounter, chosen, effect 2]
damageReduction += floor(soakValue / 2);

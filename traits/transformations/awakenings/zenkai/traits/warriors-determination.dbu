id: zenkai-warriors-determination
name: Warrior's Determination
order: 2
slot: trait
stacks: 2
description: >
  Your fierce determination keeps you in the fight long past when others would fall.
text: >
  Warrior's Determination (2): Your fierce determination keeps you in the fight long past when others would fall.
  (1)-[Passive]: While you possess 4+ stacks of Battle Born, increase your Surgency by Z(T).
  (2)-[Triggered, 1/Encounter]: If you use an Ultimate Signature Technique while in the Undying State, apply Z Energy Charges to that Attacking Maneuver.

---

# (1) 4+ stacks of Battle Born: Surgency Z(T).
[passive, effect 1]
if (stacksAtLeast(4, "battlebornstrike", "battleborndodge", "battlebornwound")) {
    surgency += $Z * 1(T);
}

# (2) An Ultimate Signature Technique used in the Undying State, once an Encounter: Z Energy Charges on it - offered as it is declared.
[triggered/declare-maneuver, 1/encounter, effect 2]
requires usingUltimate && inState("undying");
attack.energyCharges += $Z;

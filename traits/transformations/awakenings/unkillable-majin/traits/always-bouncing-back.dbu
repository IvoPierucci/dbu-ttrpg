id: unkillable-majin-always-bouncing-back
name: Always Bouncing Back
order: 1
slot: trait
description: >
  You never stay down for very long, thanks to your indestructible physiology.
text: >
  Always Bouncing Back: You never stay down for very long, thanks to your indestructible physiology.
  (1)-[Passive]: Increase your Stress Bonus by 1.
  (2)-[Passive]: Increase your Surgency by 2(T).
  (3)-[Passive]: While you are above the Injured Health Threshold, increase your Soak Value and Defense Value by 1(T).
  (4)-[Passive]: While you are in the Healthy Health Threshold, all Collision Damage you’d receive is reduced to 0.
  (5)-[Passive]: The 3rd effect of Majin Regeneration and 3rd effect of From Goop becomes an Instant Maneuver, but you must still spend 1 Action to use the effect.
  (6)-[Triggered, 1/Encounter]: If you use a Healing Surge, after concluding that Maneuver, you may use the Basic Attack Maneuver as an Out-of-Sequence Maneuver.

---

# (1) Stress Bonus 1.
[passive, effect 1]
stressBonus += 1;

# (2) Surgency 2(T).
[passive, effect 2]
surgency += 2(T);

# (3) Above the Injured Health Threshold: Soak Value and Defense Value 1(T).
[passive, effect 3]
if (!belowThreshold("injured")) {
    soakValue += 1(T);
    defenseValue += 1(T);
}

# (4) In the Healthy Health Threshold: no Collision Damage (chat.mjs collisionAmount, Full Metal Body (2)'s flag).
[passive, effect 4]
if (!belowThreshold("bruised")) {
    allow fullMetal.noCollision;
}

# (5) Majin Regeneration (3) and From Goop (3) as Instant Maneuvers, still 1 Action: each its own Instant (maneuvers/), which uses that effect
# out of sequence - open while the Trait that has it is held (Pure Form's Erratic Majin (5) way).
[passive, effect 5]
if (holdsTrait("majin-regeneration")) {
    allow maneuver.unkillable-majin-regeneration;
}
if (holdsTrait("from-goop")) {
    allow maneuver.unkillable-majin-from-goop;
}

# (6) A Healing Surge used, once an Encounter: the Basic Attack out of sequence after it - asked, never Automatic.
[triggered/healing-surge, 1/encounter, outOfSequence, effect 6]
maneuverOutOfSequence(basic-attack);

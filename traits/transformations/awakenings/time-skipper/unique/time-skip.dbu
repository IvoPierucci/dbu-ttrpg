id: time-skip
name: Time-Skip
uaType: technical
prerequisite: Time Skipper Awakening
tpCost: 0
type: instant
actionCost: 0
kiCostPerTier: 4
# Once a Round (my reading: Barrage From Time's "an additional time per Combat Round"), twice with it (its extraUses).
usageLimit: 1/round
# The Movement or the Basic Attack out of sequence - or a Time-Skipped Signature Technique with Time to Make the Donuts - with what Beyond
# the Time and Imperceptible Strike add (chat.mjs timeSkip).
source: Time-Skipper
description: >
  The Movement or the Basic Attack Maneuver, out of sequence.
text: >
  Time-Skip — You can force your way past a point in time, effectively acting outside of that point in time to perform your task immediately.
  –Ability Type: Technical –Prerequisites: Time Skipper Awakening –TP Cost: N/A –KP Cost: 4(T) –Maneuver Type: Instant –Action Cost: N/A –Minions: N/A –Passive Bonus: N/A
  –Effect: You may either:
  • Use the Movement Maneuver as an Out-of-Sequence Maneuver.
  • Use the Basic Attack Maneuver as an Out-of-Sequence Maneuver.

---

[on used]
timeSkip();

# Walk Through Time, Time Shift, Time Restraint: their Special Maneuvers (Time-Skipper's maneuvers/).
[passive]
if (hasAdvancement("walk-through-time")) {
    allow maneuver.tides-of-time;
}
if (hasAdvancement("time-shift")) {
    allow maneuver.time-lag;
}
if (hasAdvancement("time-restraint")) {
    allow maneuver.time-prison;
}

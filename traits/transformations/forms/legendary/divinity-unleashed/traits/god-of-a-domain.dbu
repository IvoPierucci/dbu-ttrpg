id: divinity-unleashed-god-of-a-domain
name: God of a Domain
order: 15
slot: legendary
description: >
  You rise to godly power, giving you control over some aspect of reality, a divine Domain.
text: >
  God of a Domain: You rise to godly power, giving you control over some aspect of reality, a divine Domain.
  (1)-[Ruling]: Your choice for the 3rd effect of Divine Magic is known as your 'Domain'.
  (2)-[Passive]: Increase your maximum number of Divine Ki Points by 1/2.
  (3)-[Passive, Ruling]: Gain access to a Domain Maneuver, to gain access to a Domain Maneuver, your Domain must be in brackets after the name of that Domain Maneuver. All Domain Maneuvers are God Maneuvers.

---

# (1) The Domain: Divine Magic (3)'s Option.

# (2) Maximum Divine Ki Points half again.
[passive, effect 2]
allow divineKi.halfMore;

# (3) The Domain Maneuver whose Domain is yours - a God Maneuver (maneuvers/).
[passive, effect 3]
if (holdsTrait("god-of-peace")) {
    allow maneuver.divine-peace;
}
if (holdsTrait("god-of-judgment")) {
    allow maneuver.divine-judgement;
}
if (holdsTrait("god-of-power")) {
    allow maneuver.divine-muscle;
}
if (holdsTrait("god-of-survival")) {
    allow maneuver.divine-healing;
}
if (holdsTrait("god-of-wisdom")) {
    allow maneuver.divine-wisdom;
}
if (holdsTrait("god-of-war")) {
    allow maneuver.divine-weapon;
}
if (holdsTrait("god-of-magic")) {
    allow maneuver.divine-spell;
}
if (holdsTrait("god-of-many")) {
    allow maneuver.divine-summoning;
}
if (holdsTrait("god-of-time")) {
    allow maneuver.freeze-attack;
}
if (holdsTrait("god-of-an-element")) {
    allow maneuver.divine-element;
}

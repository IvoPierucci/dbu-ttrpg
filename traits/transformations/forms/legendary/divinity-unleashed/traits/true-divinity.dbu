id: divinity-unleashed-true-divinity
name: True Divinity
order: 14
slot: mastery
mastery: 2
# Its [Permanent] effects: they hold outside the Transformation too.
permanent: 1
# (1) Perfect Ki Control.
aspects: +Perfect Ki Control
description: >
  Your divine might surpasses even the greatest of godly beings and transcends all known limits of power.
text: >
  True Divinity (2): Your divine might surpasses even the greatest of godly beings and transcends all known limits of power.
  (1)-[Permanent]: Divinity Unleashed gains the Perfect Ki Control Aspect.
  (2)-[Passive]: You may spend your Counter Actions as if they were Actions for Combat Recovery.
  (3)-[Triggered, 1/Encounter]: If you spend 3 Counter Actions in a Combat Round, upon spending that final Counter Action, regain Divine Ki Points equal to your Surgency.

---

# (1) Its header.

# (2) Counter Actions spent as Actions for Combat Recovery - how many, asked as it is paid (use-maneuver.mjs payActions).
[passive, effect 2]
allow combatRecovery.counterActions;

# (3) The third Counter Action spent in a Combat Round, once an Encounter: Divine Ki Points equal to your Surgency.
[triggered/counter-spent, 1/encounter, effect 3]
requires counterReached(3);
divineKi.value += surgency;

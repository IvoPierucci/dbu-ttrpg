id: divinity-unleashed-true-god-of-peace
name: True God of Peace
order: 3
slot: trait
# One of these is chosen (the Transformation's row asks).
group: domain-traits
groupLabel: Domain Traits
# Its [Permanent] effects: they hold outside the Transformation too.
permanent: 2
# (2) Innate State (Mindful) and Mindful.
aspects: +Innate State (Mindful), +Mindful
description: >
  Guided by wisdom and seeking prosperity, you avoid conflict and attempt amicable resolutions.
text: >
  True God of Peace: Guided by wisdom and seeking prosperity, you avoid conflict and attempt amicable resolutions.
  (1)-[Prerequisite]: Access to the God of Peace effect for the Option effect of Divine Magic.
  (2)-[Permanent]: Divinity Unleashed gains the Innate State (Mindful) and Mindful Aspects.
  (3)-[Ruling]: For the effects of True God of Peace, 'L' is equal to your current level of the Mindful State.
  (4)-[Passive]: Ignore the 2nd effect of the Mindful State.
  (5)-[Passive]: Increase your Strike and Dodge Rolls by L(T).
  (6)-[Passive]: Reduce the Divine Ki Point Cost of the Divine Peace God Maneuver by L(T).
  (7)-[Automatic]: If you fail a Steadfast Check, or the Combat Round ends without you having used Combat Recovery, set your level of the Mindful State to Calm.
  (8)-[Triggered, 1/Round]: If you use Combat Recovery, enter the next level of the Mindful State while you are in this Transformation.

---

# (3) L: your level of the Mindful State (`states.mindful`).

# (4) The Mindful State's 2nd effect ignored - its L(T) off your Wound Rolls given back. (5) Strike and Dodge L(T).
[passive, effect 4]
if (inState("mindful")) {
    wound += states.mindful * 1(T);
}

[passive, effect 5]
if (inState("mindful")) {
    strike += states.mindful * 1(T);
    dodge += states.mindful * 1(T);
}

# (6) Divine Peace's Divine Ki Point Cost L(T) lower (chat.mjs playDivinePeace).
[passive, effect 6]
divinePeace.costOff += states.mindful * 1(T);

# (7) A Steadfast Check failed, or the Combat Round over with no Combat Recovery: the Mindful State back to Calm.
[automatic/steadfast-failed, effect 7]
requires inState("mindful");
setStateLevel(mindful, 1);

[automatic/end-of-round, effect 7]
requires inState("mindful") && !usedThisRound("combat-recovery");
setStateLevel(mindful, 1);

# (8) Combat Recovery, once a Round: the next level of the Mindful State.
[triggered/declare-maneuver, 1/round, effect 8]
requires using("combat-recovery");
enterState(mindful, 1);

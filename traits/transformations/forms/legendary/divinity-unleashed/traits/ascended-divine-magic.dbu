id: divinity-unleashed-ascended-divine-magic
name: Ascended Divine Magic
order: 2
slot: trait
# Its [Permanent] effects: they hold outside the Transformation too.
permanent: 1, 2
# (1) A Domain Trait: chosen on this Transformation's row. (2) Its Size, asked as it is gained.
choose: list
choices: Small, Medium, Large
description: >
  Your holy magic grows in strength, empowered by divine energy.
text: >
  Ascended Divine Magic: Your holy magic grows in strength, empowered by divine energy.
  (1)-[Permanent, Passive]: Upon gaining access to Divinity Unleashed, select a Domain Trait. You have access to that Domain Trait while in Divinity Unleashed.
  (2)-[Permanent, Passive]: Upon gaining access to this Transformation, select a Size Category (Small, Medium or Large). You become that Size Category while in this Transformation.
  (3)-[Passive]: Increase your Might and Saving Throws by 1(T) for the duration of any Clash initiated by an Opponent.
  (4)-[Passive]: Increase the Skill Bonus of your Knowledge, Creature Handling, Clairvoyance, Perception, Use Magic, and Investigation Skills by 2.

---

# (2) The Size chosen.
[passive, effect 2]
allow size.base.$choice;

# (3) A Clash an Opponent opened at you: your Might and Saving Throws 1(T) (chat.mjs vsOpponentClashBonus).
[passive, effect 3]
clash.vsOpponent += 1(T);

# (4) Knowledge, Creature Handling, Clairvoyance, Perception, Use Magic and Investigation 2 higher.
[passive, effect 4]
skills.family.knowledge += 2;
skill.creatureHandling += 2;
skill.clairvoyance += 2;
skill.perception += 2;
skill.useMagic += 2;
skill.investigation += 2;

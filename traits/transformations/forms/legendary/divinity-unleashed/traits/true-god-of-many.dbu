id: divinity-unleashed-true-god-of-many
name: True God of Many
order: 10
slot: trait
# One of these is chosen (the Transformation's row asks).
group: domain-traits
groupLabel: Domain Traits
description: >
  Charismatic and sociable, you are a divine leader of others, imbuing your subordinates with heavenly might.
text: >
  True God of Many: Charismatic and sociable, you are a divine leader of others, imbuing your subordinates with heavenly might.
  (1)-[Prerequisite]: Access to the God of Many effect for the Option effect of Divine Magic.
  (2)-[Passive]: Increase the Combat Rolls and Soak Value of your Minions by 1(T).
  (3)-[Passive]: Your Minions gain double the bonus from the 3rd effect of Divine Role.
  (4)-[Passive]: While you are in the Spectator State, increase your Soak Value and Damage Reduction by 2(T).
  (5)-[Passive]: Your Minions may spend your Counter Actions as if they were their own.
  (6)-[Triggered, 1/Encounter]: If you use the Divine Summoning God Maneuver, any Minions moved by this effect may use the Power Up Maneuver as an Out-of-Sequence Maneuver (this occurs before any Exploit Maneuvers are triggered).

---

# (2) Your Minions' Combat Rolls and Soak Value 1(T).
[passive, effect 2]
minions.combatRolls += 1(T);
minions.soakValue += 1(T);

# (3) Your Minions double Divine Role (3)'s: its 1(T) on their Combat Rolls once more.
[passive, effect 3]
minions.combatRolls += 1(T);

# (4) In the Spectator State: Soak Value and Damage Reduction 2(T).
[passive, effect 4]
if (inState("spectator")) {
    soakValue += 2(T);
    damageReduction += 2(T);
}

# (5) Your Minions spend your Counter Actions as their own where theirs are short (combat.mjs spendActions). (6) Divine Summoning's Power Up.
[passive, effect 5]
allow minions.shareCounter;

[passive, effect 6]
allow summoning.powerUp;

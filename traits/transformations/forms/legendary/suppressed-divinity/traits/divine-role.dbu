id: suppressed-divinity-divine-role
name: Divine Role
order: 1
slot: trait
# Its [Permanent] effects: they hold outside the Transformation too.
permanent: 1
# (1) Two God Maneuvers, asked as it is gained; (2) its Unique Abilities, given with it.
choose: godManeuver
choose2: godManeuver
grantsUnique: injury-transfer, space-time-connection
description: >
  Granted dominion over an aspect of reality, you now stand tall as a true deity in your own right.
text: >
  Divine Role: Granted dominion over an aspect of reality, you now stand tall as a true deity in your own right.
  (1)-[Permanent, Passive]: Upon gaining access to Suppressed Divinity, select 2 God Maneuvers. You have access to those God Maneuvers while in any Transformation of the Appointed God Transformation Line.
  (2)-[Passive]: You gain access to the Injury Transfer and Space-Time Connection Unique Abilities.
  (3)-[Passive]: Increase the Combat Rolls of all Allies within a Large Sphere AoE (centered on you) by 1(T). If you have no Allies within this AoE, instead increase your Wound Rolls and Soak Value by 1(T).
  (4)-[Triggered]: If you use Combat Recovery, all Allies within a Large Sphere AoE (centered on you) regain Ki Points equal to 1/2 of your Surgency.
  (5)-[Triggered/Power, 1/Round]: If you have no Allies within a Large Sphere AoE (centered on you) and you have not used Combat Recovery this Combat Round, you may use the Basic Attack Maneuver as an Out-of-Sequence Maneuver. If you use this effect, you cannot use Combat Recovery during this Combat Round.

---

# (1) The two God Maneuvers chosen, open while it is had.
[passive, effect 1]
# [Permanent]: kept outside it - what it gives, only while in it (the user's, 2026-11-21).
if (inTransformation("suppressed-divinity") || inTransformation("divinity-unleashed")) {
    allow maneuver.$choice;
    allow maneuver.$choice2;
}

# (3) Allies within a Large Sphere AoE centered on you: Combat Rolls 1(T) (actor-character.mjs allyRolls) - Huge in Divinity Unleashed
# (Cosmic Flow (2), which writes this effect's other half there). None within it: your Wound Rolls and Soak 1(T).
[passive, effect 3]
allow divineRole.aura;
if (!alliesNear(3) && !inTransformation("divinity-unleashed")) {
    wound += 1(T);
    soakValue += 1(T);
}

# (4) Combat Recovery used: every Ally within a Large Sphere AoE, Ki Points 1/2 of your Surgency (chat.mjs kiToAlliesNear).
[triggered/declare-maneuver, effect 4]
requires using("combat-recovery");
kiToAlliesNear(3);

# (5) The Power Up, once a Round, no Ally within a Large Sphere AoE and no Combat Recovery this Round: the Basic Attack out of sequence -
# no Combat Recovery this Round once it is made.
[triggered/power, 1/round, outOfSequence, effect 5]
requires !alliesNear(3) && !usedThisRound("combat-recovery");
basicStrikeNoRecovery();

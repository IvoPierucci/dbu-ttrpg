id: full-power-super-saiyan-superior-pain-superior-power
name: >
  Superior Pain, Superior Power
order: 6
slot: trait
# One of these is chosen (the Transformation's row asks).
group: super-saiyan-style-traits
groupLabel: Super Saiyan Style Traits
description: >
  Through your tireless efforts, you've transformed the golden flames you've awakened, creating an even more superior state.
text: >
  Superior Pain, Superior Power: Through your tireless efforts, you've transformed the golden flames you've awakened, creating an even more superior state.
  (1)-[Prerequisite]: Access to Superior Super Saiyan.
  (2)-[Passive]: For every 4 stacks of Battle Born you possess, increase your Surgency by 1(T) (max. 3(T)).
  (3)-[Triggered]: If you are hit by an Attacking Maneuver, regain Ki Points equal to 1/4 (rounded up) of your Surgency.
  (4)-[Triggered/Power, 1/Round]: Spend a stack of Battle Born to regain Life Points equal to 1/2 of your Surgency and enter the Superior State until the end of your turn.

---

# (2) Surgency 1(T) for every 4 stacks of Battle Born (max. 3(T)).
[passive, effect 2]
surgency += min(3, floor((battlebornstrike.stacks + battleborndodge.stacks + battlebornwound.stacks) / 4)) * 1(T);

# (3) Hit by an Attacking Maneuver - Damage taken or not: Ki Points 1/4 (rounded up) of your Surgency.
[triggered/opponent-damage, effect 3]
ki.value += ceil(surgency / 4);

[triggered/hit-unharmed, effect 3]
ki.value += ceil(surgency / 4);

# (4) The Power Up, once a Round: a stack of Battle Born spent - Life Points 1/2 of your Surgency, Superior till the end of your turn.
[triggered/power, 1/round, effect 4]
requires max(0, battlebornstrike.stacks + battleborndodge.stacks + battlebornwound.stacks) >= 1;
life.value += floor(surgency / 2);
enterState(superior, 1, turn);
spendBattleBorn();

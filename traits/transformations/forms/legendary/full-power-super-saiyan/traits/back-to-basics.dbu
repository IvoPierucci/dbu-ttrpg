id: full-power-super-saiyan-back-to-basics
name: Back to Basics
order: 4
slot: trait
# One of these is chosen (the Transformation's row asks).
group: super-saiyan-style-traits
groupLabel: Super Saiyan Style Traits
# (2) "You gain access to the Option effect you chose for the 3rd effect of S-Cells."
keepsEffect: super-saiyan-1-s-cells 3
description: >
  You have no need for those inefficient evolutions of the Super Saiyan form; when properly mastered, the basic Super Saiyan far outclasses them.
text: >
  Back to Basics: You have no need for those inefficient evolutions of the Super Saiyan form; when properly mastered, the basic Super Saiyan far outclasses them.
  (1)-[Prerequisite]: Access to Super Saiyan 1. Variants do not count as Super Saiyan 1 for this effect.
  (2)-[Passive]: You gain access to the Option effect you chose for the 3rd effect of S-Cells.
  (3)-[1/Round]: While you have 4+ stacks of Battle Born, you may use the Power Up Maneuver as an Instant Maneuver.
  (4)-[Passive]: Depending on your number of Power stacks, gain access to the following effects:
  • 2+ Power Stacks [Triggered, 1/Round]: When making an Attacking Maneuver, you can add up to 2 Energy Charges to that Attacking Maneuver. After concluding that Attacking Maneuver, lose a number of Battle Born stacks equal to the amount of Energy Charges added by this effect.

---

# (2) S-Cells (3)'s Option chosen, its effects outside Super Saiyan 1 too: its header's keepsEffect (transformations.mjs effectsOutside).

# (3) With 4+ stacks of Battle Born: the Power Up as an Instant, once a Round - its own Maneuver (maneuvers/).
[passive, effect 3]
if (max(0, battlebornstrike.stacks + battleborndodge.stacks + battlebornwound.stacks) >= 4) {
    allow maneuver.back-to-basics-power-up;
}

# (4) 2+ stacks of Power, once a Round: up to 2 Energy Charges, as many stacks of Battle Born lost - two where 2+ are held, one where one is.
[triggered/declare-maneuver, 1/round, effect 4]
requires attackingManeuver && power.stacks >= 2 && max(0, battlebornstrike.stacks + battleborndodge.stacks + battlebornwound.stacks) >= 2;
attack.energyCharges += 2;
oweBattleBorn(2);

[triggered/declare-maneuver, 1/round, effect 4]
requires attackingManeuver && power.stacks >= 2 && max(0, battlebornstrike.stacks + battleborndodge.stacks + battlebornwound.stacks) == 1;
attack.energyCharges += 1;
oweBattleBorn(1);

# 4+: a Signature Technique with a Ki Wager - half the Ki
# Points wagered on its Wound Roll.
[passive, effect 4]
if (power.stacks >= 4) {
    allow wound.halfWagerSignature;
}

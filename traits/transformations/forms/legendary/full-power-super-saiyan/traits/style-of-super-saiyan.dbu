id: full-power-super-saiyan-style-of-super-saiyan
name: Style of Super Saiyan
order: 1
slot: trait
# Its [Permanent] effects: they hold outside the Transformation too.
permanent: 1
description: >
  You've grown comfortable enough with your Super Saiyan power to customize it to meet your needs.
text: >
  Style of Super Saiyan: You've grown comfortable enough with your Super Saiyan power to customize it to meet your needs.
  (1)-[Permanent, Ruling]: Upon gaining access to this Transformation, select and gain access to a 'Super Saiyan Style' Trait while you are in this Transformation.
  (2)-[Passive]: For each stack of Power you possess, increase your Soak Value by 1(T).
  (3)-[Passive]: Gain an additional stack of Power from the Power Up Maneuver.
  (4)-[Passive]: Increase your Combat Rolls by 1/2 (rounded up) of the Apparel Bonus for the piece of Apparel destroyed through the Bursting Aspect upon entering this Transformation.
  (5)-[Triggered/Power, 1/Encounter]: Gain a stack of Battle Born.

---

# (1) A Super Saiyan Style Trait: chosen on this Transformation's row.

# (2) Soak Value 1(T) a stack of Power.
[passive, effect 2]
soakValue += power.stacks * 1(T);

# (3) A stack more of Power with the Power Up, where there is room for it.
[automatic/power, effect 3]
requires roomFor("power");
power.stacks += 1;
expires(power, next-turn);

# (4) Combat Rolls by half (rounded up) the Apparel Bonus of the piece Bursting destroyed as it was entered (its row's burstBonus).
[passive, effect 4]
combatRolls += ceil($row.burstBonus / 2);

# (5) With the Power Up, once an Encounter: a stack of Battle Born.
[triggered/power, 1/encounter, effect 5]
gainOneOf(battlebornstrike, battleborndodge, battlebornwound);

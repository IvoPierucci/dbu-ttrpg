id: full-power-super-saiyan-all-out-super-saiyan
name: All-Out Super Saiyan
order: 9
slot: trait
# One of these is chosen (the Transformation's row asks).
group: super-saiyan-style-traits
groupLabel: Super Saiyan Style Traits
# (2) All-Out Power, three at most - lost with the Encounter, as every Resource is.
resource: allout
resourceLabel: All-Out Power
resourceMax: 3
# (3) "treated as a stack of Power for all of your effects".
stacksCountAs: allout = power
# (4) "For each stack of All-Out Power you possess, this Transformation gains a level of the Draining Aspect."
grantsAspectTo: This = Draining (LV1) if allout.stacks >= 1; This = Draining (LV1) if allout.stacks >= 2; This = Draining (LV1) if allout.stacks >= 3
description: >
  T
text: >
  All-Out Super Saiyan: T
  (1)-[Prerequisite]: Access to All-Out Form
  (2)-[Automatic/Transform, Resource]: Lose all stacks of Holding Back and gain a stack of 'All-Out Power' (max. 3).
  (3)-[Passive]: Each stack of All-Out Power increases your Combat Rolls by 1(T), your Tier of Power Extra Dice by 1 Dice Category, and is treated as a stack of Power for all of your effects.
  (4)-[Passive]: For each stack of All-Out Power you possess, this Transformation gains a level of the Draining Aspect.
  (5)-[Passive]: You cannot gain stacks of Holding Back while in this Transformation.
  (6)-[Triggered/Power, 1/Encounter]: If you are below the Injured Health Threshold, gain a stack of All-Out Power.
  (7)-[Triggered/Transform, 1/Encounter]: If you entered this Transformation through a Transformation Maneuver used through the 1st effect of Unleash your Power, use the Power Up Maneuver as an Out-of-Sequence Maneuver. If you do, you may enter the Superior State until the start of your next turn.

---

# (2) Entering it: all Holding Back lost, a stack of All-Out Power (max. 3).
[automatic/transform, effect 2]
holdingback.stacks = 0;
allout.stacks += 1;

# (3) Each stack: Combat Rolls 1(T), the Tier of Power Extra Dice a Category, and a stack of Power for your effects (its header).
[passive, effect 3]
combatRolls += allout.stacks * 1(T);
dice.extra.category += allout.stacks;

# (4) A level of Draining a stack (its header's grantsAspectTo). (5) No Holding Back gained while in it: its most nothing.
[passive, effect 5]
holdingback.max -= 99;

# (6) The Power Up below the Injured Health Threshold, once an Encounter: a stack of All-Out Power.
[triggered/power, 1/encounter, effect 6]
requires belowThreshold("injured");
allout.stacks += 1;

# (7) Entering it through Unleash your Power (1), once an Encounter - the player's to say: the Power Up out of sequence, and the Superior State
# till the start of your next turn.
[triggered/transform, 1/encounter, outOfSequence, effect 7]
maneuverOutOfSequence(power-up);
enterState(superior, 1, start-of-next-turn);

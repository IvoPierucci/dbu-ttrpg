id: oozaru-rampaging-assault
name: Rampaging Assault
order: 2
slot: trait
# Its [Permanent] effects: they hold outside the Transformation too.
permanent: 1
description: >
  Your bestial mind takes over, allowing you to deal massive damage, but denying you fine control over your power.
text: >
  Rampaging Assault: Your bestial mind takes over, allowing you to deal massive damage, but denying you fine control over your power.
  (1)-[Permanent]: You cannot enter this Transformation while using an Enhancement.
  (2)-[Passive]: You cannot use an Enhancement in conjunction with this Transformation.
  (3)-[Passive]: Reduce the Ki Point Cost of the Beam Profile by 2(T).
  (4)-[Triggered, 1/Round]: If you use the Terrain Lift Maneuver, you may use the Throw Maneuver as an Out-of-Sequence Action. If you do, you must throw the Feature.
  (5)-[1/Encounter]: You may use the Tail Attack Maneuver, but your Profile for that Attacking Maneuver is Powered.

---

# (1)(2) No Enhancement with it: said, never refused.

# (3) The Beam Profile 2(T) cheaper.
[passive, effect 3]
profileKiCost.beam -= 2(T);

# (4) The Terrain Lift used, once a Round: the Throw out of sequence - the Feature thrown.
[triggered/declare-maneuver, 1/round, outOfSequence, effect 4]
requires using("terrain-lift");
maneuverOutOfSequence(throw);

# (5) Once an Encounter: the Tail Attack Maneuver, its Profile Powered - an Instant of its own (maneuvers/).
[passive, effect 5]
allow maneuver.rampaging-tail;

id: pure-form-unpredictable
name: Unpredictable
order: 2
slot: trait
resource: channeledchaos
resourceLabel: Channeled Chaos
resourceMax: 99
description: >
  Your wild and unstable power is chaos incarnate, and even you don't know what will happen next!
text: >
  Unpredictable: Your wild and unstable power is chaos incarnate, and even you don't know what will happen next!
  (1)-[Triggered, 1/Round]: If you roll a 6 on your Chaos Die, enter the Superior State until the start of your next turn.
  (2)-[Triggered, 1/Round]: If you use a Healing Surge, roll your Chaos Die.
  (3)-[Triggered, Resource]: If you roll a 6 on your Chaos Die, gain a stack of Channeled Chaos.
  (4)-[Triggered]: After seeing the result of your Chaos Die, you may spend a stack of Channeled Chaos to increase or reduce the result by 1.
  (5)-[Triggered/Start of Combat Round]: Spend 2 stacks of Channeled Chaos. Until the end of this Combat Round, the Ki Point Cost of your Attacking Maneuvers is reduced to 0.
  (6)-[Triggered/Start of Combat Round]: Spend 3 stacks of Channeled Chaos. Until the end of this Combat Round, apply your Damage Attribute an additional time for all of your Attacking Maneuvers.
  (7)-[Triggered/Start of Combat Round]: If you are in the Superior State, instead of gaining a Counter Action, you may gain an additional Action.

---

# (1) A 6 on the Chaos Die, once a Round: the Superior State till the start of your next turn.
[triggered/chaos-die, 1/round, effect 1]
requires naturalAtLeast(6);
enterState(superior, 1, start-of-next-turn);

# (2) A Healing Surge, once a Round: the Chaos Die rolled again.
[triggered/healing-surge, 1/round, effect 2]
chaosDie();

# (3) A 6 on the Chaos Die: a stack of Channeled Chaos.
[triggered/chaos-die, effect 3]
requires naturalAtLeast(6);
channeledchaos.stacks += 1;

# (4) After seeing it, a stack of Channeled Chaos for 1 more or less - asked as it is rolled (chat.mjs rollChaosDie).
[passive, effect 4]
allow chaos.nudge;

# (5) At the start of the Combat Round, 2 stacks: the Ki Point Cost of your Attacking Maneuvers 0 till it ends.
[triggered/start-of-round, effect 5]
requires channeledchaos.stacks >= 2;
channeledchaos.stacks -= 2;
gain(chaos-free-mark);
expires(chaos-free-mark, round);

# (6) 3 stacks: your Damage Attribute once more on every Attacking Maneuver till it ends.
[triggered/start-of-round, effect 6]
requires channeledchaos.stacks >= 3;
channeledchaos.stacks -= 3;
gain(chaos-twice-mark);
expires(chaos-twice-mark, round);

# (7) At the start of the Combat Round, in the Superior State: an Action instead of a Counter Action.
[triggered/start-of-round, effect 7]
requires inState("superior");
actions.remaining += 1;
actions.counterSpent += 1;

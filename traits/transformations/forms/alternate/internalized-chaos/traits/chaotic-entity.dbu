id: internalized-chaos-chaotic-entity
name: Chaotic Entity
order: 1
slot: trait
description: >
  Chaos follows you wherever you go, leaving destruction in your wake.
text: >
  Chaotic Entity: Chaos follows you wherever you go, leaving destruction in your wake.
  (1)-[Passive]: You gain access to the 7th effect of Erratic Majin and the 3rd and 4th effects of Unpredictable.
  (2)-[Triggered, 1/Round]: After seeing the result, you may reroll your Healing Surge.
  (3)-[Triggered, 1/Encounter]: After seeing the result, you may reroll your Chaos Die.

---

# (1) Erratic Majin (7) and Unpredictable (3)(4): the Chaos Die at the start of each Combat Round, Channeled Chaos on a 6 (not in Pure Form,
# where Unpredictable's own gives it), a stack for 1 more or less.
[passive, effect 1]
allow chaos.die;
allow chaos.nudge;

[automatic/start-of-round, effect 1]
chaosDie(start);

[triggered/chaos-die, effect 1]
requires naturalAtLeast(6) && !inTransformation("pure-form");
channeledchaos.stacks += 1;

# (2) The Healing Surge rerolled after seeing it, once a Round - asked (chat.mjs takeSurge).
[passive, effect 2]
allow surge.healingReroll;

# (3) The Chaos Die rerolled after seeing it, once an Encounter - asked as it is rolled (chat.mjs rollChaosDie).
[passive, effect 3]
allow chaos.reroll;

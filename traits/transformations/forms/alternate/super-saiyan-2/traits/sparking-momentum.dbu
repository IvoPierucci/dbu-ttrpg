id: super-saiyan-2-sparking-momentum
name: Sparking Momentum
order: 1
slot: trait
description: >
  Your energy is too great to contain, taking the form of lightning coursing around your aura.
text: >
  Sparking Momentum: Your energy is too great to contain, taking the form of lightning coursing around your aura.
  (1)-[Passive]: Increase the Dice Category of your Tier of Power Extra Dice by S-1 Categories.
  (2)-[Passive]: While you are in the Raging or Superior State, increase your Strike and Dodge Rolls by 1(T).
  (3)-[Passive]: Your Attacking Maneuvers that possess a Ki Wager equal to or exceeding 1/4 of your Max Capacity have their Damage Category increased by 1 Category.
  (4)-[Triggered, 1/Encounter]: If you knock an Opponent through a Health Threshold, that Opponent gains a stack of the Broken Combat Condition until the start of your next turn. Additionally, gain an additional Action from Bonus Momentum.
  (5)-[Triggered/Start of Combat Round, 1/Encounter]: Take your Turn immediately, ignoring the current Initiative Order. If multiple Characters apply this effect, they take their turns in order of highest to lowest Initiative Value.

---

# (1) The Tier of Power Extra Dice S-1 Categories higher.
[passive, effect 1]
dice.extra.category += $S - 1;

# (2) In the Raging or Superior State: Strike and Dodge 1(T).
[passive, effect 2]
if (inState("raging") || inState("superior")) {
    strike += 1(T);
    dodge += 1(T);
}

# (3) A Ki Wager of 1/4 of your Max Capacity or more: the Damage Category 1 higher (chat.mjs, as the attack is declared).
[passive, effect 3]
attack.damageCategory.heavyWager += 1;

# (4) Knocking an Opponent through a Health Threshold, once an Encounter: a stack of Broken till the start of your next turn; the Action
# from Bonus Momentum more: the table's.
[triggered/knock-through, 1/encounter, effect 4]
requires knockedOpponent;
markKnocked(broken, 1, start);

# (5) On the Round's card, once an Encounter: your turn now, ignoring the Initiative Order - several, highest Initiative first (Jump
# Start's: chat.mjs jumpStart).
[triggered/start-of-round, 1/encounter, chosen, effect 5]
jumpStart();
